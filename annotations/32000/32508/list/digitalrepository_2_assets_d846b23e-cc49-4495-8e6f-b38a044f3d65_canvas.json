      "body": [
        {
          "type": "TextualBody",
          "label": "Witness clause II",
          "value": "<p></p>\n\n<ol><li>\n<p>\u0634\u0647\u062f \u0627\u0644\u062d\u0627\u062c\u0628(\u061f) \u0627\u0628\u0648(\u061f) \u0639\u0628\u0627\u0633 \u0628\u0646 \u0627\u0628\u064a \u0627\u0644\u0631\u0628\u064a\u0639(\u061f) \u0639\u0644\u0649</p>\n</li>\n<li>\n<p>\u0627\u0644\u0645\u0642\u0631 \u0628\u0627\u0644\u0639\u062a\u0642 \u0627\u0644\u0645\u0633\u0645\u0649 \u0641\u064a\u0647 \u0628\u0645\u0627 \u0641\u064a\u0647 \u0628\u062d\u0633\u0646 \u0646\u064a\u0629 \u0627\u0644\u0645\u0642\u0631 \u0641\u064a\u0647</p>\n</li>\n<li>\n<p>\u0645\u0644\u062d\u0642 \u0645\u062b\u0627\u0644\u0647(\u061f) \u0627\u0644\u063a\u064a\u0631 \u0628\u0627\u0644\u063a \u0648\u0647\u0648 \u0635\u062d\u064a\u062d . . . \u0627\u0644\u062d\u0627\u062c\u0628(\u061f) . . . . . \u0634\u0647\u062f \u0639\u0644\u064a\u0647</p>\n</li>\n<li>\n<p>\u0641\u064a \u0635\u062d\u0629 \u0645\u0646\u0647 \u0648\u062c\u0648\u0627\u0632 \u0627\u0645\u0631 \u0648\u0647\u0648 \u0628\u0647 \u0639\u0627\u0631\u0641 \u0648\u0627\u0642\u0627\u0645 \u0634\u0647\u0627\u062f\u062a\u0647 \u0647\u0630\u0647 \u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a</p>\n</li>\n<li>\n<p>\u0648\u0627\u0644\u0639\u0634\u0631\u064a\u0646 \u0645\u0646 \u0634\u0647\u0631 \u0631\u0628\u064a\u0639 \u0627\u0644\u0627\u0648\u0644 \u0633\u0646\u0629 \u062b\u0645\u0627\u0646 \u0648\u0627\u0631\u0628\u0639\u064a\u0646 \u0648\u062e\u0645\u0633\u0645\u0627\u0649\u0629</p>\n</li></ol>\n",
