      "body": [
        {
          "type": "TextualBody",
          "value": "<p></p>\n\n<ol><li>\n<p>. . . . . . . . . .] . . . . . \u0627 . . . \u0644\u0647 \u0628\u0646\u064a \u0627\u062f\u0645 \u0644\u0647 \u0645\u0627 \u0644\u0647\u0645 \u0648\u0639\u0644\u064a\u0647 \u0645\u0627 \u0639\u0644\u064a\u0647\u0645 \u0644\u0645 \u064a\u0634\u062a\u0631\u0637 \u0639\u0644\u064a\u0647 \u0645\u0627\u0644\u0627 \u0648\u0644\u0645 \u064a\u062c\u062a\u0639\u0644 \u0639\u0640\u0644\u064a\u0647</p>\n</li>\n<li>\n<p>\u062c\u0639\u0644\u0627 \u0648\u0627\u0642\u0631 \u0627\u0646 \u0627\u062e\u0627\u0647 \u0628\u0648 \u0627\u0644\u0628\u0634\u0631 \u0628\u0646 \u0628\u0648 \u0627\u0644\u0633\u0631\u0648\u0631 \u0643\u0627\u0646 \u062d\u0636\u0631 \u0639\u0646\u062f \u0648\u0642\u0648\u0639 \u0627\u0644\u0639\u062a\u0642 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0628\u0639\u062f\u0646 \u0641\u0642\u0628\u0644 \u0644\u0644\u0645\u0639\u062a\u0642 \u0627\u0644\u0639\u062a\u0642</p>\n</li>\n<li>\n<p>\u0644\u0639\u062c\u0632\u0647 \u0639\u0646 \u0642\u0628\u0648\u0644\u0647 \u0648\u0646\u0633\u062e \u0645\u0646 \u0630\u0644\u0643 \u0643\u062a\u0627\u0628 \u0627\u0644\u0639\u062a\u0642 \u0627\u0644\u0645\u0634\u0627\u0631 \u0627\u0644\u064a\u0647 \u0634\u0647\u062f \u0639\u0644\u0649 \u0627\u0642\u0631\u0627\u0631 \u0627\u0644\u0645\u0642\u0631 \u0628\u0627\u0644\u0639\u062a\u0642 \u0627\u0644\u0645\u0633\u0645\u0649 \u0641\u064a\u0647 \u0628\u0645\u0627 \u0646\u0633\u0628 \u0627\u0644\u064a\u0647 \u0641\u064a \u0635\u062d\u0629</p>\n</li>\n<li>\n<p>\u0645\u0646\u0647 \u0648\u062c\u0648\u0627\u0632 \u0627\u0645\u0631\u0647 \u0637\u0648\u0639\u0627 \u0641\u064a \u062a\u0627\u0631\u064a\u062e\u0647 \u0634\u0647\u062f \u0639\u0644\u0649 \u0630\u0644\u0643 . . \u0640\u062d\u0640 . . \u0640\u062d\u0640 . .\u00a0</p>\n</li></ol>\n",
