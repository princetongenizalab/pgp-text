      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "<ol>\n<li><span lang=\"ar\">[\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645 \u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0648\u0635\u0644\u0648\u0627\u062a \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0633\u064a\u062f\u0646\u0627 \u0645\u062d\u0645\u062f \u0627\u0645\u0627]</span></li>\n<li><span lang=\"ar\">\u0628\u0639\u062f \u0648\u0627\u0646 \u0633\u0627\u0644\u062a\u0645 \u0639\u0646\u0627 \u0641\u0627\u0646\u0646\u0627 \u0628\u062e\u064a\u0631 \u0648\u062e\u0627\u0637\u0631\u0646\u0627 \u0639\u0646\u062f\u0643\u0645 \u0648\u0627\u0644\u0630\u064a \u0646\u0639\u0631\u0641\u0643\u0645 \u0628\u0647 \u0627\u0646 \u0648\u0635\u0644 \u0627\u0644\u064a \u0639\u0646\u062f\u0646\u0627</span></li>\n<li><span lang=\"ar\">\u0645\u0643\u062a\u0648\u0628\u0643\u0645 \u0635\u062d\u0628\u0629 \u0627\u0644\u0645\u0639\u0644\u0645 \u0645\u0648\u0633\u0649 \u0648\u0639\u0631\u0641\u062a\u0648\u0646\u0627 \u0645\u0646 \u0642\u0636\u064a\u0629 \u0627\u0644\u0634\u0628\u0627\u0628\u0643 \u0627\u0644\u0630\u064a \u0639\u0646\u062f \u0627\u0644\u0646\u0635\u0631\u0627\u0646\u064a \u0648\u0627\u0644\u0646\u0627\u0633 \u0648\u0627\u0646 \u0627\u0644\u0646\u0635\u0631\u0627\u0646\u064a</span></li>\n<li><span lang=\"ar\">\u062e\u062f\u0627\u0645 \u0639\u0646\u062f \u0627\u0644\u0627\u0645\u064a\u0631 \u0645\u062d\u0645\u062f \u0627\u063a\u0627 \u0645\u0643\u0631\u0645 (\u061f) \u0645\u0646 \u0628\u0646\u062f\u0631 \u062f\u0645\u064a\u0627\u0637 \u0648\u0627\u0644\u0648\u0627\u0635\u0644 \u0627\u0644\u064a \u0639\u0646\u062f\u0643\u0645 \u0627\u0644\u0645\u0639\u0644\u0645 \u0645\u0648\u0633\u0649 \u0648\u0627\u0644\u062d\u0627\u0644 \u0627\u0646\u0643\u0645 \u0639\u0646\u062f \u0648\u0635\u0648\u0644&nbsp;</span></li>\n<li><span lang=\"ar\">\u0627\u0644\u0645\u0643\u062a\u0648\u0628 \u0627\u0644\u064a\u0643\u0645 \u062a\u0627\u062e\u0630\u0648\u0627 \u0645\u0643\u062a\u0648\u0628 \u0645\u0646 \u062d\u0636\u0631\u0629 \u0643\u062a\u062e\u062f\u0627 \u0628\u0627\u0644\u0648\u0642\u062a(\u061f) \u0648\u0645\u0643\u062a\u0648\u0628 \u0645\u0646 \u0627\u0644\u0627\u0645\u064a\u0631 \u064a\u0648\u0633\u0641 \u0628\u064a\u0643 \u0648\u0645\u0643\u062a\u0648\u0628 </span></li>\n<li><span lang=\"ar\">\u0645\u0646 \u0627\u0644\u0627\u0645\u064a\u0631 \u0633\u0644\u064a\u0645\u0627\u0646 \u0627\u0648\u062f\u0647(\u061f) \u0628\u0643 \u0648\u0639\u0628\u062f \u0627\u0644\u0644\u0647 \u0627\u0648\u062f\u0647 \u0628\u0643 \u062e\u0637\u0627\u0628\u0627 \u0644\u0646\u0627 \u0648\u064a\u0630\u0643\u0631\u0648\u0627 \u0641\u064a\u0647\u0645 \u0627\u0646 \u0639\u0646\u062f \u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u0643\u0627\u062a\u064a\u0628&nbsp;</span></li>\n<li><span lang=\"ar\">\u062a\u0646\u0638\u0631\u0648\u0627 \u062d\u0633\u0627\u0628 \u0627\u0644\u0646\u0635\u0631\u0627\u0646\u064a \u0641\u064a \u0645\u0646\u0632\u0644\u0643\u0645(\u061f) \u0648\u062a\u0631\u0633\u0644\u0648\u0647\u0645 \u0627\u0644\u064a\u0646\u0627 \u0648\u0645\u062b\u0644 \u0627\u0644\u0645\u0643\u0627\u062a\u064a\u0628 \u0627\u0644\u0630\u064a \u0644\u0646\u0627 \u0627\u064a\u0636\u0627 \u0645\u0643\u062a\u0648\u0628&nbsp;</span></li>\n<li><span lang=\"ar\">\u0645\u0646 \u0627\u0644\u0627\u0645\u064a\u0631 \u064a\u0648\u0633\u0641 \u0628\u064a\u0643 \u0648\u0645\u0643\u062a\u0648\u0628 \u0645\u0646&nbsp;\u0643\u062a\u062e\u062f\u0627 \u0628\u0627\u0644\u0648\u0642\u062a(\u061f) \u0648\u0645\u0643\u062a\u0648\u0628 \u0645\u0646 \u0633\u0644\u064a\u0645\u0627\u0646 \u0627\u0648\u062f\u0647 \u0628\u0643 \u0648\u0639\u0628\u062f \u0627\u0644\u0644\u0647 \u0627\u0648\u062f\u0647 \u0628\u0643</span></li>\n<li><span lang=\"ar\">\u062e\u0637\u0627\u0628\u0627 \u0627\u0644\u0649 \u0645\u062d\u0645\u062f \u0627\u063a\u0627.... \u0648\u062a\u0630\u0643\u0631\u0648\u0627 \u0641\u064a\u0647\u0645... \u0627\u0644\u062d\u0633\u0627\u0628 \u0641\u064a \u0628\u064a\u062a \u0627\u0644\u0627\u0645\u064a\u0631 \u0639\u0644\u064a \u0627\u0641\u0646\u062f\u064a \u0648\u062a\u062f\u0639\u0648\u0647\u0645</span></li>\n<li><span lang=\"ar\">\u064a\u0648\u0643\u062f\u0648\u0627 \u0641\u064a \u0627\u0644\u0645\u0643\u0627\u062a\u064a\u0628 \u0648\u062a\u0631\u0633\u0644\u0648\u0647\u0645 \u0627\u0644\u064a\u0646\u0627 \u0639\u0644\u0649 \u0627\u0644\u0639\u062c\u0644\u0629 \u0648\u0646\u062d\u0646 \u0646\u062e\u0644\u0635\u0647 \u0645\u0646 \u0627\u0644\u0646\u0635\u0631\u0627\u0646\u064a \u0648\u0645\u0646 \u062e\u0644\u0627\u0641\u0647</span></li>\n<li><span lang=\"ar\">\u0639\u0644\u0649 \u0627\u062e\u0631 \u062d\u0627\u0644 \u0648\u0627\u062d\u0645\u062f \u0627\u0641\u0646\u062f\u064a \u0648\u0645\u062d\u0645\u062f \u0627\u0641\u0646\u062f\u064a[.......] \u0641\u064a \u0630\u064a \u0627\u0644\u0642\u0639\u062f\u0629 \u0661\u0661\u0661\u0669&nbsp;&nbsp;</span></li>\n</ol>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "transcribing"
      ],
