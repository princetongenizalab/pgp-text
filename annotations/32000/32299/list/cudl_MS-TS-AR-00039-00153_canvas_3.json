      "body": [
        {
          "type": "TextualBody",
          "label": "Page 16: Folio 2r, right side",
          "value": "\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">k\u0323ovuculuk\u0323 etmek. Yig\u0306irminci</p>\n</li>\n<li>\n<p>h\u0323ased etmek. Yig\u0306irmi</p>\n</li>\n<li>\n<p>birinci u\u0308sta\u0304z\u0131na s\u0327er\u02bfe</p>\n</li>\n<li>\n<p>muh\u032ea\u0304lif olmayan yerde</p>\n</li>\n<li>\n<p>muh\u032ea\u0304lefet etmek. Yig\u0306irmi</p>\n</li>\n<li>\n<p>ikinci bir a\u0304dam\u0131 tecribe</p>\n</li>\n<li>\n<p>etmeden &lsquo;ayu&rsquo; dimek</p>\n</li>\n<li>yi\u011firmi (bottom left)</li></ol>\n",
          "format": "text/html"
        }
      ],
