      "body": [
        {
          "type": "TextualBody",
          "label": "Page 14: Folio 3r, right side",
          "value": "\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">terk etmek. On</p>\n</li>\n<li>\n<p>ikinci nama\u0304z\u0131nda teha\u0304vu\u0308n</p>\n</li>\n<li>\n<p>ya\u02bfni\u0304 k\u0323olays\u0323\u0131nub alcak\u0323</p>\n</li>\n<li>\n<p>is\u0327 gibi t\u0323utmak\u0323.</p>\n</li>\n<li>\n<p>On u\u0308c\u0327u\u0308nci s\u0327ara\u0304b</p>\n</li>\n<li>\n<p>ic\u0327mek. On do\u0308rdu\u0308nci</p>\n</li>\n<li>\n<p>Mu\u0308slima\u0304nlara eza\u0304 etmek.</p>\n</li>\n<li>on (bottom left)</li></ol>\n",
          "format": "text/html"
        }
      ],
