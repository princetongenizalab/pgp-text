      "body": [
        {
          "type": "TextualBody",
          "label": "Page 3: Folio 3r, left side",
          "value": "\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">ok\u0323usa, sehv-i secde</p>\n</li>\n<li>\n<p>ide. I\u0307kinci rek\u02bfatda</p>\n</li>\n<li>\n<p>oturmasa, sehv-i secde</p>\n</li>\n<li>\n<p>ide. Tah\u0323iyya\u0304t ok\u0323umag\u0307\u0131</p>\n</li>\n<li>\n<p>unutsa, gerek cu\u0308mlesini,</p>\n</li>\n<li>\n<p>gerek biraz\u0131n\u0131, gerek</p>\n</li>\n<li>\n<p>evvelki tah\u0323iyya\u0304tda ve gerek</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
