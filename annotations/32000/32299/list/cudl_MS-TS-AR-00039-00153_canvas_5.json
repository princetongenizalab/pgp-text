      "body": [
        {
          "type": "TextualBody",
          "label": "Page 14: Folio 3r, right side",
          "value": "\n<ol><li>The twelfth is to behave</li>\n<li>carelessly during your prayer&mdash;</li>\n<li>that is, as if you were undertaking</li>\n<li>something easy or insignificant.</li>\n<li>The thirteenth is to drink wine.</li>\n<li>The fourteenth is</li>\n<li>to harm Muslims.</li>\n<li>the [fif]teenth (bottom left)</li></ol>\n",
          "format": "text/html"
        }
      ],
