      "body": [
        {
          "type": "TextualBody",
          "label": "Page 9: Folio 1v, left side",
          "value": "\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">Ayak\u0323 u\u0308zere t\u0323urmag\u0307\u0131</p>\n</li>\n<li>\n<p>ya ruku\u0304\u02bf\u0131 ya iki secdeyi</p>\n</li>\n<li>\n<p>terk eylese, nama\u0304z</p>\n</li>\n<li>\n<p>ic\u0327inde ya sela\u0304m \u02bfak\u0323abince</p>\n</li>\n<li>\n<p>h\u032ea\u0304t\u0323\u0131r\u0131na gelse, bir rek\u02bfat</p>\n</li>\n<li>\n<p>dah\u032ei k\u0323\u0131lub, sehv-i</p>\n</li>\n<li>\n<p>secde ide. Ruku\u0304\u02bf\u0131</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "transcribing"
      ],
      "schema:position": 2
