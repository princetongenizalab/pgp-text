      "body": [
        {
          "type": "TextualBody",
          "label": "Page 8: Folio 1v, right side",
          "value": "\n<ol><li>\n<p>your prayer is invalid.</p>\n</li>\n<li>\n<p>If, before reciting the Fa\u0304tih\u0323a,</p>\n</li>\n<li>\n<p>you recite part of the chapter</p>\n</li>\n<li>\n<p>or [even] one letter [of it], your prayer is invalid.</p>\n</li>\n<li>\n<p>If, during an obligatory prayer,</p>\n</li>\n<li>\n<p>you do not perform the first jalsa,</p>\n</li>\n<li>\n<p>your prayer is invalid.</p>\n</li>\n<li>standing (bottom left)</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
