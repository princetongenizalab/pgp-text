      "body": [
        {
          "type": "TextualBody",
          "label": "Page 13: Folio 3v, left side",
          "value": "\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">etmemek. T\u0323ok\u0323uzunc\u0131 anas\u0131na</p>\n</li>\n<li>\n<p>ve ba\u0304ba\u0304s\u0131na s\u0327er\u02bfe muh\u032ea\u0304lif</p>\n</li>\n<li>\n<p>olmayan yerde so\u0308zlerin</p>\n</li>\n<li>\n<p>t\u0323utmamak\u0323. Onunc\u0131 c\u0327ok\u0323</p>\n</li>\n<li>\n<p>yemi\u0304n etmek. On</p>\n</li>\n<li>\n<p>birinci nama\u0304zda bes\u0327</p>\n</li>\n<li>\n<p>yerde ta\u02bfdi\u0304l-i erka\u0304n\u0131</p>\n</li></ol>\n",
          "format": "text/html"
        }
