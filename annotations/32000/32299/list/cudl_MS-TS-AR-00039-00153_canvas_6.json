      "body": [
        {
          "type": "TextualBody",
          "label": "Page 13: Folio 3v, left side",
          "value": "\n<ol><li>The ninth is not to obey your mother</li>\n<li>and father when they have</li>\n<li>not violated the shari\u0304\u02bfa.</li>\n<li>The tenth is to make</li>\n<li>too many vows.</li>\n<li>The eleventh is to abandon</li>\n<li>the correct performance of the five obligatory prayers.</li></ol>\n",
          "format": "text/html"
        }
      ],
