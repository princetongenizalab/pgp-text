      "body": [
        {
          "type": "TextualBody",
          "label": "Page 3: Folio 1v, left side",
          "value": "\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">zemi\u0304meden, ve dah\u032ei [in red ink] a\u02bfma\u0304l-\u0131</p>\n</li>\n<li>\n<p>z\u0323a\u0304hire&mdash;ki abdest, nama\u0304z,</p>\n</li>\n<li>\n<p>oruc, h\u0323acc, zeka\u0304t,</p>\n</li>\n<li>\n<p>g\u0307usu\u0308l, istinh\u0323a\u0304, teyemmu\u0308m,</p>\n</li>\n<li>\n<p>h\u0323ayz\u0307, nifa\u0304s, al\u0131m</p>\n</li>\n<li>\n<p>sat\u0131m. Ve dah\u032ei [in red ink] ah\u0323ka\u0304m-\u0131</p>\n</li>\n<li>\n<p>s\u0327er\u02bfi\u0304ye bes\u0327dir: vu\u0308cu\u0304b,</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
