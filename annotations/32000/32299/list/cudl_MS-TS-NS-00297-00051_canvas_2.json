      "body": [
        {
          "type": "TextualBody",
          "label": "Page 2: Folio 1v, right side",
          "value": "\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">h\u0323ak\u0323k\u0323d\u0131r elbetde Rab</p>\n</li>\n<li>\n<p>ul-\u02bfa\u0304lemi\u0304n evvelin a\u0304h\u032eirini</p>\n</li>\n<li>\n<p>meza\u0304rdan k\u0323ald\u0131rub, meka\u0304n-</p>\n</li>\n<li>\n<p>dan mu\u0308nezzeh olan</p>\n</li>\n<li>\n<p>Alla\u0304hu\u0308 te\u02bfa\u0304la\u0304 bana</p>\n</li>\n<li>\n<p>emir olunandan ve nehy</p>\n</li>\n<li>\n<p>olunandan, ya\u02bfni\u0304 ah\u032ela\u0304k\u0323-\u0131</p>\n</li>\n<li>zem\u012bme (bottom left)</li></ol>\n",
          "format": "text/html"
