      "body": [
        {
          "type": "TextualBody",
          "label": "Page 2: Folio 1v, right side",
          "value": "\n<ol><li>it is unquestionably true that the Lord</li>\n<li>of the universe</li>\n<li>will raise from the grave from first to last [i.e., everyone].</li>\n<li>God the exalted,</li>\n<li>he without limit, [has shown] me</li>\n<li>what is ordered and what is forbidden,</li>\n<li>that is, the morals of</li>\n<li>reprehensible acts (bottom left)</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
