      "body": [
        {
          "type": "TextualBody",
          "label": "Page 6: Folio 4v, right side",
          "value": "\n<ol><li>\n<p>you leave out either the Fa\u0304tih\u0323a or the chapter,</p>\n</li>\n<li>\n<p>your prayer is invalid.</p>\n</li>\n<li>\n<p>If in one ra\u02bfka,</p>\n</li>\n<li>\n<p>one right after the other,</p>\n</li>\n<li>you recite the Fa\u0304tih\u0323a twice,</li>\n<li>\n<p>your prayer is invalid.</p>\n</li>\n<li>\n<p>If you prostrate three times,&nbsp;</p>\n</li>\n<li>invalid (bottom left)</li></ol>\n\n<p></p>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
