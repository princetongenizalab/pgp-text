      "body": [
        {
          "type": "TextualBody",
          "label": "Page 6: Folio 4v, right side",
          "value": "\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">Fa\u0304tih\u0323a&rsquo;y\u0131 ya su\u0304reyi terk</p>\n</li>\n<li>\n<p>eylese, sehv-i secde</p>\n</li>\n<li>\n<p>ide. Fa\u0304tih\u0323a&rsquo;y\u0131 bir rek\u02bfatda</p>\n</li>\n<li>\n<p>biri biri ard\u0131nca</p>\n</li>\n<li>\n<p>iki kerre ok\u0323usa,</p>\n</li>\n<li>\n<p>sehv-i secde ide.</p>\n</li>\n<li>\n<p>Secdeyi u\u0308c\u0327 itse</p>\n</li>\n<li>sehv (bottom left)</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "transcribing"
      ],
      "schema:position": 1
