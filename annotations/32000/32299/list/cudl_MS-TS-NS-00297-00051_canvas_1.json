      "body": [
        {
          "type": "TextualBody",
          "label": "Page 4: Folio 1r, right side",
          "value": "\n<ol><li>\n<p>recommended, permissible, forbidden, </p>\n</li>\n<li>\n<p>and reprehensible. In short,</p>\n</li>\n<li>\n<p>you must ask questions </p>\n</li>\n<li>\n<p>in this way about religious matters</p>\n</li>\n<li>while you are [still] in this world,</li>\n<li>while life is [still] in the flesh</li>\n<li>Unless you work hard and learn,</li>\n<li>I (bottom left)</li></ol>\n\n\n\n\n\n\n\n\n\n\u00a0\n\n\n<p></p>",
          "format": "text/html"
