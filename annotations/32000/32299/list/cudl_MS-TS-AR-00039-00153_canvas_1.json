      "body": [
        {
          "type": "TextualBody",
          "label": "Page 7: Folio 1r, left side",
          "value": "\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">sehv-i secde ide.</p>\n</li>\n<li>\n<p>Fa\u0304tih\u0323a&rsquo;dan s\u0323on\u0303ra bir mik\u0323da\u0304r</p>\n</li>\n<li>\n<p>eg\u0306lense, &lsquo;k\u0323ang\u0307\u0131 su\u0304reyi</p>\n</li>\n<li>\n<p>ok\u0323usam&rsquo; deyu\u0308, sehv-i</p>\n</li>\n<li>\n<p>secde ide. Bir secdeyi</p>\n</li>\n<li>\n<p>terk eylese, s\u0323on\u0303ra</p>\n</li>\n<li>\n<p>h\u032ea\u0304t\u0323\u0131r\u0131na gelu\u0308b, k\u0323az\u0307a\u0304</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
