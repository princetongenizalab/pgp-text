      "body": [
        {
          "type": "TextualBody",
          "label": "Page 10: Folio 1r, right side",
          "value": "<p dir=\"ltr\"></p>\n\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">ya secdeyi unutsa, tah\u0323iyya\u0304tdan</p>\n</li>\n<li>\n<p>s\u0323on\u0303ra h\u032ea\u0304t\u0323\u0131r\u0131na gelse,</p>\n</li>\n<li>\n<p>ol secdeyi ya ruku\u0304\u02bf\u0131</p>\n</li>\n<li>\n<p>ide, yine tekra\u0304r</p>\n</li>\n<li>\n<p>tah\u0323iyya\u0304t ok\u0323uya sehv-i</p>\n</li>\n<li>\n<p>secde ide. Ezberlemek</p>\n</li>\n<li>\n<p>bu mes\u02beeleleri la\u0304z\u0131mdir.</p>\n</li>\n<li>\n<p>ve dah\u032ei (bottom left)&nbsp;</p>\n</li></ol>\n\n<p></p>\n<p></p>",
          "format": "text/html"
        }
      ],
      "motivation": [
