      "body": [
        {
          "type": "TextualBody",
          "label": "Page 7: Folio 1r, left side",
          "value": "\n<ol><li>\n<p>your prayer is invalid. </p>\n</li>\n<li>\n<p>If, after the Fa\u0304tih\u0323a, you hesitate </p>\n</li>\n<li>\n<p>for a while, thinking, \u2018Which chapter</p>\n</li>\n<li>shall I read?',</li>\n<li>your prayer is invalid.</li>\n<li>If you leave out a prostration,\u00a0</li>\n<li>then later you remember it and perform it,</li></ol>\n\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
    },
