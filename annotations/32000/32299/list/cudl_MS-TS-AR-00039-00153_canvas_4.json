      "body": [
        {
          "type": "TextualBody",
          "label": "Page 2: Folio 2v, right side",
          "value": "\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">s\u0323alli \u02bfala Muh\u0323ammed&rsquo;</p>\n</li>\n<li>\n<p>dimeg\u0306i o\u0308te gec\u0327se</p>\n</li>\n<li>\n<p>sehv-i secde ide.</p>\n</li>\n<li>\n<p>Ruku\u0304\u02bf iki itse,</p>\n</li>\n<li>\n<p>sehv-i secde ide.</p>\n</li>\n<li>\n<p>Cehriyle ok\u0323unmayacak\u0323</p>\n</li>\n<li>\n<p>yerde bir a\u0304yet mik\u0323da\u0304r\u0131</p>\n</li>\n<li>okusa (bottom left)</li></ol>\n",
          "format": "text/html"
        }
