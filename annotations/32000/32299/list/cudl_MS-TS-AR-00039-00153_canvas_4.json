      "body": [
        {
          "type": "TextualBody",
          "label": "Page 15: Folio 2v, left side",
          "value": "\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">On bes\u0327inci yalan</p>\n</li>\n<li>\n<p>yere evliya\u0304l\u0131k\u0323 s\u0323atmak\u0323.</p>\n</li>\n<li>\n<p>On alt\u0131nc\u0131 gu\u0308na\u0304h\u0131n\u0131</p>\n</li>\n<li>\n<p>unutmak\u0323. On yedinci</p>\n</li>\n<li>\n<p>kendu\u0308yi begenmek. On</p>\n</li>\n<li>\n<p>sekizinci \u02bfamelini c\u0327ok\u0323</p>\n</li>\n<li>\n<p>bilmek. On t\u0323ok\u0323uzunc\u0131</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
