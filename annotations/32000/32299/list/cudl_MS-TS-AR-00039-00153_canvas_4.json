      "body": [
        {
          "type": "TextualBody",
          "label": "Page 2: Folio 2v, right side",
          "value": "\n<ol><li>&lsquo;May God have mercy on Muh\u0323ammad&rsquo;,</li>\n<li>mixing them up,</li>\n<li>your prayer is invalid.</li>\n<li>If you bow twice [in succession],</li>\n<li>your prayer is invalid.</li>\n<li>If you recite a number of verses audibly</li>\n<li>when they should not be recited [aloud],</li>\n<li>if you recite (bottom left)</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
