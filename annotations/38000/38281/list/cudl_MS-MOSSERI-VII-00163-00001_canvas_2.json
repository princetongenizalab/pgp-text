        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li>\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645</li>\n<li>&nbsp;\u0645\u0645\u0644\u0648\u0643 \u0627\u0644\u062d\u0636\u0631\u0629 \u0627\u0644\u0633\u0627\u0645\u064a\u0629 \u0627\u0644\u0627\u062c\u0644\u064a\u0629 \u0627\u0644\u0634\u064a\u062e\u064a\u0629 \u0627\u0644\u062f\u064a\u0648\u0627\u0646\u064a\u0629 \u062b\u0628\u062a \u0627\u0644\u0644\u0647 \u0627\u064a\u0627\u0645 \u0639\u0632\u0647\u0627 \u0648\u0627\u0639\u0644\u0627 \u0634\u0627\u0646\u0647\u0627 \u0648\u0630\u0643\u0627(\u061f) \u0642\u062f\u0631\u062a\u0647\u0627</li>\n<li>\u0648\u0627\u0647\u0644\u0643 \u0639\u062f\u0648\u0647\u0627 \u0648\u0636\u062f\u0647\u0627 &nbsp; &nbsp; &nbsp; &nbsp;\u064a\u0646\u0647\u064a \u0627\u0645\u062a\u062b\u0627\u0644\u0647 \u0628\u064a\u0646 \u064a\u062f\u064a \u0627\u0644\u062d\u0636\u0631\u0629 \u0627\u0644\u0633\u0627\u0645\u064a\u0629 \u0627\u0644\u062f\u064a\u0648\u0627\u0646\u064a\u0629 \u0627\u0644\u0633\u062f\u064a\u062f\u064a\u0629 \u0648\u064a\u0646\u0647\u064a(\u061f) \u0627\u0644\u064a\u0647\u0627</li>\n<li>\u0644\u0633\u0648\u0627\u0644 \u0627\u0644\u062d\u0636\u0631\u0629 \u0627\u0644\u0627\u062c\u0644\u064a\u0629 \u0636\u0627\u0639\u0641 \u0627\u0644\u0644\u0647 \u0633\u0639\u0627\u062f\u062a\u0647\u0627 \u0628\u062a\u0634\u0631\u064a\u0641\u0647 \u0628\u0643\u062a\u0627\u0628\u0647\u0627 \u0627\u0644\u0643\u0631\u064a\u0645</li></ol>\n",
