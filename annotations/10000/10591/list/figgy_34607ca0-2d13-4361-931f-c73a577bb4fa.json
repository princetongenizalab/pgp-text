      "body": [
        {
          "type": "TextualBody",
          "label": "Witness 1",
          "value": "\n<ol><li>\n<p>Correct.</p>\n</li>\n<li>\n<p>\u02bfAl\u012b b. Khalaf b. \u02bfAl\u012b al-Dimashq\u012b testified\u00a0</p>\n</li>\n<li>\n<p>about everything in this court record (ma\u1e25\u1e0dar) and wrote with his own hand on the same date.</p>\n</li></ol>\n",
          "format": "text/html"
        }
