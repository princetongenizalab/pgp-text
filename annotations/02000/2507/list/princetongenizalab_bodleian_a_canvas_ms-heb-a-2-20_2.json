      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, address, right column",
          "value": "<p>To my master and lord Ab\u016b Zikr\u012b\u2014may God prolong his life\u2014</p>\n<p>Ibn Sighmar\u2014may God be his protector.</p>\n<p>the dear, R. Judah, son of R. Moses, (may he) r{est in) E(den),</p>\n<p></p>",
          "format": "text/html"
        }
      ],
      "motivation": [
