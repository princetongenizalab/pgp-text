        "selector": {
          "type": "FragmentSelector",
          "value": "xywh=pixel:3229.9150390625,216.704345703125,772.785400390625,3449.718994140625",
          "conformsTo": "http://www.w3.org/TR/media-frags/"
        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "verso, margins",
          "value": "<p>Al-\u1e24a\u1e63r\u012b sends you greetings. Your brother sends you greetings. Please send him your receipt anyway. Don\u2019t stop writing letters to me. And don\u2019t forget what I need. And greetings. And please tell me the price of the gallnuts in Fust\u0101t.</p>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 2
    },
    {
