      "body": [
        {
          "type": "TextualBody",
          "label": "verso, address",
          "value": "<p>This letter should arrive at the port of Alexandria, may God protect it, and should be delivered to the scholar Ab\u016b \u2019l-Ma\u1e25\u0101sin al-Masr\u012b at the funduq [inn] of al-Qamra. Deliver this letter and receive reward.</p>\n<p>From his mother, may she never be deprived of him.</p>\n<p></p>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
    },
