      "body": [
        {
          "type": "TextualBody",
          "label": "Right margin",
          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\n<p dir=\"rtl\">\u0648\u064a\u062c\u0628 \u0627\u0646 . . [</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u062c\u0645\u0644\u0629 \u0630\u0643\u0631\u0647(\u061f) \u064a\u0628\u0627\u062f\u0631 \u0628\u062d\u0645\u0644\u0647\u0627 \u0648\u064a\u062a\u0648\u0641\u0631 \u0639\u0644\u0640[</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u062c\u062a\u0630\u0627\u0628 \u0627\u0644\u0645\u0627\u0644 \u0648\u0627\u0633\u062a\u064a\u0641\u0627[[\u064a\u0647]] \u062e\u0631\u0627\u062c</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">] \u0639\u0644\u064a\u0647\u0627 \u0645\u0646\u0647\u0627 \u0648\u0644\u0627 \u064a\u062f\u0639 \u063a\u0627\u064a\u0629 \u064a\u0648\u062f\u064a</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">] \u0642\u064a\u0627\u0645 \u062c\u0627\u0647\u0644</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
