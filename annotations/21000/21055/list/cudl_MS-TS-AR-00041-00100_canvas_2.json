          "conformsTo": "http://www.w3.org/TR/media-frags/"
        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "Right margin",
          "value": "<p></p>\n\n<ol><li dir=\"ltr\">\n<p dir=\"ltr\">And it is necessary that [. . .]</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">the totality of what he mentioned(?) be hastened in being conveyed, and that attention be devoted to</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">the collection of money and the full collection of the khar\u0101j,</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">] upon it from it, and that no effort be spared that may lead to</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">] the conduct of an ignorant person.</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
