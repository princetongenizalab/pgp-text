      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>[ \u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645&nbsp;]</li>\n<li>[\u0647\u0630\u0627 \u0645\u0627 \u0627\u0634\u062a\u0631\u0649 \u0645\u062d\u0645\u062f \u0628\u0646 \u0627]\u0633\u0645\u0639\u064a\u0644 \u0628\u0646 \u0627\u0644\u0642\u0627\u0633\u0645 \u0628\u0646 \u0627\u0628\u0631\u0647\u064a\u0645 \u0628\u0646 \u0627\u0633\u0645\u0639\u064a\u0644 \u0628\u0646 \u0627\u0628\u0631\u0647\u064a\u0645 \u0628\u0646 \u0627\u0644\u062d\u0633\u0646 \u0628\u0646 \u0627\u0644\u062d\u0633\u0646 \u0628\u0646 \u0639\u0644\u0649 [\u0628\u0646 \u0627\u0644\u062d\u0633\u0646 ( \u061f ) \u0628\u0646 \u0637\u0628\u0627\u0637\u0628\u0627]</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;] \u0647\u0630\u0647 \u0627\u0644\u062f\u0627\u0631 \u0627\u0644\u0643\u0628\u064a\u0631\u0629 \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0648\u0647\u0649 \u0627\u0644\u062f\u0627\u0631 \u0627\u0644\u062a\u064a \u0628\u0641\u0633\u0637\u0627\u0637 \u0645\u0635\u0631 \u0628\u062d\u0636\u0640[\u0640\u0631\u0629&nbsp; &nbsp; &nbsp;]</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;] . \u0648\u0641\u064a\u0647 \u064a\u0634\u0631\u0639 \u0628\u0627\u0628\u0647\u0627 \u0648\u0627\u0644\u062d\u062f \u0627\u0644\u062b\u0627\u0646\u064a \u0648\u0647\u0648 \u0627\u0644\u0628\u062d\u0631\u0649 \u064a\u0646\u062a\u0647\u0649 \u0627\u0644\u0649 \u062f\u0627\u0631 \u0627\u0644\u0645\u0640[\u0640\u0639\u0631\u0648\u0641\u0629 \u0628\u0640&nbsp; &nbsp; &nbsp;]</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;] ... \u0647\u0627 \u0627\u0644\u062a\u064a \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u062f\u0627\u0631 \u0627\u0644\u0643\u0628\u064a\u0631\u0629 \u0627\u0644\u0645\u062d\u062f\u0648\u062f\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u062c\u0645\u064a\u0639\u0640[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ]</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;] \u0627\u0644\u062f\u0627\u0631 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629 \u0648\u0627\u0644\u062d\u062f \u0627\u0644\u0631\u0627\u0628\u0639 \u0648\u0647\u0648 \u0627\u0644\u063a\u0631\u0628\u0649 \u064a\u0646\u062a\u0647\u0649 \u0627\u0644\u0649 \u062f\u0627\u0631 \u062a\u0639\u0631\u0641 \u0628\u0639\u064a\u0633\u0649 \u0628\u0646 \u064a\u0639\u0642\u0648\u0628 [&nbsp; &nbsp; &nbsp; &nbsp;]</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;] \u062d\u062a\u0649 \u062d\u0640[\u0640\u062f] \u0647\u0630\u0647 \u0627\u0644\u062f\u0648\u064a\u0631\u0629 \u0627\u0644\u062a\u0649 \u0641\u0649 \u0627\u0644\u062f\u0627\u0631 \u0627\u0644\u0643\u0628\u064a\u0631\u0629 \u0627\u0644\u0645\u062d\u062f\u0648\u062f\u062a\u064a\u0646 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 [&nbsp; &nbsp; &nbsp; &nbsp;]</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;] \u0645\u0646 \u062d\u0642\u0648\u0642\u0647\u0627 \u0648\u0643\u0644 \u062d\u0642 \u0647\u0648 \u0644\u0647\u0627 \u062f\u0627\u062e\u0644 \u0641\u064a\u0647\u0627 \u0648\u0643\u0644 \u062d\u0642 \u0647\u0648 \u0644\u0647\u0627 \u062e\u0627\u0631\u062c \u0645\u0646\u0647\u0627 \u0648\u0645\u062f\u062e\u0644\u0647\u0627 [&nbsp; &nbsp; &nbsp; &nbsp; ]</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;] \u0641\u062a\u064a\u0627\u0646 \u0628\u0646 \u0645\u062d\u0645\u062f \u0628\u0646 \u0627\u0644\u0633\u0645\u062d \u0627\u0644\u062a\u062c\u064a\u0628\u0649 \u062c\u0645\u064a\u0639 \u0647\u0630\u0627 \u0627\u0644\u062b\u0645\u0646 \u0627\u0644\u0645\u0633\u0645\u0649 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u062a\u0627\u0645\u0627 \u0648\u0627\u0641\u0640[\u0640\u064a\u0627&nbsp; &nbsp; &nbsp; ]</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0639\u064a\u0640]\u0640\u0627 \u0648\u0627\u0632\u0646\u0629 \u062c\u064a\u0627\u062f\u0627 \u0648\u0633\u0644\u0645 \u0627\u062d\u0645\u062f \u0628\u0646 \u062c\u0639\u0641\u0631 \u0627\u0644\u062e\u0648\u0627\u0631\u0632\u0645\u06cc \u0648\u0641\u062a\u064a\u0627\u0646 \u0628\u0646 \u0645\u062d\u0645\u062f&nbsp; \u0628\u0646 \u0627\u0644\u0633\u0645\u062d \u0627\u0644\u062a\u062c\u064a\u0628\u0649 \u0627\u0644\u0649 \u0645\u062d\u0645\u0640[\u0640\u062f \u0628\u0646 \u0627\u0633\u0645\u0639\u064a\u0644 \u0628\u0646 \u0627\u0644\u0642\u0627\u0633\u0645 \u0628\u0646 \u0637\u0628\u0627\u0637\u0628\u0627&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;]</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0641\u064a \u0647\u0630\u0627 \u0627]\u0644\u0643\u062a\u0627\u0628 \u0648\u0630\u0644\u0643 \u0628\u0639\u062f \u0645\u0639\u0631\u0641\u062a\u0647\u0645 \u0628\u0645\u0627 \u062a\u0628\u0627\u064a\u0639\u0648\u0627 \u0639\u0644\u064a\u0647 \u0648\u0645\u0639\u0627\u064a\u0646\u0629 \u0645\u0646\u0647\u0645 \u0644\u0647\u0630\u0647 \u0627\u0644\u062f\u0648[\u064a\u0631\u0629&nbsp; &nbsp; &nbsp;]</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0627\u0633\u0645\u0640]\u0639\u064a\u0644&nbsp;\u0628\u0646 \u0627\u0644\u0642\u0627\u0633\u0645 \u0628\u0646 \u0637\u0628\u0627\u0637\u0628\u0627 \u0641\u064a\u0645\u0627 \u0648\u0642\u0639 \u0639\u0644\u064a\u0647 \u0647\u0630\u0627 \u0627\u0644\u0634\u0631\u0649 \u0627\u0644\u0645\u0633\u0645\u0649 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0643\u0640[\u0640\u062a\u0627\u0628&nbsp; &nbsp; &nbsp; &nbsp; ]</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0647\u0640]\u0640\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0627\u0644\u0649 \u0645\u062d\u0645\u062f \u0628\u0646 \u0627\u0633\u0645\u0639\u064a\u0644 \u0628\u0646 \u0627\u0644\u0642\u0627\u0633\u0645 \u0628\u0646 \u0637\u0628\u0627\u0637\u0628\u0627 \u0639\u0644\u0649 \u0645\u0627 \u064a\u0648\u062c\u0640[\u0640\u0628\u0647 \u0644\u0647 \u0639\u0644\u064a\u0647 \u0647\u0630\u0627 \u0627\u0644\u0628\u064a\u0639&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ]</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0642\u0631\u0649 \u0639\u0644\u0640]\u0640\u064a\u0647\u0645 \u062c\u0645\u064a\u0639\u0627 \u062c\u0645\u064a\u0639 \u0645\u0627 \u0641\u064a\u0647 \u0645\u0646 \u0627\u0648\u0644\u0647 \u0627\u0644\u0649 \u0627\u062e\u0631\u0647 \u0641\u0627\u0642\u0631\u0648\u0627 \u0627\u0646 \u0642\u062f \u0641\u0647\u0645\u0648\u0647 \u0648\u0639\u0631[\u0641\u0648\u0627 \u062c\u0645\u064a\u0639\u0627 \u0628\u0645\u0627 \u0641\u064a\u0647 ]&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</li></ol>\n",
          "format": "text/html"
        }
