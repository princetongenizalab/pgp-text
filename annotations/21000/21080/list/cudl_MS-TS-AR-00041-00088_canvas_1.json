      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, right margin",
          "value": "\n<ol><li>\u0648\u0627\u0645\u0627 \u0645\u0627 \u0630\u0643\u0631\u062a\u0647 \u0645\u0646 \u0627\u0646\u0641\u0627\u0630 \u0627\u0644\u0630\u0647\u0628 \u0645\u0639 \u0648\u0641\u0627 \u0644\u0648 \u063a\u064a\u0631\u0647 . . . [</li>\n<li>\u0648\u0627\u0645\u0627 \u0645\u0627 \u0630\u0643\u0631\u062a\u0647 \u0645\u0646 \u0627\u0644\u062a\u0627\u0643\u064a\u062f \u0641\u064a \u0627\u0644\u0646\u062c\u0627\u0632 \u0641\u0645\u0627 \u062a\u062d\u062a\u0627\u062c \u062a\u0648\u0635\u064a\u0646\u064a \u0644\u0627\u0646\u0646\u064a . . [</li>\n<li>\u0627\u0644\u0633\u0639\u064a\u062f\u0629 \u0648\u0627\u0646 \u0643\u0627\u0646 . . . . \u0627\u0644\u0630\u0647\u0628(\u061f) \u0627\u0646 \u0643\u0646\u062a \u062a\u062d\u0636\u0631 \u0630[\u0644\u0643</li></ol>\n",
