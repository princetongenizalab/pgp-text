      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, top margin",
          "value": "\n<ol><li>\u0634\u064a \u0627\u0644\u0627 \u0645\u0646 \u064a\u0648\u0645 \u0648\u0635\u0648\u0644 \u0643\u062a\u0627\u0628\u0647\u0627 \u0641\u0644\u0627 \u062a\u0633\u062a\u0639\u0640[</li>\n<li>\u0641\u0645\u0627 \u062a\u0633\u062a\u0641\u064a\u0642 \u0627\u0644\u0627 \u0628\u0643\u062a\u0627\u0628\u064a \u0645\u0639 \u0631\u0633\u0648\u0644 \u0642\u0627\u0635\u062f \u0644\u0648 \u0627\u0646\u0627 \u0627\u0635\u0644 \u0627\u0644\u064a\u0647\u0627</li>\n<li>\u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0627\u062c\u062f\u0647\u0627 \u0648\u0627\u0639\u0630\u0631(\u061f) \u0648\u0627\u0645\u0627 \u0645\u0627 \u0630\u0643\u0631\u062a\u0647 \u0645\u0646 . . . \u0644\u0646\u0627 \u0645\u0627 \u0646\u062d\u062a\u0627\u062c\u0647</li>\n<li>\u0644\u0633\u0627\u0639\u0629 . . . \u0646\u0627 \u0645\u0646 \u0645\u0635\u0631 \u0641\u0647\u064a \u062a\u0639\u0644\u0645 \u0627\u0646 \u062f\u0645\u064a\u0627\u0637 \u0645\u0627 \u064a\u0639\u062f\u0645</li>\n<li>\u0641\u064a\u0647\u0627 \u0634\u064a \u0644\u0627\u0646\u0647\u0627 \u062b\u063a\u0631 \u0645\u0646 \u0627\u0644\u062b\u063a\u0648\u0631 \u0648\u0641\u064a\u0647\u0627 \u0643\u0644 \u0645\u0627 \u0646\u062d\u062a\u0627\u062c</li>\n<li>\u0627\u0644\u064a\u0647\u0627 \u0648\u0627\u0646\u0627 \u0645\u0642\u0627\u0645 \u0648\u0627\u0644\u062f\u0647\u0627 \u0627\u0644\u0634\u0641\u0648\u0642(\u061f)</li>\n<li>\u0648\u0627\u0646 \u0643\u0627\u0646\u062a \u0627\u0644\u0635\u0628\u064a\u0629 \u0628\u0646\u062a \u0627\u062e\u064a</li>\n<li>\u0641\u0627\u062d\u0636\u0631\u0647\u0627 \u0648\u0627\u0646 \u0627\u062e\u064a</li>\n<li>\u0648\u0648\u0644\u062f\u064a</li></ol>\n",
