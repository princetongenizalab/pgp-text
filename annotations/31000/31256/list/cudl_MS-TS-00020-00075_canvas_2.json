          "type": "TextualBody",
          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\n<p dir=\"rtl\">\u0648\u0627\u0639\u0640|\u0641\u0627\u0647(\u061f) \u0645\u0646 \u0643\u0644 \u0645\u062e\u0637\u0641 \u0648\u0645\u0646 \u0627\u0633\u062a\u0628\u0627\u0646\u0629 \u0645\u0646 \u064a\u0643\u0631\u0647 \u0645\u0639\u0627\u0645\u0644\u062a\u0647 \u0641\u0627\u0645\u0627 \u0628\u0642\u062f\u0631 \u0645\u0646[</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">&nbsp;\u0627\u0644\u0631\u0627\u063a\u0628 \u0641\u064a\u0647\u0627 \u0648\u062d\u0645\u0644\u0647 \u0639\u0644\u0649 \u0627\u0644\u0639\u062f\u0644 \u0641\u064a\u0645\u0627 \u062a\u0648\u0627\u0644\u0627\u0647 \u0648\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647 \u0641\u064a\u0645\u0627 \u0635\u063a\u0631 \u0645\u0646 \u0627\u0644\u062e\u062f\u0645 \u063a\u064a\u0631 \u0627\u0644\u0639\u0627\u0644\u064a\u0629</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0648\u0627\u0645\u0627 \u0627\u0644\u0627\u0630\u0646 \u0644\u0647 \u0628\u0627\u0644\u0648\u0641\u0648\u062f \u0644\u064a\u0633\u062a\u0645\u0639 \u0628\u0647 \u0645\u0627 \u0644\u0627 \u062a\u062d\u0645\u0644 \u0627\u0644\u0645\u0643\u0627\u062a\u0628\u0629 \u0630\u0643\u0631\u0647 \u0641\u0644\u0645 \u064a\u0628\u0642 \u0627\u0631\u062a\u0641\u0627\u0639 \u064a\u062d\u062a\u0627\u062c&nbsp;</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">&nbsp;\u062c\u0645\u0639\u0647 \u0648\u0635\u0648\u0646\u0647 \u0644\u0643\u0648\u0646 \u0627\u0644\u063a\u0644\u0627\u062a \u0628\u0646\u0648\u0627\u062d\u064a\u0647 \u0642\u062f \u0642\u0633\u0645\u062a \u0648\u062d\u0635\u0644\u062a \u0645\u062d\u0635\u0648\u0631\u0629 \u0641\u064a \u0627\u0644\u0645\u062e\u0627\u0632\u0646 \u0648\u0627\u0644\u062b\u0645\u0646.(\u061f)&nbsp;</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0642\u062f \u0634\u0631\u0639 \u0645\u0646 \u064a\u0642\u062f\u0631\u0647\u0627 \u0641\u0627\u0644\u0627 \u064a\u062c\u0628\u0647 \u0627\u0644\u0627\u0630\u0646 \u0627\u0644\u0627 \u0628\u0639\u062f \u0628\u064a\u0639\u0647\u0627 \u0648\u0627\u062d\u0636\u0627\u0631 \u062b\u0645\u0646\u0647\u0627 \u0648\u064a\u0646\u0647\u064a</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0639\u0646\u062f \u0627\u0633\u062a\u0645\u0627\u0639 \u0643\u0644\u0627\u0645\u0647 \u0641\u064a\u062a\u0628\u0639 \u0645\u0627 \u064a\u0648\u0645\u0631 \u0628\u0647 \u0645\u0646 \u0639\u0648\u062f \u0627\u0644\u0649 \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u0631\u0636 \u0644\u0647\u0627 \u0627\u0648 \u063a\u064a\u0631 \u0630\u0644\u0643</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">&nbsp;\u0648\u0644\u062d\u0636\u0631\u0629 \u0633\u064a\u062f\u0646\u0627 \u0627\u0644\u0640[\u0640\u0631\u0627\u064a] \u0627\u0644\u0640[\u0640\u0627\u0639\u0644\u0649 \u0641\u064a \u0630\u0644\u0643 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647</p>\n</li></ol>\n",
