          "value": "<p>:Right side of bifolio</p>\n\n\n<ol><li>\u05e2\u05dc\u05dd \u05de\u05e7\u05f3 \u05d9\u05d5\u05dd \u05d4\u05d5\u05e9\u05e2\u05e0\u05d0 \u05e8\u05d1\u05d0 \u05e9\u05e0\u05ea \u0666\u0660\u0665</li>\n<li>\u05dc\u05e7\u05f3\u05f3\u05e7 \u05e2\u05d6\u05e8\u05d4 \u05d4\u05e1\u05d5\u05e4\u05e8 [\u05de]\u05e2\u05f3\u05f3\u05d0(?)&nbsp;</li>\n<li>&nbsp;\u05e7\u05d5\u05d3\u05e9&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u05e9\u05de\u05e9\u05d9\u05dd</li>\n<li>\u05e4&nbsp; --&nbsp; \u0642&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u05e4&nbsp; -&nbsp; \u0642</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0661</li>\n<li>\u0662\u0660&nbsp; &nbsp;\u0661&nbsp; &nbsp; &nbsp; \u05d7\u05d9\u05d9\u05dd \u05e9\u05dc\u05d5\u05dd \u05d2&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0661</li>\n<li>\u0662\u0660&nbsp; &nbsp;\u0662&nbsp; &nbsp; &nbsp; \u05d9\u05e2\u05f3 \u05d3\u05d9\u05d9\u05df \u05e9\u05de\u05e9&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0662\u0660&nbsp; &nbsp; \u0660&nbsp; \u05e8\u05d7\u05de\u05d9\u05dd(?)</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0662&nbsp; &nbsp; &nbsp; \u05e0\u05e1\u05d9\u05dd \u05de\u05e9\u05d9\u05e9&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0661&nbsp; &nbsp;\u05de\u05e9\u05d9\u05e9</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0664&nbsp; &nbsp; &nbsp; \u05de\u05e9\u05d4 \u05e7\u05d5\u05e8\u05d9\u05d0\u05dc&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0663\u0660&nbsp; &nbsp; \u0661&nbsp; &nbsp;\u05dc\u05d5\u05de\u05d1\u05e8\u05d5\u05d6\u05d5</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0662&nbsp; &nbsp; &nbsp;\u05e9\u05dc\u05de\u05d4 \u05dc\u05d5\u05de\u05d1\u05e8\u05d5\u05d6\u05d5&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0661&nbsp; &nbsp;\u05d7\u05d6\u05d0\u05df</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0661&nbsp; &nbsp; &nbsp; \u05d7\u05d9\u05d9\u05dd \u05d7\u05d6\u05d0\u05df&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0662\u0660&nbsp; &nbsp; \u0660&nbsp; &nbsp;\u05d7\u05d3\u05d0\u05d3</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0661&nbsp; &nbsp; &nbsp; \u05d9\u05e2\u05f3 \u05d1\u05e8\u05e6'\u05d4&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0662\u0660&nbsp; &nbsp; \u0660&nbsp; &nbsp;\u05d0\u05d1\u05d5 \u05d4\u05d0\u05e8\u05d5\u05df</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0661&nbsp; &nbsp; &nbsp; \u05d9\u05e2\u05d9\u05e9 \u05d7\u05d3\u05d0\u05d3&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0662\u0660&nbsp; &nbsp; \u0660&nbsp; &nbsp;\u05e2\u05ea\u05d5\u05e9\u05d9</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0661&nbsp; &nbsp; &nbsp;\u05d0\u05d1\u05f3 \u05d0\u05d1\u05d5 \u05d4\u05d0\u05e8\u05d5\u05df \u05d4&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0661&nbsp; &nbsp;\u05e2\u05e4\u05d9\u05e4</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0660&nbsp; &nbsp; &nbsp;\u05d1\u05ea \u05e2\u05d2\u05d0\u05de\u05d9&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0661&nbsp; &nbsp;\u05d1\u05ea \u05d9\u05e2\u05d5\u05e6(?)</li>\n<li>\u0662\u0660&nbsp; &nbsp;\u0661&nbsp; &nbsp; &nbsp;\u05d1\u05e8\u05d5\u05da \u05e2\u05e4\u05d9\u05e4&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0663\u0660&nbsp; &nbsp; \u0660&nbsp; &nbsp; \u05e4\u05e1\u05d7</li>\n<li>\u0662\u0665&nbsp; &nbsp;\u0663&nbsp; &nbsp; \u05d9\u05d5\u05dd \u05d8\u05d5\u05d1 \u05e2\u05d6\u05d1\u05d9\u05e8\u05d9&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0662\u0660&nbsp; &nbsp; \u0660&nbsp; &nbsp; \u05e9\u05e9\u05d5\u05df</li>\n<li>\u0662\u0660&nbsp; &nbsp;\u0661&nbsp; &nbsp; &nbsp; \u05d7\u05d9\u05d9\u05dd \u05e4\u05e1\u05d7&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0661&nbsp; &nbsp; \u05e9\u05f3\u05f3 \u05dc\u05d5\u05d9 \u05d2\u05e8\u05f3\u05f3</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0661&nbsp; &nbsp; &nbsp; \u05e9\u05e9\u05d5\u05df \u05d8\u05d0\u05d5\u05d9\u05dc&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0661&nbsp; &nbsp; &nbsp;\u05e0\u05e1\u05d9\u05dd</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0662&nbsp; &nbsp; &nbsp;\u05e9\u05de\u05d5\u05d0\u05dc \u05dc\u05d5\u05d9 \u05d2\u05e8\u05f3&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0661&nbsp; &nbsp; &nbsp;\u05d7\u05d9\u05d9\u05dd \u05d7\u05e0\u05d0\u05df</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0662&nbsp; &nbsp; &nbsp;\u05e0\u05e1\u05d9\u05dd \u05d7\u05e0\u05d0\u05df&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0661&nbsp; &nbsp; &nbsp;\u05e4\u05d9\u05e0\u05d8\u05d5</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0662&nbsp; &nbsp; &nbsp;\u05d7\u05d9\u05d9\u05dd \u05d7\u05e0\u05d0\u05df \u05d4&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0662\u0660&nbsp; &nbsp; \u0662&nbsp;</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0663&nbsp; &nbsp; \u05d0\u05e6\u05dc\u05d0\u05df \u05e4\u05d9\u05e0\u05d8\u05d5&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0662\u0660&nbsp; &nbsp; &nbsp;\u0660&nbsp; &nbsp; &nbsp;\u05d7\u05e4\u05e5&nbsp;&nbsp;&nbsp;</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0664&nbsp; &nbsp; &nbsp;\u05d0\u05d1\u05f3 \u05d1\u05e9\u05d9\u05e8\u05d9 \u05d7\u05d6\u05e7&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ______&nbsp;&nbsp; &nbsp;</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0664&nbsp; &nbsp; &nbsp;\u05db\u05dc\u05d9\u05dc \u05e2\u05d1\u05d0\u05e8\u05d9(?)&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;&nbsp;\u0660\u0660&nbsp; \u0668[.]&nbsp;</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0661&nbsp; &nbsp; &nbsp;\u05d9\u05e2\u05e7\u05d1 \u05d7\u05e4\u05e5&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</li>\n<li>______&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</li>\n<li>\u0662\u0665&nbsp; &nbsp;\u0664\u0661&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0662&nbsp; &nbsp; &nbsp; \u05d1\u05d9\u05d0\u05dc[\u05d5\u05d1\u05d5]\u05e1&nbsp;&nbsp; &nbsp;&nbsp;</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0662&nbsp; &nbsp; &nbsp;\u05d1\u05d9\u05d0\u05dc\u05d5\u05d1\u05d5\u05e1&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0661\u0665&nbsp; &nbsp;\u0661&nbsp; &nbsp; &nbsp; \u05e9\u05dc\u05d5\u05dd</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; \u0663&nbsp; &nbsp; &nbsp;\u05e9\u05dc\u05d5\u05dd&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0661&nbsp; &nbsp; &nbsp; \u05e8\u05d5\u05de\u05d0\u05e0\u05d5</li>\n<li>[.]&nbsp; &nbsp; &nbsp;\u0661&nbsp; &nbsp; &nbsp;\u05e8\u05d5\u05de\u05d0\u05e0\u05d5&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0661&nbsp; &nbsp; &nbsp; \u05dc\u05d5\u05de\u05d1\u05e8\u05d5\u