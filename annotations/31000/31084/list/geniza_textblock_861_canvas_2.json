      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, first statement",
          "value": "\n<ol><li>\u0648\u0635\u0644</li>\n<li>\u064a\u062f \u0627\u0644\u0645\u0639\u0644\u0645 \u0645\u0635\u0644\u062d \u0627\u0644\u064a\u0647\u0648\u062f\u064a \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0628\u0627\u0637\u0646\u0647 \u0627\u0644\u0627\u0631\u0628\u0639 \u0627\u0644\u0627\u0641 \u0646\u0635\u0641 \u0641\u0636\u0629 \u0648\u062e\u0645\u0633 \u0645\u0627\u064a\u0629 \u0646\u0635\u0641 \u0641\u0636\u0629 \u0627\u0644\u0645\u0643\u062a\u062a\u0628</li>\n<li>\u0630\u0644\u0643 \u0628\u0628\u0627\u0637\u0646 \u0627\u0644\u062d\u062c\u0629 \u0645\u0646 \u064a\u062f \u0627\u0644\u0627\u0645\u064a\u0631 \u0633\u064a\u0627\u0648\u0634 \u0643\u0627\u0634\u0641 \u0627\u0644\u0628\u0647\u0646\u0633\u0627\u0648\u064a\u0629 \u0633\u0627\u0628\u0642\u0627 \u0639\u0646 \u064a\u062f \u0627\u0644\u0627\u0645\u064a\u0631 \u0642\u064a\u0637\u0627\u0633 \u062c\u0627\u0648\u0634</li>\n<li>\u0627\u0644\u0648\u0627\u0636\u0639 \u0627\u0633\u0645\u0647 \u0641\u064a\u0647 \u0641\u064a \u062b\u0627\u0644\u062b \u0639\u0634\u0631 \u0634\u0647\u0631 \u0635\u0641\u0631 \u0627\u0644\u062c\u064a\u062f \u0645\u0646 \u0634\u0647\u0648\u0631 \u0633\u0646\u0629 \u0661\u0660\u0666\u0660 \u0627\u0644\u0647\u0644\u0627\u0644\u064a\u0629</li></ol>\n",
