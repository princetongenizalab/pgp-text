      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, second statement",
          "value": "\n<ol><li>\u0648\u0635\u0644</li>\n<li>\u0639\u0646 \u0645\u0627 \u0647\u0648 \u0645\u0643\u062a\u062a\u0628 \u0628\u0627\u0637\u0646\u0647 \u0644\u064a\u062f \u0627\u0644\u0645\u0639\u0644\u0645 \u0645\u0635\u0644\u062d \u0627\u0644\u064a\u0647\u0648\u062f\u064a \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0628\u0627\u0637\u0646\u0647 \u0639\u0646 \u064a\u062f \u0627\u0644\u0627\u0645\u064a\u0631 ... \u0627\u0642\u0628\u0627\u0644\u0647 [\u061f]</li>\n<li>\u0645\u0646 \u064a\u062f \u0643\u0644 [\u061f] \u0645\u0646\u0647 [\u061f] \u0641\u064a \u0646\u0648\u0627\u062d\u064a... \u0645\u0646 \u0627\u0644\u0633\u0643\u0631 \u0627\u0644\u062e\u0627\u0645 \u0627\u0644\u0642\u0627\u064a\u0645 \u0641\u064a \u0627\u0639\u0645\u0627\u0644\u0647 </li>\n<li>\u0642\u0646\u0627\u0637\u0631 \u0642\u0648\u064a\u0629</li>\n<li>\u0645\u064a\u0627\u0629 \u0648\u062b\u0644\u0627\u062b\u064a\u0646</li></ol>\n",
