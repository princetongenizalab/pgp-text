    {
      "etag": "\"27ee20e4d20595e9957197af4ce8f879\"",
      "id": "https://geniza.princeton.edu/annotations/c5fe4fb0-81a7-411d-99c4-92fc4305e3f6/",
      "type": "Annotation",
      "created": "2026-09-03T14:45:00.641847+00:00",
      "modified": "2026-09-03T14:50:23.598901+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/135/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-AR-00038-00140/canvas/1",
          "type": "Canvas",
          "partOf": {
            "id": "https://geniza.princeton.edu/documents/16798/iiif/manifest/"
