      "body": [
        {
          "type": "TextualBody",
          "label": "Recto (Document 2)",
          "value": "\n<ol><li>\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645</li>\n<li>\u064a\u0642\u0648\u0644 \u0639\u0628\u062f \u0645\u0648\u0644\u0627\u0646\u0627 \u0635\u0644\u0648\u0627\u062a \u0627\u0644\u0644\u0647 [\u0639\u0644\u064a\u0647\u00a0 \u00a0 \u00a0 \u00a0 ]</li>\n<li>\u0627\u0646\u0646\u0649 \u0642\u0628\u0636\u062a \u0645\u0646 \u0645\u0627\u062c\u062f \u0628\u0646 \u064a\u0639\u0642\u0648\u0628 [\u00a0 \u00a0 \u00a0 \u00a0 \u00a0]</li>\n<li>\u0645\u0646 \u062c\u0645\u0644\u0629 \u0645\u0634\u0627\u0647\u0631\u062a\u0649 \u0644\u0633\u0646\u0629 \u062b\u0644\u062b \u0648\u0639\u0634\u0631\u064a\u0646 \u0648\u0627\u0631\u0628\u0639 \u0645\u0627\u0626\u0629 \u0628\u0644\u063a\u0640[ ] \u0627\u0644\u0640[\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 ]</li>\n<li>\u0648\u0635\u0648\u0644 \u062b\u0644\u062b\u0629 \u0648\u0639\u0634\u0631\u064a\u0646 \u0648\u0633\u062a\u0645\u0627\u0626\u0629 \u0648\u0635\u0648\u0644 \u0639\u0634\u0631\u0629 \u0648 [\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0]</li>\n<li>\u0648\u0627\u0628\u0631\u0627\u062a\u0647 \u0645\u0646 \u0630\u0644\u0643 \u0628\u0631\u0627\u0629 \u0642\u0628\u0636 \u0648\u0627\u0633\u062a\u064a\u0641\u0627 \u0648\u0643\u062a\u0628 \u0639\u0646\u0647 \u0628\u0627\u0645\u0631\u0647 \u0648\u0627\u062b\u0628\u062a ..[\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0]</li>\n<li>\u0641\u0649 \u0627\u0644\u0639\u0634\u0631 \u0627\u0644\u0627\u0648\u0644 \u0645\u0646 \u0630\u0649 \u0627\u0644\u062d\u062c\u0629 \u0633\u0646\u0629 \u062b\u0644\u062b \u0648\u0639\u0634\u0631\u064a\u0646 \u0648\u0627\u0631\u0628\u0639 \u0645\u0627\u0626\u0629</li>\n<li>\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0648\u0635\u0644\u0648\u0627\u062a\u0647 \u0639\u0644\u0649 \u0646\u0628\u064a\u0647 \u0645\u062d\u0645\u062f \u0648\u0627\u0644\u0640[\u0640\u0647 \u0648\u0633\u0644\u0645 \u062a\u0633\u0644\u064a\u0645\u0627]</li>\n<li>\u0648 \u062d\u0633\u0628\u0646\u0627 \u0627\u0644\u0644\u0647 \u0648\u0646\u0639\u0645 \u0627\u0644\u0648\u0643\u064a\u0644</li></ol>\n",
          "format": "text/html"
        }
      ],
