      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>\u064a\u062b\u0628\u062a \u0646\u064a\u0627\u0628\u0629 \u0639\u0646 \u062f\u064a\u0648\u0627\u0646 \u0627\u0644\u0627\u0634\u0631\u0627\u0641 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647&nbsp; &nbsp; &nbsp; &nbsp; [\u064a\u062b\u0628\u062a \u0628\u062f\u064a\u0648\u0627\u0646 \u0627\u0644\u0639\u0645\u0644]</li>\n<li>\u0627\u062b\u0628\u062a\u0648 \u0627\u0644\u0645\u0628\u0644\u063a ........&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u062b\u0644\u0627\u062b\u0629 \u0648\u0646\u0635\u0641 \u0648\u0646\u0635\u0641 \u062b\u0645\u0646</li>\n<li>\u0648\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0639\u0644\u0649 \u0646\u0639\u0645\u0647 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u0627\u062b\u0628\u062a\u0648 \u0627\u0644\u0645\u0628\u0644\u063a \u062b\u0644\u0627\u062b\u0629 \u0648\u0646\u0635\u0641</li>\n<li>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u062d\u0645\u062f \u0627\u0644\u0634\u0627\u0643\u0631\u064a\u0646</li>\n<li>\u0628\u0633\u0645&nbsp;\u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645 \u0635\u062d \u064a\u062b\u0628\u062a \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647</li>\n<li>\u0628\u0633\u0645 \u0635\u062d \u0644\u0627\u0628\u0648 \u0627\u0644\u062d\u0633\u0646 \u0628\u0646 \u0648\u0647\u0628 \u0645\u0646 \u0636\u0645\u0627\u0646\u0647 \u0644\u0644\u0636\u064a\u0639 \u0628\u0645\u062f\u064a\u0646\u0629 [ [\u0627\u0644\u0641\u064a\u0648\u0645 ] ] \u0627\u0644\u0641\u064a\u0648\u0645</li>\n<li>\u0644\u0633\u0646\u0629 \u062b\u0644\u0627\u062b \u0648\u0627\u0631\u0628\u0639\u0645\u0627\u0626\u0629 \u0648\u0627\u0633\u062a\u062e\u0631\u062c \u0641\u0649 \u0645\u062c\u0644\u0633 \u0627\u0644\u0645\u062e\u0632\u0646 \u0627\u0644\u0633\u0639\u064a\u062f \u0648\u0633\u0644\u0645 \u0644\u0644\u062e\u0632\u0627\u0646\u0629 \u0627\u0644\u0645\u0639\u0645\u0648\u0631</li>\n<li>\u0628\u062d\u0636\u0648\u0631 \u0627\u0644\u0642\u0627\u0636\u0649 \u0641\u062e\u0631 \u0627\u0644\u062f\u0648\u0644\u0629 \u0627\u0628\u0648 \u0627\u0644\u0641\u0636\u0644 \u062c\u0639\u0641\u0631 \u0628\u0646 \u0627\u0628\u0631\u0647\u064a\u0645 \u0628\u0646 \u0633\u0644\u064a\u0645\u0627\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0628\u062d\u0641\u0638</li>\n<li>\u0627\u0644\u0645\u0633\u062a\u062e\u0631\u062c \u0648\u0636\u0628\u0637\u0647</li>\n<li>\u0627\u0644\u0646\u0635\u0641 \u0645\u0646 \u0630\u0644\u0643 \u0646\u0635\u0641 \u0648\u0648\u0627\u062d\u062f&nbsp; &nbsp; \u0645\u0628\u0644\u063a\u0647 \u062b\u0644\u0627\u062b\u0629 \u0648\u0646\u0635\u0641 \u0648\u0646\u0635\u0641 \u062b\u0645\u0646 \u0648\u0627\u0644\u0645\u0628\u0644\u063a \u062b\u0644\u0627\u062b\u0629 \u0648\u0646\u0635\u0641 \u0648\u0646\u0635\u0641 \u062b\u0645\u0646</li>\n<li>\u0648\u0643\u062a\u0628 \u0645\u064a\u062e\u0627\u0626\u064a\u0644 \u0628\u0646 \u0639\u0628\u062f \u0627\u0644\u0645\u0633\u064a\u062d \u0627\u0644\u062c\u0647\u0628\u0630 \u0630\u0644\u0643 \u0628\u062e\u0637\u0647 \u0635\u062d \u0645\u0646\u0633\u0644\u062e \u062c\u0645\u0627\u062f\u0649 \u0627\u0644\u0627\u0648\u0644\u0649 \u0633\u0646\u0629 \u062b\u0644\u0627\u062b \u0648\u0627\u0631\u0628\u0639\u0645\u0627\u0626\u0629</li></ol>\n",
