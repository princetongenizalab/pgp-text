    {
      "etag": "\"d0cf041fba25507ac5d2c14ef7b487b2\"",
      "id": "https://geniza.princeton.edu/annotations/e8816cda-a0f5-4fa3-b5b7-4864cad62840/",
      "type": "Annotation",
