      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<p><i>Registration mark on right</i></p>\n\n<ol><li dir=\"ltr\">Let it be registered on behalf of the office of supervision, if God wills.</li>\n<li dir=\"ltr\">They have registered the amount of ....... three, a half and a sixteenth.</li>\n<li dir=\"ltr\">Praise be to God for his bounties, if God wills.</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
