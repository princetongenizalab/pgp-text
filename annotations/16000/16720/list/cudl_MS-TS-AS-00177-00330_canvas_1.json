    {
      "etag": "\"3c0cfc2aa372588f2d31656e736d3d83\"",
      "id": "https://geniza.princeton.edu/annotations/9f8eda15-1989-4479-9851-c39b15107024/",
      "type": "Annotation",
      "created": "2026-09-08T20:55:02.519304+00:00",
      "modified": "2026-09-17T15:40:52.782441+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/135/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-AS-00177-00330/canvas/1",
          "type": "Canvas",
          "partOf": {
