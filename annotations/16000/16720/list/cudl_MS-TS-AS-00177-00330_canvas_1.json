      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<p><i>Registration mark on right</i></p>\n\n<ol><li dir=\"ltr\">Let it be registered on behalf of the office of supervision,</li>\n<li dir=\"ltr\">if God wills.</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
