      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, top right",
          "value": "<p></p>\n\n<ol><li dir=\"ltr\">\n<p dir=\"ltr\">[Let it be registered] on behalf of the Bureau of (Tax) Supervision,</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">if God wills.</p>\n</li>\n\n\n<li dir=\"ltr\">\n<p dir=\"ltr\">[It has been registered, and] the amount is one d\u012bn\u0101r</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">[exactly].</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">Praise be to God for his benefactions.</p>\n</li></ol>\n\n",
          "format": "text/html"
        }
      ],
