          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\n<p dir=\"rtl\">[\u064a\u062b\u0628\u062a] \u0646\u064a\u0627\u0628\u0629 \u0639\u0646 \u062f\u064a\u0648\u0627\u0646 \u0627\u0644\u0627\u0634\u0631\u0627\u0641 </p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647   </p>\n</li>\n\n\n<li dir=\"rtl\">\n<p dir=\"rtl\">[\u0627\u062b\u0628\u062a \u0648]\u0627\u0644\u0645\u0628\u0644\u063a \u062f\u064a\u0646\u0627\u0631 \u0648\u0627\u062d\u062f\u00a0</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">[\u0633\u0648\u0627]   </p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0648\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0639\u0644\u0649 \u0646\u0639\u0645\u0647 </p>\n</li></ol>\n\n",
