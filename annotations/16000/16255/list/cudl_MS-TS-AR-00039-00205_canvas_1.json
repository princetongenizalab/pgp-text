      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<p><i>Registration mark on right</i></p>\n\n<ol><li dir=\"ltr\">[Let it be registered on behalf of the office of supervision,]</li>\n<li dir=\"ltr\">[if God wills.]</li>\n<li dir=\"ltr\">They have registered the amount of [two], a half, a third and an eighth.</li>\n<li dir=\"ltr\">Praise be to God, with the praise of those who give thanks.</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
    },
    {
      "etag": "\"c4a3669a471f749a624a873010286d95\"",
      "id": "https://geniza.princeton.edu/annotations/fb7b8906-50f7-4608-8cc5-53cef3ad87d7/",
      "type": "Annotation",
      "created": "2026-09-07T17:49:47.640186+00:00",
