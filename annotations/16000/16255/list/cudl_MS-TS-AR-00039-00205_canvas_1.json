      "dc:source": "https://geniza.princeton.edu/sources/135/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-AR-00039-00205/canvas/1",
          "type": "Canvas",
          "partOf": {
