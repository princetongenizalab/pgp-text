      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<p><i>Registration mark on right</i></p>\n\n<ol><li>Let it be registered on behalf of the office of supervision,</li>\n<li dir=\"ltr\">if God wills.</li>\n<li dir=\"ltr\">They have registered the amount of three, a third, a quarter, a sixth and an eighth.</li>\n<li dir=\"ltr\">Praise be to God, with the praise of those who give thanks.</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
    },
    {
