      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<ol>\n<li>\n<p>[\u0639\u0644\u0640]\u0640\u0649 [\u0645\u0648\u0644\u0627\u0646\u0627 \u0648\u0633\u064a\u062f\u0646\u0627 \u0627\u0644\u0627\u0645\u0627\u0645 \u0627\u0644\u0645\u0633\u0640]\u0640\u062a\u0646\u0635\u0631 \u0628\u0627\u0644\u0644\u0647 \u0627\u0645\u064a\u0631 [\u0627\u0644\u0645\u0640]\u0648[\u0640\u0645\u0646\u064a\u0640]\u0640\u0646&nbsp; [\u0648\u0639\u0644\u0649 \u0627\u0628\u0627\u0626\u0647]</p>\n</li>\n<li>\n<p>\u0627\u0644\u0637\u0627\u0647\u0631\u064a\u0646 \u0639\u0628\u062f \u0645\u0648\u0644\u0627\u0646\u0627 \u0635\u0644\u0648\u0627\u062a \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u064a\u0646\u0647\u0649 \u0627\u0644\u064a</p>\n</li>\n<li>\n<p>\u0627\u0644\u062d\u0636\u0631\u0629 \u0627\u0644\u0637\u0627\u0647\u0631\u0629 \u0645\u0627 \u0647\u0648 \u0639\u0644\u064a\u0647 \u0645\u0646 \u0627\u0644\u0627\u0639\u062a\u0642\u0627\u0644 \u0641\u064a \u0627\u0644\u062e\u0632\u0627\u0646\u0629 \u0648\u0623\u0646</p>\n</li>\n<li>\n<p>\u0627\u0644\u062a\u0627\u062f\u064a\u0628 \u0642\u062f \u0627\u062e\u0630 \u0645\u0646\u0647 \u0628\u062d\u0642 \u0648\u064a\u0633\u0644 \u0627\u0644\u0627\u0646\u0639\u0627\u0645 \u0639\u0644\u064a\u0647 \u0648\u0627\u0644\u0623\u062d\u0633\u0627\u0646</p>\n</li>\n<li>\n<p>\u0627\u0644\u064a\u0647 \u0628\u0627\u0644\u0635\u062f\u0642\u0629 \u0628\u0647 \u0639\u0644\u0649 \u0645\u0646 \u0641\u062f\u0627\u0647 \u0645\u0646 \u0627\u0644\u0639\u064a\u0644\u0629 \u0648\u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u0648\u0627\u0644\u0648\u0627\u0644\u062f\u0629</p>\n</li>\n<li>\n<p>\u0627\u0644\u0632\u0645\u0646\u0629 \u0648\u0644\u0645\u0648\u0644\u0627\u0646\u0627 \u0635\u0644\u0648\u0627\u062a \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0639\u0627\u0644\u0649 \u0627\u0644\u0631\u0627\u0649 \u0641\u064a \u0630\u0644\u0643 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647</p>\n</li>\n<li>\n<p>\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0648\u062d\u062f\u0647 \u0648\u0635\u0644\u0648\u0627\u062a\u0647 \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0633\u064a\u062f\u0646\u0627 \u0645\u062d\u0645\u062f \u0646\u0628\u064a\u0647 \u0648\u0627\u0644\u0647 \u0627\u0644\u0637\u0627\u0647\u0631\u064a\u0646 \u0648\u0633\u0644\u0645 \u062a\u0633\u0644\u064a\u0645\u0627</p>\n</li>\n</ol>",
