        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;]...............\u0627\u0644\u0641\u0642\u064a\u0647..[ ] .....[ ]</li>\n<li>[&nbsp; &nbsp; &nbsp; \u0627\u0644\u0641\u0627\u0626\u0632 \u0628\u0646\u0640]\u0640\u0635\u0631 \u0627\u0644\u0644\u0647 \u0627\u0645\u064a\u0631 \u0627\u0644\u0645\u0648\u0645\u0646\u064a\u0646 \u0635\u0644\u0648\u0627\u062a \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0639\u0644\u064a \u0627\u0628\u0627\u0626\u0647 \u0627\u0644\u0637\u0627\u0647\u0631\u064a\u0646 \u0648\u0627\u0628\u0646\u0627\u0626\u0647 \u0627\u0644\u0645\u0646\u062a\u0638\u0631\u064a\u0646 \u0627\u0644\u0645\u0647\u062a\u062f\u064a\u0646</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0633\u0640]\u0640\u064a\u0641 \u0627\u0644\u0627\u0633\u0644\u0627\u0645 \u063a\u064a\u0627\u062b \u0627\u0644\u0627\u0646\u0627\u0645 \u0643\u0627\u0641\u0644 \u0642\u0636\u0627\u0629 \u0627\u0644\u0645\u0633\u0644\u0645\u064a\u0646 \u0648\u0647\u0627\u062f\u0649 \u062f\u0639\u0627\u0629 \u0627\u0644\u0645\u0648\u0645\u0646\u064a\u0646 \u0639\u0636\u062f \u0627\u0644\u0644\u0647 \u0628\u0647 \u0627\u0644\u062f\u064a\u0646</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ]\u0627\u0644\u0642\u0627\u0636\u0649 \u0627\u0644\u0645\u0641\u0636\u0644 \u0627\u0644\u0627\u0645\u064a\u0646 \u0636\u064a\u0627 \u0627\u0644\u062f\u064a\u0646 \u0639\u0644\u0645 \u0627\u0644\u0645\u0647\u062a\u062f\u064a\u0646 \u0635\u0641\u0648\u0629 \u0627\u0644\u0627\u0645\u0627\u0645 \u062c\u0645\u0627\u0644 \u0627\u0644\u062d\u0643\u0627\u0645 \u0634\u0631\u0641 \u0627\u0644\u0639\u0644\u0645\u0627</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ] \u0639\u0645\u0627\u062f \u0627\u0644\u062f\u0648\u0644\u0629 \u0648\u062c\u0644\u0627\u0644\u0647\u0627 \u0627\u0628\u0649 \u0645\u062d\u0645\u062f \u0639\u0628\u062f \u0627\u0644\u0644\u0647 \u0628\u0646 \u0643\u0627\u0645\u0644 \u0628\u0646 \u0639\u0628\u062f \u0627\u0644\u0643\u0631\u064a\u0645 \u0639\u0644\u0649 \u0627\u0644\u062d\u0643\u0645 \u0627\u0644\u0639\u0632\u064a\u0632</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;]\u0644\u0647 \u0627\u0644\u0639\u0644\u0648\u064a\u0629 \u0643\u0644\u0647\u0627 \u062e\u0644\u062f \u0627\u0644\u0644\u0647 \u0645\u0644\u0643 \u0645\u0627\u0644\u0643\u0647\u0627 \u0648\u0635\u0644\u0649 \u0639\u0644\u064a\u0647 \u0648\u064a\u0627\u0645\u0631\u0647 \u0628\u0627\u0642\u062a\u0636\u0627\u0621 \u0627\u0648\u0627\u0645\u0631\u0647 \u0643\u0644\u0647\u0627</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;] \u0627\u0644\u0642\u0627\u0636\u064a\u0627\u0646 \u0627\u0644\u0627\u0633\u0639\u062f \u0627\u0644\u0645\u0643\u064a\u0646 \u0627\u0645\u064a\u0646 \u0627\u0644\u0645\u0644\u0643 \u0639\u0632 \u0627\u0644\u0642\u0636\u0627\u0629 \u0646\u0648\u0631 \u0627\u0644\u062f\u0648\u0644\u0629 \u0648\u0633\u062f\u064a\u062f\u0647\u0627 \u0627\u0628\u0648 \u0639\u0644\u0649</li>\n<li>[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;] \u0627\u0644\u0645\u062d\u062a\u0631\u0633\u0629 \u0648\u062e\u0635\u0648\u0645 [&nbsp; &nbsp; &nbsp; &nbsp; ] \u0627\u0644\u0627\u062d\u0631\u0627\u0631 \u0627\u0644\u0645\u0633\u0644\u0645\u064a\u0646 \u0648\u0647\u0648 \u0644\u0647\u0645 \u0641\u064a\u0647 \u0648\u0647\u0645</li></ol>\n",
