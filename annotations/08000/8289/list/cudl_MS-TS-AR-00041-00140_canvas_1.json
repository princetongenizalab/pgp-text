      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, address",
          "value": "\n<ol><li>\u064a\u0635\u0644 \u0647\u0630\u0647 \u0627\u0644\u0631\u0642\u0639\u0629 \u0627\u0644\u0649 \u0627\u0633\u064a\u0648\u0637 \u0627\u0644\u0649 \u0627\u0644\u0634\u064a\u062e</li>\n<li>\u0628\u0648 \u0627\u0644\u0645\u062c\u062f \u0628\u0646 //\u0627\u0644\u0634\u064a\u062e \u0627\u0628\u0648 \u0627\u0644\u0645\u0646\u0627// \u0627\u0644\u062f\u0645\u064a\u0627\u0637\u064a \u0627\u0637\u0627\u0645 \u0627\u0644\u0644\u0647 \u0639\u0632\u0647</li>\n<li>\u0628\u0644\u063a \u062a\u0648\u062c\u0631</li>\n<li>\u0634\u0627\u0643\u0631 \u062a\u0641\u0636\u0644\u0647</li>\n<li>\u0627\u0628\u0648 \u0627\u0644\u0633\u0631\u0648\u0631 \u0628\u0646 \u0628\u0648 \u0627\u0644\u0645\u0646\u0649</li></ol>\n",
