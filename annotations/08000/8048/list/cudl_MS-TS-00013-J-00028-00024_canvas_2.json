      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li>Do not spare any effort on behalf of this boy, in honor of our master Shaykh</li>\n<li>Ab\u016b al-Ri\u1e0d\u0101&mdash;may God perpetuate his glory. There is no need for me to press you further in this matter,</li>\n<li>for you know well the benevolence of our master Shaykh Ab\u016b al-Ri\u1e0d\u0101, and the rights owed to his father</li>\n<li>and to himself&mdash;especially [in light of] the father of this boy.</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
