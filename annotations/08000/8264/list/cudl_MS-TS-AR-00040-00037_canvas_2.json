      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, right side, margin",
          "value": "\n<ol><li>\u0627\u0644\u062d\u0627\u0641\u0638\u0649 \u0627\u0644\u0633\u0639\u064a\u062f \u0648\u062b\u0628\u0648\u062a\u0647 \u0628\u062d\u064a\u062b \u064a\u062b\u0628\u062a \u0645\u062b\u0644\u0647 \u0648\u0643\u062a\u0628 \u0644\u062a\u0633\u0639 \u0628\u0642\u064a\u0646 \u0645\u0646 \u0634\u0647\u0631 \u0631\u0628\u064a\u0639 \u0627\u0644\u0627\u0648\u0644&nbsp;</li>\n<li>\u0633\u0646\u0629 \u062b\u0645\u0627\u0646 \u0648\u0639\u0634\u0631\u064a\u0646 \u0648\u062e\u0645\u0633\u0645\u0627\u0626\u0629</li></ol>\n",
