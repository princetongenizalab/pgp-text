      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<p><i>Registration mark on right</i></p>\n\n<ol><li>Let it be registered on behalf of the office of supervision,</li>\n<li dir=\"ltr\">if God wills.</li>\n<li dir=\"ltr\">They have registered the amount of two and a half.\u00a0</li>\n<li dir=\"ltr\">Praise be to God for his bounties.</li></ol>\n",
          "format": "text/html"
        }
