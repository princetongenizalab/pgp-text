          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li dir=\"rtl\">\n<p dir=\"rtl\">\u0648\u0633\u0639\u0631\u0627\u061f \u0648\u0643\u062b\u0631 \u0645\u0644\u0643\u0627\u061f \u0645\u0627 \u0644\u0627\u0646\u0647 \u0644\u0644\u0633\u0640..</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u0644\u0639&hellip;.\u0648\u0639\u0647\u062f \u0627\u0644\u0649 \u062f\u0648\u0631 \u0641\u064a \u0639\u0640[</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0648\u062c\u0645\u0627\u0639 \u0648\u062f\u0627\u0631 \u0628\u0631\u0633\u0645 \u0627\u0644\u062f\u0639\u0627\u0629&hellip;\u062c\u0645\u064a\u0639..</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0648\u0627\u0647\u062f\u0627 \u0627\u0644\u0627\u062d\u062c\u0627\u0631 \u0644\u0628\u0646\u0627&hellip;\u0648\u0627\u0635\u062d\u0627\u0628\u0647 \u0648\u0644\u0645\u0631..</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u0645\u0631\u0647 \u0627\u0644\u0649 \u0627\u0646 \u0627\u062e\u0630 \u0628\u0644\u0627\u0637 \u0645\u0646 \u0627\u0644\u062c\u0627\u0645\u0639 \u0628\u0644\u0637[\u064a\u0645\u061f</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0641\u0644\u0645 \u064a\u062c\u0628\u0646\u064a \u0645\u0639\u0627\u0645\u0644 \u064a\u0639\u0627\u0645\u0644\u0646\u064a \u0639\u0644\u0649 \u0627\u0631\u0636 \u0648\u0644\u0627 \u0627\u0644\u0642\u0635\u062f</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0641\u064a \u062c\u0645\u064a\u0639 \u0627\u0645\u0644\u0627\u0643 \u0627\u0644\u0633\u0644\u0637\u0627\u0646 \u0641\u064a \u0627\u0644\u062f\u064a\u0648\u0627\u0646\u064a\u0646</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0641\u064a \u063a\u0631\u0641\u0629 \u0644\u0627\u0631\u0627\u0636\u064a\u0647 \u0648\u0627\u0644\u0628\u0633\u0627\u062a\u064a\u0646 \u0628\u0633\u0639\u064a/\u064a\u0633\u0639\u0649 \u0627\u0646&hellip;</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0648&hellip; \u0648\u0627\u0633\u062a\u0641\u062d\u0644 \u0628\u0639\u062f \u0627\u062c\u062a\u0645\u0627\u0639 \u0645\u0646\u0647 \u0628\u064a\u0639 \u0635\u0627[\u062d\u0628&hellip;</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">&hellip;&hellip;&hellip;&hellip;&hellip;&hellip;&hellip;&hellip;&hellip;..\u0627\u0644\u0635.\u0640\u0639\u0640</p>\n</li></ol>\n",
