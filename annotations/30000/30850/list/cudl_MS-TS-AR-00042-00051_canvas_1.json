      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, annotations",
          "value": "<p>Top margin</p>\n\n<ol><li>\u0645\u0628\u0644\u063a \u0645\u0627 \u0642\u0628\u0636\u0648\u0647\u00a0 //\u0627\u0644\u0640\u0636\u0645\u0646\u0627 \u0645\u0646 \u0627\u0644\u0642\u0635\u0628\\\\</li>\n<li>\u0628\u0631\u0633\u0645 \u0627\u0644\u0646\u0635\u0628 \u0645\u0646 \u0627\u0644\u0636\u0631\u0627\u0626\u0628</li>\n\n<p>\u00a0</p>\n<p>Line 7</p>\n\n<li>\u0628\u0646\u0635\u0641\u00a0 \u0646\u0635\u0641</li>\n\n<p>\u00a0</p>\n<p>Below line 7</p>\n\n<li>\u00a0\u0628\u062a\u0627\u0645\u0647 \u0646\u0635\u0641 \u0628\u062a\u0627\u0645\u0647 \u0646\u0635\u0641\u00a0\u00a0</li>\n\n<p>\u00a0</p>\n<p>Bottom</p>\n\n<li>\u0628\u062a\u0627\u0645\u0647 \u0646\u0635\u0641\u00a0</li>\n<li>\u0646\u0635\u0641\u00a0\u00a0</li></ol>\n",
