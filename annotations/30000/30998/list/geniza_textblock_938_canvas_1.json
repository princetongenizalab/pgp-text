      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>\u0645\u0644\u062d\u0642 \u062e\u064a\u0631</li>\n<li>\u0633\u0644\u0627\u0645 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0648\u0631\u062d\u0645\u062a\u0647 \u0648\u0628\u0631\u0643\u0627\u062a\u0647 \u0648\u0627\u0632\u0643\u0649 \u062a\u062d\u064a\u0627\u062a\u0647 \u0646\u062e\u0635 \u0628\u0630\u0627\u0644\u0643</li>\n<li>\u062d\u0636\u0631\u0629 \u0627\u0644\u062c\u0646\u0627\u0628 \u0627\u0644\u0645\u0643\u0631\u0645 \u0633\u064a\u062f\u064a \u0645\u062d\u0645\u062f \u062d\u0633\u0646 \u0627\u0639\u0632\u0647 \u0627\u0644\u0644\u0647 \u0627\u0645\u064a\u0646\u0646</li>\n<li>\u0628\u0639\u062f \u0627\u0647\u062f\u0627 \u0645\u0632\u064a\u062f \u0627\u0644\u0633\u0644\u0627\u0645 \u0639\u0644\u064a\u0647 \u0644\u0627 \u064a\u062e\u0641\u0627 \u0645\u0646 \u062a\u0639\u0631\u0641\u0643\u0645 \u0627\u0646 \u0633\u0627\u0628\u0642 \u062a\u0627\u0631\u064a\u062e\u0647</li>\n<li>\u0627\u0631\u0633\u0644\u0646\u0627 \u0639\u0631\u0641\u0646\u0627\u0643\u0645 \u0627\u0646\u0643\u0645 \u062a\u0627\u062e\u0630 \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0645 \u0634\u0645\u0639\u0648\u0646 \u0641\u0631\u0646\u0633\u064a\u0633</li>\n<li>\u0627\u062b\u0646\u064a \u0639\u0634\u0631 \u0627\u0644\u0641 \u0641\u0636\u0629 \u0648\u062e\u0645\u0633 \u0627\u0644\u0627\u0641 \u0648\u062b\u0645\u0627\u0646 \u0645\u0627\u064a\u0629 \u0641\u0636\u0629</li>\n<li>\u0642\u0631\u0648\u0634 \u0643\u0628\u0627\u0631 \u0648\u0644\u0627\u0643\u0627\u0646 \u0647\u0630\u0627 \u063a\u0644\u0637 \u0648\u0627\u0644\u0635\u0648\u0627\u0628 \u0627\u0646\u0643\u0645 \u062a\u0627\u062e\u0630\u0648</li>\n<li>\u0645\u0646 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0627\u062b\u0646\u064a \u0639\u0634\u0631 \u0627\u0644\u0641 \u0641\u0636\u0629 \u0648\u062a\u0639\u0637\u064a\u0647 \u0627\u0644\u0648\u062f\u0627\u0639\u0629 \u0628\u062a\u0627\u0639\u0647</li>\n<li>\u0648\u0627\u0646 \u0627\u0644\u062e\u0645\u0633 \u0627\u0644\u0627\u0641 \u0648\u062b\u0645\u0627\u0646 \u0645\u0627\u064a\u0629 \u0627\u0644\u0641\u0636\u0629 \u0627\u0644\u0642\u0631\u0648\u0634 \u0627\u0644\u0643\u0628\u0627\u0631</li>\n<li>\u0641\u064a \u0627\u0644\u0648\u062f\u0627\u0639\u0629 \u0628\u062a\u0627\u0639\u0646\u0627 \u0627\u0644\u0630\u064a \u0641\u064a\u0647\u0627 \u0627\u0644\u0645\u0627\u064a\u0629 \u0628\u0646\u062f\u0642\u064a \u0648\u0627\u0644\u0645\u0627\u064a\u0629</li>\n<li>\u0641\u0631\u0627\u0646\u0633\u0629 \u064a\u0643\u0648\u0646 \u0630\u0627\u0644\u0643 \u0641\u064a \u0634\u0631\u064a\u0641 \u0639\u0644\u0645\u0643\u0645 \u0648\u0627\u0644\u0633\u0644\u0627\u0645</li></ol>\n",
          "format": "text/html"
        }
