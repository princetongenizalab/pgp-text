          "value": "<p>\u00a0</p>\n\n<ol><li dir=\"rtl\">\u0648\u0644\u0645\u0648\u0644\u0627\u0646\u0627 \u0635\u0644\u0648\u0627\u062a \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0627\u0644\u0631\u0627\u0649 \u0627\u0644\u0639\u0627\u0644\u0649 \u0641\u064a \u0630\u0644\u0643 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647</li>\n<li dir=\"rtl\">\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0648\u062d\u062f\u0647 \u0648\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0633\u064a\u062f\u0646\u0627 \u0645\u062d\u0645\u062f \u0648\u0627\u0644\u0647 \u0648\u0633\u0644\u0645</li>\n<li dir=\"rtl\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u062d\u0633\u0628\u0649 \u0627\u0644\u0644\u0647 \u0648\u0646\u0639\u0645 \u0627\u0644\u0648\u0643\u064a\u0644</li>\n<li>\u0639\u0628\u062f\u0627 \u0645\u0648\u0644\u0627\u0646\u0627 \u0648\u0633\u064a\u062f\u0646\u0627 \u0627\u0644\u0627\u0645\u0627\u0645 \u0627\u0644\u0645\u0633\u062a\u0646\u0635\u0631 \u0628\u0627\u0644\u0644\u0647 \u0627\u0645\u064a\u0631 \u0627\u0644\u0645\u0648\u0645\u0646\u064a\u0646</li></ol>\n\n<p>\u00a0</p>",
