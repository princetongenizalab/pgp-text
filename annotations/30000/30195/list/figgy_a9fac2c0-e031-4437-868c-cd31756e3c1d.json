      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<p></p>\n\n<ol><li>\n<p>\u0627\u0639\u062a\u0631\u0641\u0646\u0627 \u0639\u0646\u062f\u064a \u0627\u0644\u0645\u0642\u0631\u064a\u0646 \u0628\u0630\u0644\u0643 \u0648\u0643\u062a\u0628 \u0645\u0633\u0644\u0645 \u0628\u0646 \u0627\u0644\u062d\u0633\u064a\u0646 \u0628\u0646 \u0645\u062d\u0645\u062f \u0627\u0644\u0640\u2026\u0640\u064a</p>\n</li>\n<li>\n<p>\u00a0     \u0648\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0648\u062d\u062f\u0647</p>\n</li>\n<li>\n<p>\u0628\u0633\u0645 \u0627\u0644\u0644\u0640\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645</p>\n</li>\n<li>\n<p>\u0636\u0645\u0646 \u0644\u0645\u0648\u0644\u0627\u0646\u0627 \u0648\u0633\u064a\u062f\u0646\u0627 \u0627\u0644\u0627\u0645\u0627\u0645 \u0627\u0644\u0645\u0633\u062a\u0646\u0635\u0631 \u0628\u0627\u0644\u0644\u0640\u0647 \u0627\u0645\u064a\u0631 \u0627\u0644\u0645\u0648\u0645\u0646\u064a\u0646 \u0635\u0644\u0648\u0627\u062a \u0627\u0644\u0644\u0640\u0647 \u0639\u0644\u064a\u0647 \u0648\u0639\u0644\u0649 \u0627\u0628\u0627\u0649\u0647 \u0627\u0644\u0637\u0627\u0647\u0631\u064a\u0646 \u0648\u0644\u0639\u0628\u062f\u0647 \u0645\u062a\u0648\u0644\u064a \u0627\u0644\u062f\u064a\u0648\u0627\u0646 (\u061f)</p>\n</li>\n<li>\n<p>\u0627\u0644\u0645\u0633\u062a\u0646\u0635\u0631\u064a \u0649\u0627\u0649\u062d\\\u0649\u0627\u0649\u0639 \u0627\u0644\u064a\u0647 \u0648\u0644\u0639\u0628\u062f\u0647 \u0648\u0639\u0627\u0645\u0644\u0647 \u0639\u0644\u0649 \u0627\u0644\u0636\u064a\u0627\u0639 \u0627\u0644\u0640\u2026\u0640\u064a\u0629 \u0627\u0644\u0627\u0639\u0632\u0629 \u064a\u062d\u064a\u0649 \u0628\u0646 \u0645\u0642\u0627\u0631\u0629 \u0639\u0628\u064a\u062f\u0647 \u0639\u064a\u0633\u0649 \u0628\u0646 \u062d\u062c\u0627\u062c \u0648\u0627\u0628\u0648 \u0627\u0644\u062d\u0633\u0646 \u0627\u062d\u0645\u062f(\u061f)\u00a0</p>\n</li>\n<li>\n<p>\u0643\u0641\u0627\u0644\u0629 \u0648\u062c\u0628\u0629 \u062d\u0641\u0627\u0638 \u0628\u0646 \u0631\u0645\u0636\u0627\u0646 \u0627\u0644\u0645\u0632\u0627\u0631\u0639 \u0628\u0627\u0644\u062c\u064a\u0648\u0634\u064a\u0629 \u0648\u0627\u062d\u0636\u0627\u0631\u0647 \u0644\u0645\u0648\u0642\u062a \u0627\u0644\u062a\u0645\u0633 \u0627\u062d\u0636\u0627\u0631\u0647 \u0645\u0646\u0647\u0645\u0627 \u0648\u0627\u0646 \u0643\u0627\u0646</p>\n</li>\n<li>\n<p>\u2026\u0647\u0645\u0627 \u0648\u00a0 \u2026 \u063a\u0627\u0628 \u0639\u0646\u0647 \u0647\u0631\u0628 \u0627\u0648 \u0627\u0633\u062a\u0648\u0644\u0649 \u0643\u0627\u0646 \u0639\u0644\u064a\u0647\u0645\u0627 \u0627\u0644\u0642\u064a\u0627\u0645 \u0628\u0645\u0627 \u064a\u062c\u0628 \u0639\u0644\u064a\u0647 \u0645\u0646 \u0627\u0644\u062e\u0631\u0627\u062c \u0627\u0644\u062a\u0648\u0627\u0628\u0639 \u0648\u0627\u0644\u0628\u0642\u0627\u064a\u0649</p>\n</li>\n<li>\n<p>\u0627\u0644\u0640 \u2026 \u064a\u062c\u0628 \u0628\u0647\u0630\u0647 \u0627\u0644\u0636\u064a\u0639\u0629 \u0644\u0633\u0646\u0629 \u062a\u0633\u0639 \u0648\u0639\u0634\u0631\u064a\u0646 \u0648\u0627\u0631\u0628\u0639 \u0645\u0627\u0649\u0629 \u0627\u0644\u062e\u0631\u0627\u062c\u064a\u0629 \u2026 \u0643\u0627\u0649\u0646\u0627 \u0645\u0627 \u0643\u0627\u0646 \u0648\u0628\u0627\u0644\u063a\u0627 \u0645\u0627 \u0628\u0644\u063a \u0644\u0627 \u064a\u062f\u0627\u0641\u0639\u00a0</p>\n</li>\n<li>\n<p>\u0628\u0630\u0644\u0643 \u0648\u0644\u0627 \u064a\u062d\u062a\u062c \u0628\u0647 \u0628\u062d\u062c\u0629 \u0639\u0644\u0649 \u0627\u0644\u0648\u062c\u0648\u0647 \u0648\u0627\u0644\u0627\u0633\u0628\u0627\u0628 \u0643\u0644 \u2026 \u0643\u0644 \u0648\u0627\u062d\u062f \u0645\u0646\u0647\u0645\u0627 \u0636\u0627\u0645\u0646 \u0639\u0646 \u0635\u0627\u062d\u0628\u0647 \u0648\u0643\u0641\u064a\u0644 \u062d\u0627\u0636\u0631\u0647\u0645\u0627</p>\n</li>\n<li>\n<p>\u0639\u0646 \u063a\u0627\u0649\u0628\u0647\u0645\u0627 \u0648\u0645\u0627\u0644\u0647\u0645\u0627 \u0639\u0646 \u0645\u0639\u062f\u0645\u0647\u0645\u0627 \u0648\u062d\u064a\u0647\u0645\u0627 \u0639\u0646 \u0645\u064a\u062a\u0647\u0645\u0627 \u0648\u0628\u0630\u0644\u0643 \u0627\u0634\u0647\u062f \u0639\u0644\u0649 \u0627\u0646\u0641\u0633\u0647\u0645\u0627 \u0641\u064a \u0635\u062d\u0629 \u0639\u0642\u0644\u0647\u0645\u0627 \u0648\u0628\u062f\u0646\u0647\u0645\u0627 \u0648\u062c\u0648\u0627\u0632 \u0627\u0645\u0631\u0647\u0645\u0627</p>\n</li>\n<li>\n<p>\u0637\u0627\u0649\u0639\u064a\u0646 \u063a\u064a\u0631 \u0645\u0643\u0631\u0647\u064a\u0646 \u0648\u0644\u0627 \u0645\u062c\u0628\u0631\u064a\u0646 \u0648\u0644\u0627 \u0645\u0636\u0637\u0647\u062f\u064a\u0646 \u0648\u0641\u064a \u0630\u064a \u0627\u0644\u062d\u062c\u0629 \u0633\u0646\u0629 \u0627\u062d\u062f\u0649 \u0648\u062b\u0644\u062b\u064a\u0646 \u0648\u0627\u0631\u0628\u0639 \u0645\u0627\u0649\u0629  </p>\n</li>\n<li>\n<p>\u0634\u0647\u062f \u0631\u0645\u0636\u0627\u0646 \u0628\u0646 \u0635\u0628\u062d \u0627\u0644\u0645\u0648\u0630\u0646\u00a0</p>\n</li>\n<li>\n<p>\u0639\u0644\u0649 \u0627\u0642\u0631\u0627\u0631\u0647\u0645\u0627 \u0628\u0630\u0644\u0643 \u0648\u0643\u062a\u0628 \u0639\u0646\u0647</p>\n</li>\n<li>\n<p>\u0628\u0627\u0645\u0631\u0647 \u0648\u0645\u062d\u0636\u0631\u0647 \u0628\u062a\u0627\u0631\u064a\u062e\u0647</p>\n</li>\n<li>\n<p>\u0634\u0647\u062f \u0648\u2026 \u0628\u0646 \u0645\u0637\u0644\u0628</p>\n</li>\n<li>\n<p>\u0644\u062c\u0645\u064a\u0639 \u0645\u0627 \u0641\u064a\u0647 \u0648\u0643\u062a\u0628 \u0628\u062e\u0637\u0647</p>\n</li>\n<li>\n<p>\u0634\u0647\u062f \u0627\u062d\u0645\u062f \u0628\u0646 \u0628\u062f\u0631 \u0628\u062c\u0645\u064a\u0639 \u0645\u0627 \u0641\u064a</p>\n</li>\n<li>\n<p>\u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u0643\u062a\u0628 \u0628\u062e\u0637\u0647</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
