    {
      "etag": "\"5aa965d4b399c6dd7ec3f305b062ac93\"",
      "id": "https://geniza.princeton.edu/annotations/3f5881f0-d279-4112-8b77-936802359d22/",
      "type": "Annotation",
      "created": "2026-04-27T22:34:02.494858+00:00",
      "modified": "2026-04-27T22:34:02.494867+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/1122/",
      "target": {
        "source": {
          "id": "http://cudl.lib.cam.ac.uk/iiif/MS-TS-00008-JA-00001/canvas/5",
          "type": "Canvas",
          "partOf": {
            "id": "https://geniza.princeton.edu/documents/39192/iiif/manifest/"
