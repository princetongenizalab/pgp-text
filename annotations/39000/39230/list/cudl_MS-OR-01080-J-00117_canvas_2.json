          "value": "<ol>\n<li><span lang=\"EN-US\"> </span><span lang=\"AR-SA\">\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645</span></li>\n<li><span lang=\"EN-US\"> </span><span lang=\"AR-LB\">\u0647\u0630\u0627 \u0645\u0627 \u0627\u0633\u062a\u0623\u062c\u0631 \u0645\u0648\u0633\u0649 \u0628\u0646 \u0623\u0628\u0648 \u0633\u0647\u0644 \u0645\u0646 \u0623\u062e\u064a\u0647 \u0623\u0628\u0648 \u0627\u0644\u062d\u0633\u0646 \u0627\u0644\u062e\u0632\u0627\u0646\u0629 \u0627\u0644\u062a\u064a \u062a\u0642\u0635\u062f \u0627\u0644\u062f\u0648\u0631 \u0627\u0644\u062a\u064a \u0635\u062f\u0642\u0647\u0627 \u0639\u0644\u064a\u0647 \u0648\u0627\u0644\u062f\u0647 \u0648\u0627\u0644\u0627\u062c\u0631\u0629 \u0628\u0633\u062a\u0629 \u0623\u0634\u0647\u0631 \u0648\u0647\u064a \u0645\u0646 \u0627\u0648\u0644 \u0627\u0630\u0627\u0631</span><span lang=\"AR-LB\"> </span><span lang=\"AR-LB\">\u0627\u0644\u0649 \u0627\u062e\u0631\u0627\u0641 </span></li>\n<li><span lang=\"AR-LB\">\u0639\u0644\u0649 \u062b\u0645\u0646 \u0627\u062b\u0646\u0627 \u0639\u0634\u0631 \u062f\u0631\u0647\u0645 \u0627\u0644\u0634\u0647\u0631 \u0648\u0644\u0627 \u064a\u0642\u0631\u0631 \u0639\u0644\u0649 \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0645\u0646\u0647\u0627 \u0627\u0644\u0627 \u0627\u0644\u0649 \u0627\u062e\u0631 \u0627\u0644\u0627\u062c\u0631 \u0648\u0647\u064a \u0627\u0644\u0633\u062a \u0634\u0647\u0648\u0631 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629 \u0648\u0627\u0644\u0633\u0644\u0645 \u0634\u0647\u062f \u0623\u0628\u0648 \u0627\u0644\u062d\u0633\u0646 \u0628\u0646 \u0627\u0628\u064a \u0633\u0647\u0644</span></li>\n<li>\u05e9\u05d4\u05d3 \u05de\u05d5\u05e1\u05d9 \u05d0\u05d1\u05df \u05d0\u05d1\u05d9<sup>\u05e1\u05d4\u05dc</sup> <span lang=\"AR-LB\">\u0627\u0628\u0631\u0647\u064a\u0645 \u0639\u0644\u0649 \u0627\u0644\u0622\u062c\u0631 \u0648\u0627\u0644\u0645\u0633\u062a\u0623\u062c</span></li>\n<li>\u05e2\u05dc