      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, left side",
          "value": "\n<ol><li>Let that be granted.</li>\n<li dir=\"ltr\">The exalted and noble ordinance of al-\u1e92\u0101fir, the benedictions of God be upon&nbsp; him, was given</li>\n<li dir=\"ltr\">to instruct al-H\u0101fi\u1e93's noble warehouse of books,</li>\n<li dir=\"ltr\">may God double its light, to issue the epistle of the worthy</li>\n<li dir=\"ltr\">elder, \u02bfAl\u012b ibn \u02bf\u012asa, for the \u02bfam\u012br Fa\u1e35r al-D\u012bn</li>\n<li dir=\"ltr\">\u02beAb\u016b Man\u1e63\u016br \u02bfIzz al-\u02bfArab ibn Mu\u1e25ammad, described as (the one of) the&nbsp; &scaron;urb\u016b&scaron; bonnets,</li>\n<li dir=\"ltr\">one of the entourage of the exalted presence, by means of the issuing of</li>\n<li dir=\"ltr\">a noble minute with the form 'let that be granted',</li>\n<li dir=\"ltr\">after seven days had passed of \u1e62afar, in the year five-hundred and thirty-seven,</li>\n<li dir=\"ltr\">as a benevolent act.</li>\n<li dir=\"ltr\">Our sufficiency is God. How excellent a keeper is he!</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
    },
