    {
      "etag": "\"010f4d1abf7938b7a693db2e96d16440\"",
      "id": "https://geniza.princeton.edu/annotations/b6c40471-0961-4987-891e-78bb37c62694/",
      "type": "Annotation",
      "created": "2026-11-25T21:09:54.505782+00:00",
