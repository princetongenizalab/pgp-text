      ],
      "schema:position": 1
    },
    {
      "etag": "\"130f8485f491468fb44e4ad00acb2d1a\"",
      "id": "https://geniza.princeton.edu/annotations/9794256b-0e7c-4cd7-b629-5990e35df68a/",
      "type": "Annotation",
      "created": "2025-11-11T21:47:50.497784+00:00",
      "modified": "2025-11-11T21:47:50.497797+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/141/",
      "target": {
        "source": {
          "id": "https://princetongenizalab.github.io/iiif/bodleian/d/canvas/ms-heb-d-74-41/2.json",
          "type": "Canvas",
          "partOf": {
            "id": "https://geniza.princeton.edu/documents/591/iiif/manifest/"
          }
        },
        "selector": {
          "type": "FragmentSelector",
          "value": "xywh=pixel:271.8385314941406,318.1043395996094,4559.504730224609,1494.5305480957031",
          "conformsTo": "http://www.w3.org/TR/media-frags/"
        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "verso",
          "value": "\n<ol><li>\u05de\u05df (!) \u05ea\u05dc\u05de\u05e1\u05d0\u05df \u05e2\u05dd \u05de\u05d0\u05d4 \u05d4\u05de\u05ea'\u05e7\u05d0\u05dc \u05d4\u05dc\u05dc\u05d5 \u05dc\u05d0 \u05e9[\u05dc\u05d7\u05ea] \u05d9 [...] \u05d0\u05dc\u05d9\u05da \u05e2\u05dd \u05d4\u05de\u05db\u05ea\u05d1 \u05d4\u05d6\u05d4, \u05db\u05d3\u05d9 \u05e9\u05dc\u05d0 \u05d9\u05d0\u05d1\u05d3, \u05d5\u05d0\u05e9\u05dc\u05d7 \u05d0\u05d5\u05ea\u05d5 \u05d0\u05dc\u05d9\u05da \u05e2\u05dd \u05de\u05d8\u05d1\u05e2\u05d5\u05ea \u05d4\u05d6\u05d4\u05d1,</li>\n<li>\u05d0\u05dd \u05d9\u05e8\u05e6\u05d4 \u05d4'. \u05d5\u05d4\u05e2\u05e9\u05e8\u05d9\u05dd \u05de\u05ea'\u05e7\u05d0\u05dc \u05d5\u05d7\u05e6\u05d9 \u05e9\u05d0\u05ea\u05df \u05dc\u05d0\u05d1\u05d5 \u05d9\u05e2\u05e7\u05d1, \u05d0\u05ea\u05df \u05de\u05df \u05d4\u05d9\u05ea\u05e8\u05d4 \u05e9\u05d0\u05e6\u05dc\u05d9. \u05d5\u05d0\u05e7\u05e0\u05d4 \u05d1\u05de\u05d4\u00a0</li>\n<li>\u05e9\u05e0\u05e9\u05d0\u05e8 \u05de\u05e9\u05d9 \u05de\u05e1\u05d5\u05d2 \u05db\u05d6\u05d0\u05d2', \u05d4\u05d8\u05d4\u05d5\u05e8 \u05e9\u05d4\u05d6\u05db\u05e8\u05ea, \u05d0\u05dd \u05d9\u05e8\u05e6\u05d4 \u05d4'. \u05d5\u05d0\u05e0\u05d9 \u05de\u05d1\u05e8\u05da \u05d0\u05d5\u05ea\u05da, \u05e1\u05d5\u05de\u05db\u05d9, \u05d1\u05de\u05d9\u05d8\u05d1 \u05d4\u05d1\u05e8\u05db\u05d5\u05ea \u05dc\u05e9\u05dc\u05d5\u05dd \u05d5\u05d4\u05e0\u05e2\u05d9\u05de\u05d4 \u05d5\u05d4\u05e2\u05e8\u05d1\u05d4 \u05e9\u05d1\u05d4\u05df, \u05db\u05e4\u05d9</li>\n<li>\u05d2\u05e2\u05d2\u05d5\u05e2\u05d9\u05d9 \u05e2\u05dc\u05d9\u05da, \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05d9\u05e1\u05dc\u05e7 \u05d0\u05d5\u05ea\u05dd \u05d4' \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05d4\u05ea\u05d7\u05d1\u05e8\u05d5\u05ea \u05e2\u05de\u05da, \u05d0\u05dd \u05d9\u05e8\u05e6\u05d4 \u05d4'. \u05d5\u05d1\u05e8\u05db\u05d5\u05ea \u05dc\u05e9\u05dc\u05d5\u05dd \u05d7\u05d5\u05d6\u05e8\u05d5\u05ea \u05d0\u05dc \u05e1\u05d5\u05de\u05db\u05d9 \u05d4\u05e8\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8, \u05d5\u05e8\u05d7\u05de\u05d9 \u05d4' \u05d9\u05ea\u05e2\u05dc\u05d4.</li>\n<li>\u05d5\u05d0\u05e0\u05d9 \u05de\u05d5\u05d3\u05d9\u05e2\u05da \u05e9\u05d4\u05e6\u05e2\u05ea\u05d9 \u05d1\u05de\u05db\u05d9\u05e8\u05d4 \u05e4\u05d5\u05de\u05d1\u05d9\u05ea \u05d0\u05ea \u05d4\u05d0\u05de\u05dc\u05d2' \u05d5\u05de\u05db\u05e8\u05ea\u05d9 \u05de\u05de\u05e0\u05d5 \u05d7\u05e6\u05d9 \u05e8\u05d5\u05d8\u05dc \u05d1\u05d7\u05e6\u05d9 \u05de\u05ea'\u05e7\u05d0\u05dc. \u05db\u05d0\u05e9\u05e8 \u05e7\u05e8\u05d0\u05ea\u05d9 \u05d0\u05ea \u05de\u05db\u05ea\u05d1\u05da \u05e9\u05d0\u05ea\u05d4 \u05e7\u05d5\u05d1\u05e2 \u05d1\u05d5</li>\n<li>\u05de\u05ea'\u05e7\u05d0\u05dc \u05d5\u05d7\u05e6\u05d9 \u05dc\u05e8\u05d5\u05d8\u05dc, \u05d4\u05e0\u05d7\u05ea\u05d9 \u05d0\u05d5\u05ea\u05d5 \u05d5\u05dc\u05d0 \u05de\u05db\u05e8\u05ea\u05d9 \u05de\u05de\u05e0\u05d5 \u05d0\u05dc\u05d0 \u05d7\u05e6\u05d9 \u05e8\u05d5\u05d8\u05dc. \u05d5\u05d4'\u05ea\u05e8\u05d1\u05d9\u05d3' \u05e9\u05d5\u05d5\u05d4 \u05e9\u05e0\u05d9 \u05e8\u05d5\u05d8\u05dc\u05d9\u05dd \u05d1\u05de\u05ea'\u05e7\u05d0\u05dc. \u05d5\u05d0\u05d5\u05d3\u05d9\u05e2\u05da</li>\n<li>\u05e9\u05d9\u05d5\u05dd \u05d0\u05d7\u05d3 \u05d0\u05d7\u05e8\u05d9 (\u05e9\u05db\u05ea\u05d1\u05ea\u05d9 \u05d0\u05ea) \u05de\u05db\u05ea\u05d1\u05d9 \u05d6\u05d4 \u05d4\u05d2\u05d9\u05e2\u05d4 \u05d0\u05e0\u05d9\u05d9\u05ea \u05e9\u05db\u05ea\u05d5\u05e8 \u05de\u05d0\u05dc\u05db\u05e1\u05e0\u05d3\u05e8\u05d9\u05d4 \u05d1\u05d6\u05de\u05df \u05e9\u05d0\u05e8\u05da \u05e9\u05d9\u05e9\u05d9\u05dd \u05d5\u05d7\u05de\u05d9\u05e9\u05d4 \u05d9\u05d5\u05dd. \u05d5\u05d4\u05d2\u05d9\u05e2\u05d5 \u05d1\u05d4 \u05de\u05d5\u05e1\u05dc\u05de\u05d9\u05dd,</li>\n<li>\u05e1\u05d5\u05d7\u05e8\u05d9\u05dd, \u05d5\u05d0\u05de\u05e8\u05d5 \u05e9\u05e2\u05d6\u05d1\u05d5 \u05e9\u05ea\u05d9 \u05d0\u05e0\u05d9\u05d5\u05ea \u05e9\u05d4\u05d5\u05e2\u05d3\u05d5 \u05dc\u05e0\u05e1\u05d5\u05e2 \u05d0\u05dc \u05d0\u05dc\u05de\u05e8\u05d9\u05d4. \u05d4\u05dd \u05e2\u05d6\u05d1\u05d5 \u05d0\u05d5\u05ea\u05df \u05d1\u05e9\u05e2\u05d4 \u05e9\u05e2\u05de\u05d3\u05d5 \u05dc\u05d4\u05e4\u05dc\u05d9\u05d2. \u05d5\u05d0\u05ea \u05d4\u05d0\u05e0\u05d9\u05d5\u05ea</li>\n<li>\u05e9\u05d4\u05e4\u05dc\u05d9\u05d2\u05d5 \u05de\u05d0\u05e0\u05d3\u05dc\u05d5\u05e1 \u05dc\u05d0 \u05e8\u05d0\u05d5 \u05d5\u05dc\u05d0 \u05d9\u05d3\u05e2\u05d5 \u05e2\u05dc\u05d9\u05d4\u05df \u05d3\u05d1\u05e8. \u05de\u05d9\u05d8\u05d1 \u05d1\u05e8\u05db\u05d5\u05ea\u05d9\u05d9 \u05dc\u05e9\u05dc\u05d5\u05dd \u05d5\u05d4\u05e0\u05e2\u05d9\u05de\u05d4 \u05e9\u05d1\u05d4\u05df \u05dc\u05e1\u05d5\u05de\u05db\u05d9</li>\n<li>\u05d4\u05e8\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d5\u05e8\u05d7\u05de\u05d9 \u05d4' \u05d9\u05ea\u05e2\u05dc\u05d4. \u05d5\u05d0\u05d5\u05d3\u05d9\u05e2\u05da \u05e9\u05e9\u05d9\u05dc\u05de\u05ea\u05d9 \u05dc\u05d0\u05d1\u05d5 \u05d9\u05e2\u05e7\u05d1 \u05e2\u05e9\u05e8\u05d9\u05dd \u05de\u05ea'\u05e7\u05d0\u05dc \u05d5\u05de\u05d7\u05e6\u05d4, \u05db\u05e4\u05d9 \u05e9\u05d4\u05d6\u05db\u05e8\u05ea. \u05d5\u05e9\u05dc\u05d5\u05dd. </li></ol>\n",
          "format": "text/html"
        }
      ],
