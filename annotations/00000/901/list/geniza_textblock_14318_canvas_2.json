      "body": [
        {
          "type": "TextualBody",
          "label": "Table 1",
          "value": "\n<ol><li dir=\"ltr\">5 payments of \u00bdd. less \u00bdq. (4 to same person) D, 4, 4, 11. E, 32, 33.</li>\n<li dir=\"ltr\">17 payments of 1d. less 1q. C, 8, 11, 15, 15, 16, 16. D, 9, 14, 18, 19, 20</li>\n<li dir=\"ltr\">25, 27, 27. E. 4, 14, 29.</li>\n<li dir=\"ltr\">9 payments of 2d. less 2q. C, 18, 22, D, 6, 10, 14, 16. E, 2, 12, 27.</li>\n<li dir=\"ltr\">2 payments of 2\u00bdd. less 2\u00bd q. C, 20. 2q. 1\u1e25 E, 13.</li>\n<li dir=\"ltr\">8 payments of 3d. less 3q. C, 5, 10, 10, 14, 17. D, 15, 16, 23 (less 1\u1e25.)</li>\n<li dir=\"ltr\">2 payments of 4d. less 4q. D, 17, E, 31 (BHBSHYM).</li>\n<li dir=\"ltr\">1 payment of 5d. less 5q. D, 9.</li>\n<li dir=\"ltr\">3 payments of 6d. less 6q. C, 18, 21. D, 5.</li>\n<li dir=\"ltr\">\n\n\n47 payments\n</li></ol>\n",
          "format": "text/html"
        }
      ],
