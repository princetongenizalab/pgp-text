      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, address",
          "value": "\n<ol><li>\u0644\u0633\u064a\u062f\u064a \u0648\u0645\u0648\ufefb\u064a \u0627\u0628\u064a \u064a\u0639\u0642\u0648\u0628 \u064a\u0648\u0633\u0641 \u0639\u0627\u0644\u0645 \u0627\u0644\u0641\u0627\u0633\u064a&nbsp;</li>\n<li>\u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647 \u0648\u0627\u062f\u0627\u0645 \u0633\u0644\u0627\u0645\u062a\u0647 [&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;]</li>\n<li>\u0634\u0627\u0643\u0631\u0647 \u0635\u0648\u0631 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647</li></ol>\n",
