          "conformsTo": "http://www.w3.org/TR/media-frags/"
        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, address in Judaeo-Arabic",
          "value": "<p>To my lord and master, Abu\u0304 Ya\u2018qu\u0304b Yu\u0304suf ibn \u2018Ali\u0304 ha-Kohen al-Fa\u0304si\u0304.</p>\n<p>May God lengthen his remaining [days] and make permanent his well-being and happiness.</p>\n<p>From Nahray ben Nissim, with thanks to him.</p>\n<p>Send to Tyre, God willing</p>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 2
