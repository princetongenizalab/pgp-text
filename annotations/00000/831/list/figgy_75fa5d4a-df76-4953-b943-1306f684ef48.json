      "body": [
        {
          "type": "TextualBody",
          "label": "right margin",
          "value": "\n<ol><li dir=\"ltr\">Rise, shine, for your light has come and the glory of the Lord, has shone upon you. For darkness shall cover the earth and gross darkness the peoples; but upon you the Lord will shine, and His glory shall be seen upon you. And nations shall walk by your light, and\u00a0 kings by the brightness of your shine. For the commandment is a lamp and [the Torah a light. ...]\u00a0\u00a0</li>\n<li dir=\"ltr\">Rejoice not against me, O mine enemy. Though I sit in darkness, the Lord is light unto me. [A Psalm] of David. The Lord is my light and\u00a0 my salvation; whom shall I fear? The Lord is the stronghold of my life; of whom shall I be afrai[d? ...]</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
