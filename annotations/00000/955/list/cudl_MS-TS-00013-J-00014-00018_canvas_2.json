      "body": [
        {
          "type": "TextualBody",
          "label": "address, Judaeo-Arabic",
          "value": "<p>To my lord and master Ab\u016b Ya\u1e25ya Nahray ben Nissim, may God prolong his life and maintain his benefaction and assistance.</p>\n<p>From Israel ben Nathan. In Fust\u0101t.</p>\n<p>If God wills it.</p>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 2
    },
