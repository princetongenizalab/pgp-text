      "body": [
        {
          "type": "TextualBody",
          "label": "Verso - address",
          "value": "<ol>\n<li>\n<p>To my lord the elder Ab\u016b Ya\u1e25y\u0101 Nahray b. Nissim, </p>\n</li>\n<li>\n<p>may God prolong his existence and make his glory eternal, </p>\n</li>\n</ol>\n<p>1. from the one who is grateful to him, Marduk </p>\n<p>2. b. Musa, may his resting place be Eden.</p>",
          "format": "text/html"
        }
      ],
