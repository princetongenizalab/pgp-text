      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "<ol>\n<li>My best regards to my lord the Rav; tell him</li>\n<li>of my yearning for him. Likewise, to my lord the elder Ab\u016b Zikr\u012b.&nbsp; Tell him</li>\n<li>the story of the ship. I hope it is correct. Peace.</li>\n</ol>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
    },
