        "source": {
          "id": "https://figgy.princeton.edu/concern/scanned_resources/6aab2198-1ec0-4490-a783-71099c2fc860/manifest/canvas/fc8491f2-6edd-4ba3-a9fb-c0dcf1c52eca",
          "type": "Canvas",
