          "type": "TextualBody",
          "label": "Right Margin",
          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\n \u0648\u0627\u0646 \u0643\u0627\u0646 \u0645\u0646 \u062a\u0641\u0636\u0644\u0647 \u0641\u064a \u0642\u0644\u064a\u0644 \u0645\u0627 \u0648\u0631\u062f \u0631\u0641\u064a\u0639\u00a0\n</li>\n<li dir=\"rtl\">\n]\u0628\u0627\u064a \u0633\u0639\u0631 \u0627\u0646 \u0643\u0627\u0646 \u0648\u0644\u0648 \u0643\u0627\u0646 \u062e\u0645\u0633\u0629 \u0627\u0631\u0637\u0627\u0644\n</li>\n<li dir=\"rtl\">\n\u0628\u0646\u0635\u0641 \u062f\u064a\u0646\u0627\u0631\u00a0 \u0648\u0644\u0627 \u0639\u062f\u0645\u062a\u0647\u0627 \u0648\u0644\u0627 \u062e\u0644\u0648\u062a\n</li>\n<li dir=\"rtl\">\n\u0645\u0646\u0647\u0627 \u0648\u062c\u0645\u064a\u0639 \u0630\u0644\u0643 \u0628\u0633\u0628\u0628 \u0627\u0644\u0627\u062f\u0644\u0627\u0644\u00a0\n</li>\n<li dir=\"rtl\">\n\u0639\u0644\u0649 \u0627\u0646\u0639\u0627\u0645\u0647\u0627\n</li></ol>\n",
