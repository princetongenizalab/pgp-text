      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\u0648\u0635\u0644 \u0643\u062a\u0627\u0628 [\u0645\u0648\u0644\u0627\u064a \u0627\u0644\u0634\u064a\u062e . . . \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647]</li>\n<li dir=\"rtl\">\u0648\u0627\u062f\u0627\u0645 \u0639\u0632\u0647 \u0648\u0646\u0639\u0645\u0627\u0647 \u0648\u0645\u0646 \u062d\u0633\u0646 [\u062a\u0648\u0641\u064a\u0642\u0647 \u0644\u0627 \u0627\u062e\u0644\u0627\u0647 . . . \u0648\u0643\u0627\u0646 \u0644\u0647]</li>\n<li dir=\"rtl\">\u00a0\u0648\u0644\u064a\u0627 \u0648\u062d\u0627\u0641\u0638\u0627 \u0641\u064a \u062c\u0645\u064a\u0639 \u0627\u0645\u0648\u0631\u0643 \u0648\u0627\u0646\u0627 \u0645\u0647\u0646\u064a [\u0644\u0647 \u0628\u0647\u0630\u0647 \u0627\u0644\u0627\u0639\u064a\u0627\u062f]</li>\n<li dir=\"rtl\">\u0627\u0644\u0645\u0628\u0627\u0631\u0643\u0629 \u0627\u0644\u0644\u0647 \u064a\u0639\u064a\u062f\u0647\u0627 \u0639\u0644\u064a\u0647 \u0633\u0646\u064a\u0646 \u0628\u0643\u062b\u0631\u0629[\u00a0 ]\u0639\u0644\u064a\u0647\u0627[</li>\n<li dir=\"rtl\">\u0648\u064a\u062c\u0645\u0639 \u0627\u0644\u0634\u0645\u0644 \u0628\u0647 \u0639\u0644\u0649 \u0627\u0641\u0636\u0644 \u062d\u0627\u0644 \u0628\u0645\u0646\u0647 \u0648\u062e\u0641\u064a \u0644\u0637\u0641\u0647 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647\u00a0</li>\n<li dir=\"rtl\">\u0648\u0627\u0644\u0630\u064a \u064a\u0631\u064a\u062f \u0639\u0644\u0645\u0647 \u0627\u0646\u0646\u064a \u062a\u0642\u0635\u064a\u062a \u0639\u0646 \u0645\u0627 \u0627\u0645\u0631\u062a \u0628\u0647 \u0648\u0647\u0648 \u0627\u062e\u0628\u0627\u0631 \u0627\u0644\u063a\u0631[\u0628</li>\n<li dir=\"rtl\">\u0627\u0645\u0627 \u0627\u0644\u0645\u0647\u062f\u064a\u0629 \u0641\u0627\u0646\u0647\u0627 \u0639\u0644\u0649 \u062d\u0627\u0644 \u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0648\u0627\u062d\u0643\u0627 \u0627\u0646 \u062e\u0644\u0641\u0647 \u0645\u0631\u0643\u0628\u064a\u0646</li>\n<li dir=\"rtl\">\u0627\u0646 \u0627\u062e\u0631\u0647 \u0645\u0631\u0643\u0628 \u0644\u0635\u0627\u062d\u0628 \u0627\u0644\u0645\u0647\u062f\u064a\u0629 \u0648\u0645\u0631\u0643\u0628 \u0644\u0644\u0631\u0648\u0645 \u0648\u0627\u062e\u0628\u0631\u0648\u0627</li>\n<li dir=\"rtl\">\u0627\u0646 \u0627\u0633\u0639\u0627\u0631\u0647\u0627 \u0627\u0633\u0639\u0627\u0631 \u0627\u0644\u0635\u0642\u0637 \u0648\u0630\u0644\u0643 \u0627\u0633\u0639\u0627\u0631 \u062c\u064a\u062f\u0629 \u0645\u0631\u0628\u062d\u0629</li>\n<li dir=\"rtl\">\u00a0\u062e\u0644\u0627\u0641 \u0627\u0644\u0645\u0631\u064a\u0629 \u0648\u0627\u0645\u0627 \u0627\u0637\u0631\u0627\u0628\u0644\u0633 \u0628\u0639\u062f [ ]\u0627\u062e\u0628\u0631 \u0639\u0646\u0647\u0627 \u0627\u0644\u062e\u0628\u0631 \u0627\u0644\u0630\u064a\u00a0</li>\n<li dir=\"rtl\">\u00a0\u0644\u0645 \u064a\u062e\u0641\u0627 \u0639\u0646 \u0627\u062d\u062f \u0648\u0627\u062e\u0630 \u0627\u0646\u0633\u0627\u0646 \u0645\u0633\u0644\u0645 \u0645\u062d\u0642\u0642 \u0648\u0627\u062d\u0643\u0627 \u0627\u062e\u0628\u0627\u0631 \u0627\u0646\u00a0</li>\n<li dir=\"rtl\">\u00a0\u062a\u064a\u0633\u0631 \u0648\u0627\u0646\u0647\u0627 \u0639\u0627\u062f\u062a \u0644\u0644\u0645\u0633\u0644\u0645\u064a\u0646 \u0648\u0646\u0631\u062c\u0648 \u0627\u0646 \u064a\u0643\u0648\u0646 \u0630\u0644\u0643 \u0645\u0646 \u0627\u0644\u0644\u0647 \u0635\u062d\u064a\u062d</li>\n<li dir=\"rtl\">\u00a0\u0648\u0643\u0627\u0646 \u0639\u0628\u062f\u0647\u0627 \u0642\u062f \u0627\u0646\u0641\u0630 \u0639\u0644\u0649 \u064a\u062f \u0627\u0628\u0648 \u0627\u0644\u062d\u0633\u0646 \u0648\u0627\u0646\u0627 \u0627\u0633\u0627\u0644 \u062a\u0641\u0636\u0644\u0647\u0627 \u0628\u0627\u0646</li>\n<li dir=\"rtl\">\u00a0\u064a\u0646\u0641\u0630 \u0644\u064a \u062d\u0648\u0627\u064a\u062c \u0645\u0646 \u062c\u0645\u0644\u062a\u0647\u0627 \u0642\u0644\u064a\u0644 \u0628\u0642\u0645 \u0628\u0627\u064a \u0633\u0639\u0631 \u0627\u0646 \u0643\u0627\u0646 \u0637\u064a\u0628 \u0641\u0627\u0646</li>\n<li dir=\"rtl\">\u00a0\u0633\u0647\u0644 \u0627\u0646\u0641\u0627\u0630 \u0634\u064a \u0639\u0644\u0649 \u064a\u062f\u0647 \u0648\u0627\u0644\u0627 \u0627\u0646\u0641\u0630 \u0644\u064a \u0628\u062f\u064a\u0646\u0627\u0631 \u0633\u0631\u0639\u0629 \u0641\u0627\u0646\u064a \u0628\u0637\u0627\u0644\u00a0</li>\n<li dir=\"rtl\">\u00a0\u0645\u0646\u0647 \u062d\u0636\u0631\u062a\u0647 \u0645\u062e\u0635\u0648\u0635\u0629 \u0628\u0627\u062a\u0645 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u0644\u0634\u064a\u062e \u0627\u0628\u0648 \u0639\u0644\u0649 \u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0627\u0648\u0644\u0627\u062f\u0647</li>\n<li dir=\"rtl\">\u00a0\u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0645\u0648\u0644\u0627\u064a \u0627\u0644\u0634\u064a\u062e \u0627\u0644\u0631\u0627\u064a\u0633 \u0627\u0641\u0636\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0645\u0646 \u062a\u062d\u0648\u0637\u0647 \u0639\u0646\u0627\u064a\u062a\u0647 \u0633\u0644\u0627\u0645</li></ol>\n",
          "format": "text/html"
        }
