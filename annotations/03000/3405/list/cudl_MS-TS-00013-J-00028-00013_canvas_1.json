      "body": [
        {
          "type": "TextualBody",
          "label": "right margin, in another hand",
          "value": "<p>[. . .] the <i>h(aver)</i> R. Yosef b. Shemu\u02beel <i>(of) b(lessed) m(emory)</i>,<i> who stands in the breach</i> presented himself before the most illustrious Am\u012br, th[e] Am\u012br\u00a0[Sayf] al-D\u012bn [. . .] they redeemed the items held in partnership [. . .] Go[d . . .] victory and may He make your habitations prosper [. . .] and sustain you [. . .] and pure intention [. . .] which he did, shall do.</p>\n<p></p>",
          "format": "text/html"
        }
