      "body": [
        {
          "type": "TextualBody",
          "label": "Upper margin",
          "value": "<ol>\n<li><span lang=\"he\">\u05d5\u05d9\u05d0\u05db\u05d9 \u05d0\u05df \u05d3\u05db\u05dc\u05ea&nbsp;</span></li>\n<li><span lang=\"he\">\u05de\u05d5\u05dc\u05d0\u05ea \u05d5\u05db\u05d0\u05df \u05dc\u05d4\u05d0 \u05e2\u05e8\u05e1&nbsp;</span></li>\n<li><span lang=\"he\">\u05e9\u05e0\u05d9\u05e2 \u05d5\u05e7\u05e8 \u05e8\u05e7\u05e4\u05e0\u05d0&nbsp;</span></li>\n<li><span lang=\"he\">\u05e2\u05dc\u05d9 \u05db\u05dc \u05de\u05d0 \u05db\u05e0\u05ea</span></li>\n<li><span lang=\"he\">\u05ea\u05e6\u05e4\u05d4 \u05de\u05df \u05d0\u05dc</span></li>\n<li><span lang=\"he\">\u05d2\u05de\u05d9\u05dc \u05e2\u05df \u05d0\u05d1\u05d9</span></li>\n<li><span lang=\"he\">\u05d0\u05d1\u05e8\u05d4\u05d9\u05dd \u05d0\u05e1\u05d7\u05e7</span></li>\n<li><span lang=\"he\">\u05d0\u05d7\u05d9\u05d0\u05d4 \u05d0[\u05dc\u05dc\u05d4]&nbsp;</span></li>\n<li><span lang=\"he\">\u05d0\u05dc\u05dc\u05d4 \u05d9\u05e9\u05d7\u05e8\u05da</span></li>\n<li><span lang=\"he\">&nbsp;\u05dc\u05de\u05d5\u05dc\u05d0\u05ea \u05d5\u05e0\u05d2\u05d9\u05d4</span></li>\n<li><span lang=\"he\">&nbsp;\u05db\u05d9\u05e8&nbsp;</span></li>\n<li><span lang=\"he\">&nbsp;[ &nbsp; &nbsp; Arabic &nbsp; &nbsp; ]</span></li>\n</ol>",
