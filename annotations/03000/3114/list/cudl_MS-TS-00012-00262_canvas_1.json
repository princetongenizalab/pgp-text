    {
      "etag": "\"3e8db7a6f6cf4ca41d3e93e86d1d1321\"",
      "id": "https://geniza.princeton.edu/annotations/d66ca07f-2d75-4e16-a8f7-b1a582a21f9a/",
      "type": "Annotation",
      "created": "2026-08-04T13:45:36.190270+00:00",
