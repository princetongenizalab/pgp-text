      "body": [
        {
          "type": "TextualBody",
          "label": "\u05e9\u05d5\u05dc\u05d9\u05d9\u05dd:",
          "value": "<p><span lang=\"he\">\u05d0\u05d7\u05d9, \u05de\u05d5\u05dc\u05d0\u05ea \u05e0\u05d9\u05e9\u05d0\u05d4, \u05d5\u05d4\u05d9\u05ea\u05d4 \u05dc\u05d4 \u05d7\u05ea\u05d5\u05e0\u05d4 \u05e0\u05d4\u05d3\u05e8\u05ea. \u05e7\u05e8\u05d0\u05e0\u05d5 \u05d0\u05ea \u05db\u05dc \u05d4\u05d8\u05d5\u05d1 \u05e9\u05ea\u05d9\u05d0\u05e8\u05ea \u05e2\u05dc \u05d0\u05d1\u05d5 \u05d0\u05d1\u05e8\u05d4\u05d9\u05dd \u05d0\u05e1\u05d7\u05e7. \u05d9\u05d9\u05ea\u05df \u05dc\u05d5 \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d7\u05d9\u05d9\u05dd; \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d9\u05e8\u05d0\u05d4 \u05dc\u05da \u05d8\u05d5\u05d1\u05d5\u05ea \u05d0\u05e6\u05dc \u05de\u05d5\u05dc\u05d0\u05ea \u05d5\u05d0\u05e6\u05dc \u05e0\u05d2\u05f3\u05d9\u05d4, \u05d1\u05e8\u05e6\u05d5\u05df \u05d4\u05d0\u05dc.</span></p>",
          "format": "text/html"
        }
      ],
