        "selector": {
          "type": "SvgSelector",
          "value": "<svg><polygon points=\"284.9981689453125,446.3005065917969 1038.5672607421875,564.8760375976562 1068.6827392578125,616.0982666015625 1210.2188720703125,466.2365417480469 1634.8271484375,499.5391540527344 1643.1527099609375,574.4700317382812 1751.38623046875,474.56219482421875 2076.086669921875,474.56219482421875 2026.1328125,4670.69091796875 136.20965576171875,4545.80615234375\"></polygon></svg>"
