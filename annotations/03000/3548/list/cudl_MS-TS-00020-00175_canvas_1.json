      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li><span lang=\"he\">...</span></li>\n<li><span lang=\"he\">\u05de\u05e2\u05e0\u05d3\u05d5 \u05d4\u05d7\u05e1\u05d9\u05d3 \u05d4\u05d7\u05e8\u05d3</span></li>\n<li><span lang=\"he\">\u05e2\u05dc \u05d3\u05d1\u05e8 \u05d4\u05d0\u05dc \u05d9\u05e8\u05d9\u05dd</span></li>\n<li><span lang=\"he\">\u05de\u05e2\u05dc\u05ea\u05d5 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05d9\u05e0\u05d4\u05d9 \u05d0\u05e0\u05d4 \u05e1\u05d8\u05e8\u05d4 \u05e4\u05d9&nbsp;</span></li>\n<li><span lang=\"he\">\u05d2\u05d0\u05d9\u05d4 \u05d0\u05dc\u05e2\u05d2\u05dc\u05d4 \u05e4\u05e1\u05d9\u05d9\u05d3\u05e0\u05d0</span></li>\n<li><span lang=\"he\">\u05d9\u05d3\u05d9\u05df \u05e2\u05d1\u05d3\u05d5 \u05dc\u05db\u05e3 \u05d6\u05db\u05d5\u05ea&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05d0\u05dc\u05d3\u05d9 \u05d5\u05d2\u05d1 \u05d0\u05e2\u05dc\u05d0\u05dd \u05e1\u05d9\u05d9\u05d3\u05e0\u05d0&nbsp;</span></li>\n<li><span lang=\"he\">\u05d1\u05d4 \u05d1\u05d0\u05df \u05d0\u05dc\u05e9\u05e8\u05d5\u05e2 \u05d5\u05e7\u05e2</span></li>\n<li><span lang=\"he\">\u05e4\u05d9 \u05e2\u05de\u05dc \u05d0\u05dc\u05de\u05db\u05d5\u05d5\u05e8\u05ea\u05d9\u05df</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05d0\u05dc\u05db\u05e8\u05d9\u05ea\u05d9\u05df \u05d5\u05d0\u05dc\u05de\u05db\u05d3\u05ea\u05d9\u05df</span></li>\n<li><span lang=\"he\">&nbsp;\u05d0\u05d5\u05e7\u05e3 \u05e8\u05d1\u05e0\u05d5 \u05d0\u05dc\u05e2\u05d6\u05e8 \u05d4\u05d3\u05d9\u05d9\u05df</span></li>\n<li><span lang=\"he\">&nbsp;\u05d4\u05e8\u05d1 \u05d0\u05de\u05e8\u05d4\u05dd \u05e2\u05dc\u05d9 \u05d0\u05d1\u05df</span></li>\n<li><span lang=\"he\">&nbsp;\u05e1\u05d9\u05d9\u05d3\u05e0\u05d0 \u05d5\u05d0\u05dc\u05d7\u05e6\u05e8 \u05d0\u05dc\u05d9 \u05d0\u05dc\u05d0\u05df</span></li>\n<li><span lang=\"he\">&nbsp;\u05de\u05d0 \u05d5\u05e7\u05e2 \u05e9\u05e8\u05d5\u05e2 \u05e4\u05d9\u05d4\u05dd</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05dc\u05d0 \u05e4\u05d9 \u05e2\u05de\u05dc \u05d0\u05dc\u05db\u05e8\u05e7\u05d4</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05db\u05d0\u05df \u05d0\u05dc\u05de\u05de\u05dc\u05d5\u05da \u05ea\u05e7\u05d3\u05dd</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05db\u05ea\u05d1 \u05dc\u05de\u05d5\u05dc\u05d0\u05e0\u05d0 \u05de\u05d8\u05d0\u05dc\u05e2\u05d0</span></li>\n<li><span lang=\"he\">&nbsp;\u05e9\u05d0\u05e4\u05d9\u05d4 \u05e4\u05d9 \u05d4\u05d3\u05d4 \u05d0\u05dc\u05d0\u05d2\u05e8\u05d0\u05e5</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05dc\u05dd \u05d9\u05e6\u05dc \u05dc\u05dc\u05de\u05de \u05d2\u05e8\u05d0\u05d1</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05d0\u05dc\u05de\u05de \u05de\u05d0 \u05d9\u05de\u05db\u05e0\u05d4 \u05d9\u05e2\u05de\u05dc</span></li>\n<li><span lang=\"he\">&nbsp;\u05e9\u05d9 \u05d1\u05e8\u05d0\u05d9\u05d4 \u05dc\u05d9\u05dc\u05d0 \u05d9\u05db\u05d8\u05d9\u05d4</span></li>\n<li><span lang=\"he\">&nbsp;\u05d2\u05d9\u05e8\u05d4 \u05d5\u05d0\u05dc\u05d0 \u05d0\u05dc\u05de\u05d4 \u05de\u05d0</span></li>\n<li><span lang=\"he\">&nbsp;\u05de\u05e0\u05d4 \u05e2\u05d0\u05e7\u05d4 \u05d5\u05e8\u05d0\u05d9 \u05d0\u05dc\u05de\u05de</span></li>\n<li><span lang=\"he\">&nbsp;\u05d0\u05df \u05d9\u05e1\u05d9\u05d9\u05e8 \u05e1\u05d9\u05d9\u05d3\u05e0\u05d0 \u05d5\u05e8\u05e7\u05d4</span></li>\n<li><span lang=\"he\">&nbsp;\u05dc\u05d8\u05d9\u05e4\u05d4 \u05dc\u05e8\u05e9\u05d9\u05d3 \u05d1\u05df \u05d4\u05e8\u05d1 (?)</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05d9\u05e8\u05d9\u05d7\u05d4 \u05e1\u05d9\u05d9\u05d3\u05e0\u05d0 \u05e4\u05d9\u05d4\u05d0</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05d9\u05dc\u05d6\u05de\u05d4 \u05d1\u05e2\u05de\u05dc \u05d0\u05dc\u05db\u05e8\u05e7\u05d4</span></li>\n<li><span lang=\"he\">&nbsp;\u05e4\u05d0\u05df \u05d0\u05dc\u05de\u05de \u05e9\u05e8\u05e2 \u05de\u05e2\u05d4</span></li>\n<li><span lang=\"he\">&nbsp;\u05e4\u05d9 \u05d3\u05dc\u05da \u05d5\u05e7\u05dc\u05ea \u05dc\u05d4 \u05de\u05d0</span></li>\n<li><span lang=\"he\">&nbsp;\u05d0\u05e2\u05ea\u05de\u05d0\u05d3 \u05e1\u05d9\u05d9\u05d3\u05e0\u05d0 \u05e8\u05d1\u05e0\u05d5&nbsp;</span></li>\n<li><span lang=\"he\">&nbsp;\u05e9\u05dc\u05de\u05d4 \u05d9\u05e8 \u05d4\u05d5 \u05e4\u05d9 \u05e2\u05de\u05dc</span></li>\n<li><span lang=\"he\">&nbsp;\u05d0\u05dc\u05db\u05e8\u05e7\u05d4 \u05d0\u05dc\u05d0 \u05e2\u05dc\u05d9\u05da \u05e4\u05d0\u05d3\u05df</span></li>\n<li><span lang=\"he\">&nbsp;\u05d5\u05d0\u05dc\u05dc\u05d4 \u05de\u05e2\u05e8\u05e3 \u05e1\u05d9\u05d9\u05d3\u05e0\u05d0</span></li>\n<li><span lang=\"he\">&nbsp;\u05d1\u05d0\u05dc\u05e9\u05db\u05e8 \u05d5\u05d0\u05dc\u05ea\u05e0\u05d0 \u05d5\u05e7\u05e6\u05d3\u05d4</span></li>\n<li><span lang=\"he\">&nbsp;\u05e4\u05d9 \u05d3\u05dc\u05da \u05d0\u05e7\u05ea\u05e6\u05d0 \u05d0\u05dc\u05e9\u05d2\u05dc</span></li></ol>\n\n<p>&nbsp;</p>",
