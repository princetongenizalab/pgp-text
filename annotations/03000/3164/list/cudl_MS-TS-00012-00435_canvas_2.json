      "body": [
        {
          "type": "TextualBody",
          "label": "Address",
          "value": "<p>To my lord, succor, and support, my father, Japheth ha-Levi b. 'Ullah (may he) r(est in) E(den).</p>\n<p>Forward, and you will be rewarded!</p>\n<p>[From] his son</p>\n<p>May he become his ransom.</p>",
          "format": "text/html"
        }
