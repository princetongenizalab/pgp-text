          "value": "<ol>\n<li><span lang=\"he\">\u05d1\u05db\u05dc \u05de\u05db\u05ea\u05d1 \u05e9\u05d1\u05d0 \u05de\u05de\u05e0\u05d5&nbsp;</span></li>\n<li><span lang=\"he\">\u05d4\u05d5\u05d0 \u05de\u05ea\u05dc\u05d5\u05e0\u05df \u05d5\u05d0\u05d5\u05de\u05e8:&nbsp;</span></li>\n<li><span lang=\"he\">\u05d0\u05d9\u05df \u05dc\u05d9 \u05db\u05e1\u05e3,&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05db\u05d9 \u05d0\u05d1\u05d9\u05d5&nbsp;</span></li>\n<li><span lang=\"he\">\u05dc\u05d0 \u05d4\u05e9\u05d0\u05d9\u05e8 \u05dc\u05d5 \u05e2\u05e1\u05e7.&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05d6\u05d4 \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d0\u05d5\u05de\u05e8:&nbsp;</span></li>\n<li><span lang=\"he\">\u05e7\u05e0\u05d9\u05ea\u05d9&nbsp;</span></li>\n<li><span lang=\"he\">\u05dc\u05db\u05dd \u05de\u05ea\u05e0\u05d5\u05ea,&nbsp;</span></li>\n<li><span lang=\"he\">\u05db\u05de\u05d4 \u05e9\u05d4\u05d5\u05d0 \u05de\u05e2\u05e0\u05d9\u05e7 \u05dc\u05e0\u05d5,&nbsp;</span></li>\n<li><span lang=\"he\">\u05d0\u05d1\u05dc \u05d0\u05d9\u05e0\u05e0\u05d5 \u05e8\u05d5\u05d0\u05d9\u05dd \u05db\u05dc\u05d5\u05dd;&nbsp;</span></li>\n<li><span lang=\"he\">\u05de\u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d0\u05d1\u05e7\u05e9&nbsp;</span></li>\n<li><span lang=\"he\">\u05e9\u05d9\u05d9\u05d8\u05d9\u05d1 \u05e2\u05de\u05d5. \u05d0\u05e9\u05ea&nbsp;</span></li>\n<li><span lang=\"he\">\u05d1\u05e8\u05d4\u05d5\u05df \u05e9\u05d5\u05d0\u05dc\u05ea&nbsp;</span></li>\n<li><span lang=\"he\">\u05d0\u05d5\u05ea\u05da \u05e2\u05dc \u05e6\u05d0\u05dc\u05d7,&nbsp;</span></li>\n<li><span lang=\"he\">\u05d0\u05dd \u05e0\u05e9\u05d0</span></li>\n</ol>",
