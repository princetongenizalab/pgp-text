      "body": [
        {
          "type": "TextualBody",
          "label": "verso, other",
          "value": "<p><span lang=\"he\">(\u05de\u05d5\u05d1\u05d9\u05dc\u05d9 \u05d4\u05de\u05db\u05ea\u05d1:) \u05d0\u05dc\u05d7\u05d8\u05df \u05d1\u05df \u05d0\u05d1\u05e8\u05d4\u05d9\u05dd \u05d5\u05d1\u05e0\u05d5; \u05dc\u05d0\u05b7\u05e1\u05d3 \u05d0\u05d1\u05df \u05de\u05d7\u05de\u05d3 \u05d1\u05df \u05d0\u05d1\u05d9 \u05e2\u05d1\u05d0\u05d3. \u05e7\u05d7 \u05de\u05de\u05e0\u05d5 \u05d0\u05ea \u05ea\u05e9\u05d5\u05d1\u05ea\u05d5 \u05d1\u05de\u05d4\u05e8\u05d4, \u05d1\u05e8\u05e6\u05d5\u05df \u05d4\u05d0\u05dc. </span></p>",
          "format": "text/html"
        }
