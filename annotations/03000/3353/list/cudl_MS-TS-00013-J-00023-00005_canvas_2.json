      "body": [
        {
          "type": "TextualBody",
          "label": "Bottom margin, parallel lines written upside down. Address.\nArabic:",
          "value": "<p>\u0644\u0633\u064a\u062f\u064a \u0648\u0645\u0648\u0644\u0627\u064a \u0627\u0628\u0648 \u0645\u0646\u0635\u0648\u0631 \u062f\u0648\u0633\u0627 \u0628\u0646 \u064a\u0647\u0648\u0634\u0648\u0639 \u0627\u0644\u062d\u0627\u0628\u0627\u0631</p>\n<p>\u0627\u0644\u0644\u0627\u062f\u0642\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647 \u0648\u0627\u062f\u0627\u0645 \u0639\u0632\u0647 \u0648\u062a\u0627\u064a\u062f\u0647</p>\n<p>&nbsp;</p>\n<p>\u0645\u0646 \u0633\u0647\u0644 \u0628\u0646 \u062d\u0627\u062a\u0645 \u0628\u0645\u0635\u0631</p>\n<p>\u0642\u0635\u0631 \u0627\u0644\u0634\u0645\u0639 \u062f\u0631\u0628 \u0645\u0643\u064a\u0646 \u064a\u0635\u0644 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648\u062c\u0644</p>\n<p>&nbsp;</p>\n<p>\u0644\u0635\u0627\u062d\u0628 \u0627\u0644\u062d\u0628\u0631 (\u061f) \u0639\u0644\u064a \u0627\u0644\u062d\u0644\u0628\u064a</p>\n<p>&nbsp;</p>\n<p>\u0627\u0644\u062d\u0633\u0646 \u0628\u0646 \u0627\u0628\u0631\u0647\u064a\u0645 \u0648\u0641\u062a\u0627\u0647</p>\n<p>\u0644\u0644[\u0631\u0633]\u0644 \u0627\u0628\u064a \u0645\u062d\u0645\u062f \u0628\u0646 \u0627\u0628\u064a \u0639\u064a\u0627\u062f</p>\n<p>\u062a\u0627\u062e\u062f \u062c\u0648\u0627\u0628\u0647 \u0633\u0631\u0639\u0629 \u0627\u0646 \u0634\u0627\u0621 \u0627\u0644\u0644\u0647</p>\n<p>&nbsp;</p>",
