          "value": "xywh=pixel:441.73443603515625,1479.296630859375,4643.348083496094,780.739990234375",
          "conformsTo": "http://www.w3.org/TR/media-frags/"
        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "verso, address",
          "value": "<p><span lang=\"he\">\u05dc\u05d0\u05d3\u05d5\u05e0\u05d9 \u05d5\u05e8\u05d1\u05d9 \u05d0\u05d1\u05d5 \u05de\u05e0\u05e6\u05d5\u05e8 \u05d3\u05d5\u05e1\u05d0 \u05d1\u05df \u05d9\u05d4\u05d5\u05e9\u05e2 \u05d4\u05d7\u05d1\u05e8 \u05d4\u05dc\u05d0\u05d3'\u05e7\u05d9, \u05d9\u05d9\u05ea\u05df \u05dc\u05d5 \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd \u05d0\u05e8\u05d9\u05db\u05d5\u05ea \u05d9\u05de\u05d9\u05dd \u05d5\u05d9\u05ea\u05de\u05d9\u05d3 \u05d0\u05ea \u05d2\u05d3\u05d5\u05dc\u05ea\u05d5 \u05d5\u05d0\u05ea \u05e2\u05d6\u05e8\u05ea\u05d5 \u05dc\u05d5. \u05de\u05e1\u05d4\u05dc \u05d1\u05df \u05d7\u05d0\u05ea\u05dd; \u05dc\u05e4\u05e1\u05d8\u05d0\u05d8, \u05e7\u05e6\u05e8 \u05d0\u05dc\u05e9\u05de\u05e2, \u05e1\u05de\u05d8\u05ea \u05de\u05db\u05d9\u05df: \u05d9\u05d2\u05d9\u05e2, \u05d1\u05e8\u05e6\u05d5\u05df \u05d4\u05d0\u05dc \u05d9\u05ea\u05d2\u05d3\u05dc \u05d5\u05d9\u05e9\u05ea\u05d1\u05d7. \u05dc\u05e9\u05d5\u05ea\u05e4\u05d5 \u05e9\u05dc \u05d4\u05d7\u05d1\u05e8(?) \u05e2\u05dc\u05d9 \u05d0\u05dc\u05d7\u05dc\u05d1\u05d9</span></p>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 2
    },
    {
      "etag": "\"f80036d1595f9d7d129374e56ee2a788\"",
      "id": "https://geniza.princeton.edu/annotations/2782d733-aa5d-4013-830b-88d482ea1d69/",
      "type": "Annotation",
      "created": "2026-08-04T13:55:06.032849+00:00",
      "modified": "2026-08-04T13:55:06.032856+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/1542/",
      "target": {
        "source": {
