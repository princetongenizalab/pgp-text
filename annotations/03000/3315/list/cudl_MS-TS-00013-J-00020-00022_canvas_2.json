      "body": [
        {
          "type": "TextualBody",
          "label": "Verso (address)",
          "value": "<p>To my lord and brother Abu al-Hasan</p>\n<p>&lsquo;Ali b. Hillel, the Baghdadi</p>\n<p>Hazan of blessed memory.</p>\n<p>May God prolong his life and perpetuate his grace.</p>\n<p>From his sister, may she Be his redemption. Steadfast faithfulness.</p>\n<p>&nbsp;</p>",
          "format": "text/html"
        }
