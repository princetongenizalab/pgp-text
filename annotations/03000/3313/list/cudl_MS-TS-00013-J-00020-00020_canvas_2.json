      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, main text",
          "value": "\n<ol><li>Umm \u02bfImr\u0101n, may I not be deprived of her favor,</li>\n<li>and to all those who are in Qaly\u016bb. (We) have saved</li>\n<li>the girl for Abu \u02bel-\u02bfAl\u0101\u02be. If he is coming, have him send a message and</li>\n<li>inform us. If not, don't let him detain her. <i>And Peace</i>. She is not</li>\n<li>a poor girl. She is \"concealed.\" <i>And Peace</i>.&nbsp;</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
