      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, other",
          "value": "\n<ol><li>\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645</li>\n<li>\u0642\u0628\u0636\u062a \u0645\u0646 \u0627\u0644\u0634\u064a\u062e \u0623\u0628\u0648 \u0627\u0644\u0639\u0644\u0627 \u064a\u0648\u0633\u0641 \u0628\u0646 \u062f\u0627\u0648\u062f \u0628\u0646 \u0634\u0639\u064a\u0627 \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0639\u0632\u0647 \u0645\u0627 \u064a\u0635\u064a\u0631 \u0630\u0643\u0631</li>\n<li>\u0645\u0628\u0644\u063a\u0647 \u0647\u0630\u0647 \u0627\u0644\u0633\u0641\u062a\u062c\u0647 \u0648\u0647\u0648 \u0645\u0646 \u0627\u0644\u0639\u064a\u0646 \u062e\u0645\u0633\u0629 \u0648\u0639\u0634\u0631\u064a\u0646 \u062f\u064a\u0646\u0627\u0631 \u0648\u0642\u064a\u0631\u0627\u0637\u064a\u0646</li>\n<li>\u0627\u0644\u0646\u0635\u0641 \u0645\u0646 \u0630\u0644\u0643 \u0627\u062b\u0646\u0627 \u0639\u0634\u0631 \u062f\u064a\u0646\u0627\u0631\u0627 \u0648\u0646\u0635\u0641 \u0648\u0642\u064a\u0631\u0627\u0637 \u0648\u0627\u0628\u0631\u064a\u062a\u0647 \u0645\u0646 \u0630\u0644\u0643</li>\n<li>[ ] \u0647\u0630\u0647 \u064a\u0648\u0645 \u0627\u0644\u0627\u062d\u062f \u0644\u0639\u0634\u0631 \u062e\u0644\u062a</li>\n<li>\u0645\u0646 \u0630\u064a \u0627\u0644\u062d\u062c\u0629 \u0633\u0646\u0629 \u0633\u062a\u0629 \u0648\u0623\u0631\u0628\u0639\u064a\u0646 \u0648\u0627\u0631\u0628\u0639 \u0645\u0627\u064a\u0629 \u0648\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0648\u062d\u062f\u0647</li></ol>\n",
