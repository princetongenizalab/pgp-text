      "body": [
        {
          "type": "TextualBody",
          "label": "verso",
          "value": "<ol>\n<li><span lang=\"he\">&hellip;\u05e9\u05e0\u05d9 \u05de\u05e0\u05d9\u05dd&hellip;&nbsp;</span></li>\n<li><span lang=\"he\">\u05d1\u05e2\u05d3 \u05d4\u05e9\u05de\u05df(?), \u05e9\u05d9 \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd.&nbsp;</span></li>\n<li><span lang=\"he\">\u05e1\u05da \u05d4\u05db\u05d5\u05dc: \u05ea\u05db\"\u05d1 \u05d3\u05d9\u05e0\u05e8 \u05e4\u05d7\u05d5\u05ea \u05e9\u05d9\u05e9\u05d9\u05ea.&nbsp;</span></li>\n<li><span lang=\"he\">\u05d4\u05d9\u05ea\u05e8\u05d4 \u05dc\u05d6\u05db\u05d5\u05ea\u05d5: \u05e0\"\u05d2 \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd \u05e4\u05d7\u05d5\u05ea \u05e7\u05d9\u05e8\u05d0\u05d8.&nbsp;</span></li>\n<li><span lang=\"he\">\u05e4\u05e8\u05d4\u05d0\u05e1: \u05d4' \u05e4\u05d7\u05d5\u05ea \u05e9\u05d9\u05e9\u05d9\u05ea. \u05d0\u05d3\u05e8\u05d9\u05e1: \u05e9\u05e0\u05d9 \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd.&nbsp;</span></li>\n<li><span lang=\"he\">\u05d4\u05d9\u05ea\u05e8\u05d4 \u05dc\u05d6\u05db\u05d5\u05ea\u05d5: \u05e0\"\u05d0 \u05e4\u05d7\u05d5\u05ea \u05e7\u05d9\u05e8\u05d0\u05d8.&nbsp;</span></li>\n<li><span lang=\"he\">\u05e0\u05ea\u05e7\u05d1\u05dc \u05d1\u05e4\u05e1\u05d8\u05d0\u05d8: \u05d9\"\u05d3 \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd \u05d5\u05d7\u05e6\u05d9; \u05d9\u05ea\u05e8\u05ea \u05d4\u05d4\u05d5\u05e6\u05d0\u05d5\u05ea: \u05d7\u05e6\u05d9 \u05d5\u05e9\u05de\u05d9\u05e0\u05d9\u05ea \u05d3\u05d9\u05e0\u05e8 \u05e4\u05d7\u05d5\u05ea \u05d7\u05b7\u05d1\u05bc\u05d4;&nbsp;</span></li>\n<li><span lang=\"he\">\u05d4\u05d9\u05ea\u05e8\u05d4 \u05dc\u05d6\u05db\u05d5\u05ea\u05d5: \u05dc\"\u05d6 \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd \u05e4\u05d7\u05d5\u05ea \u05e9\u05d9\u05e9\u05d9\u05ea \u05e4\u05d7\u05d5\u05ea \u05d7\u05d1\u05d4.</span></li>\n<li><span lang=\"he\">\u05dc\u05d6\u05db\u05d5\u05ea\u05d5 \u05d1\u05e4\u05e1\u05d8\u05d0\u05d8 \u05db\u05d9\u05e1 \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd, \u05d5\u05dc\u05d6\u05db\u05d5\u05ea\u05d5 \u05e4\u05e7\u05d5\u05d3\u05ea \u05ea\u05e9\u05dc\u05d5\u05dd, \u05d2' \u05d5\u05e9\u05e0\u05d9 \u05e7\u05d9\u05e8\u05d0\u05d8\u05d9\u05dd,&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05dc\u05d6\u05db\u05d5\u05ea\u05d5 \u05de\u05df \u05d4\u05db\u05d9\u05e1: \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d7\u05e6\u05d9 \u05d5\u05e9\u05dc\u05d9\u05e9 \u05d5\u05d7\u05d1\u05d4. \u05e1\u05da \u05d4\u05db\u05d5\u05dc, \u05d8\"\u05d5 \u05d3\u05d9\u05e0\u05e8 \u05e4\u05d7\u05d5\u05ea \u05e7\u05d9\u05e8\u05d0\u05d8 \u05d5\u05d7\u05b7\u05db\u05b9\u05bc\u05d4.</span></li>\n<li><span lang=\"he\">\u05dc\u05d7\u05d5\u05d1\u05ea\u05d5 \u05dc'\u05d3\u05d0\u05e8 \u05d0\u05dc\u05db\u05ea\u05d0\u05df' \u05d1\u05e2\u05d3 \u05d4' \u05de\u05e9\u05d5\u05d0\u05d9\u05dd, \u05d9' \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd \u05d5\u05e9\u05de\u05d9\u05e0\u05d9\u05ea;&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05dc\u05d7\u05d5\u05d1\u05ea\u05d5 \u05dc'\u05d3\u05d0\u05e8 \u05de\u05d0\u05e0\u05db' \u05d1\u05e2\u05d3 \u05d2' \u05d1\u05b7\u05bc\u05e8\u05b0\u05e7\u05b7\u05dc\u05d5\u05bc,&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05b0\u05e8\u05b7\u05e9\u05d9\u05d3 \u05d5\u05de\u05db\u05ea\u05d0\u05e8\u05d4: \u05e9\u05e0\u05d9 \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd \u05d5\u05d7\u05e6\u05d9 \u05e7\u05d9\u05e8\u05d0\u05d8;&nbsp;</span></li>\n<li><span lang=\"he\">\u05dc\u05e4\u05e7\u05d9\u05d3\u05d9 \u05de\u05db\u05ea\u05d0\u05e8\u05d4: \u05d2' \u05d5\u05d7\u05e6\u05d9 \u05d5\u05e8\u05e7';&nbsp;</span></li>\n<li><span lang=\"he\">\u05ea\u05e9\u05e8, \u05d5' \u05d3\u05b0\u05e8\u05b8\u05d4\u05b7\u05de\u05d9\u05dd.</span></li>\n<li><span lang=\"he\">\u05e9\u05db\u05d9\u05e8\u05d5\u05ea \u05d0\u05d5\u05e0\u05d9\u05d9\u05d4 \u05dc\u05e8\u05e9\u05d9\u05d3, \u05e9\u05dc\u05d5\u05e9\u05ea \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05e4\u05d7\u05d5\u05ea \u05d7\u05d1\u05d4;&nbsp;</span></li>\n<li><span lang=\"he\">\u05d4\u05d5\u05d1\u05dc\u05d4 \u05d5\u05d0\u05d9\u05d2\u05e8\u05ea \u05de\u05e9\u05dc\u05d5\u05d7 \u05d5\u05e8\u05d1\u05e2 \u05e7\u05d9\u05e8\u05d0\u05d8; \u05e2\u05d5\u05d3 \u05d1\u05e2\u05d3\u05dd: \u05e9\u05e0\u05d9 \u05e7\u05d9\u05e8\u05d0\u05d8\u05d9\u05dd&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05d7\u05b7\u05db\u05b9\u05bc\u05d4; \u05d5\u05e7\u05e9\u05d9\u05e8\u05d4 \u05d5\u05de\u05e1\u05d9\u05e8\u05d4: \u05db\u05d9 \u05d3\u05b0\u05e8\u05b0\u05d4\u05b7\u05de\u05d9\u05dd.</span></li>\n<li><span lang=\"he\">\u05e9\u05db\u05d9\u05e8\u05d5\u05ea \u05d0\u05d5\u05e0\u05d9\u05d9\u05d4 \u05d1\u05d1\u05d5\u05e6\u05d9\u05e8 \u05d1\u05e9\u05d1\u05d9\u05dc \u05d4\u05d4': \u05e9\u05e0\u05d9 \u05e9\u05dc\u05d9\u05e9\u05d9\u05dd \u05e4\u05d7\u05d5\u05ea \u05d3\u05d0\u05e0\u05e7.&nbsp;</span></li>\n<li><span lang=\"he\">\u05e1\u05da \u05d4\u05db\u05d5\u05dc \u05d1\u05d6\u05d4\u05d1: \u05d9\"\u05d6 \u05d5\u05d7\u05e6\u05d9 \u05d5\u05e9\u05de\u05d9\u05e0\u05d9\u05ea;&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05b7\u05e8\u05b7\u05e7': .... \u05d5\u05d7\u05e6\u05d9, \u05e9\u05d4\u05dd \u05d1\u05d6\u05d4\u05d1 \u05db\u05d9 \u05e7\u05d9\u05e8\u05d0\u05d8\u05d9\u05dd \u05d5\u05d7\u05d1\u05d4.&nbsp;</span></li>\n<li><span lang=\"he\">\u05e1\u05da \u05d4\u05db\u05d5\u05dc \u05d6\u05d4\u05d1 \u05d5\u05d9\u05d5\u05e8\u05e7': \u05d9\"\u05d3 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05e9\u05dc\u05d9\u05e9 \u05d5\u05e9\u05de\u05d9\u05e0\u05d9\u05ea \u05d5\u05d7\u05b7\u05d1\u05bc\u05d4;&nbsp;</span></li>\n<li><span lang=\"he\">\u05d4\u05d9\u05ea\u05e8\u05d4 \u05dc\u05d6\u05db\u05d5\u05ea\u05d5: \u05e9\u05dc\u05d9\u05e9 \u05d5\u05e9\u05de\u05d9\u05e0\u05d9\u05ea. </span></li>\n</ol>",
          "format": "text/html"
        }
      ],
