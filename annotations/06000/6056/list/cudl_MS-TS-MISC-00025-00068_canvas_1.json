      "modified": "2026-08-20T21:17:57.411744+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/13/",
      "target": {
        "source": {
          "id": "http://cudl.lib.cam.ac.uk/iiif/MS-TS-MISC-00025-00068/canvas/1",
          "type": "Canvas",
