          "value": "<ol>\n<li><span lang=\"HE\">\u05d0\u05dc\u05d9 \u05d7\u05e6</span><span lang=\"HE\">\u05c4</span><span lang=\"HE\">\u05e8\u05d4 \u05de\u05d5\u05dc\u05d0\u05d9 \u05d0\u05dc\u05e9\u05d9\u05da \u05d0\u05dc</span><span lang=\"HE\">\u05d0\u05d2\u05dc \u05d0\u05dc\u05e1\u05d0\u05de\u05d9 \u05d0\u05dc\u05de\u05d7\u05dc &nbsp; &nbsp;\u05e9\u05d0\u05db\u05e8 \u05de\u05e0\u05e0\u05d4</span>&nbsp;</li>\n<li><span lang=\"HE\">\u05d0\u05d1\u05d5 \u05d6\u05db\u05e8\u05d9 \u05d4\u05db\u05d4\u05df \u05d1\u05d9\u05e8</span><span lang=\"HE\">\u05c4</span><span lang=\"HE\"> \u05d9\u05d5\u05e1\u05e3 \u05e9</span><span lang=\"HE\">\u05c4</span><span lang=\"HE\">\u05e6</span><span lang=\"HE\">\u05c4 &nbsp; &nbsp; &nbsp; \u05d0\u05d1\u05e8\u05d4\u05dd \u05d1\u05e8\u05c4 \u05d7\u05d1\u05d9\u05d1</span></li>\n<li><span lang=\"HE\">\u05d0\u05d8\u05d0\u05dc \u05d0\u05dc\u05dc\u05d4 \u05d1\u05e7\u05d0\u05d4\u05d0 \u05d5\u05d0\u05d3\u05d0\u05dd \u05e2\u05dc\u05d0\u05d4\u05d0 &nbsp; &nbsp; &nbsp;\u05d0\u05de\u05d5\u05e0\u05d4&nbsp;&nbsp;&nbsp; \u05d0\u05d5\u05de\u05df</span></li>\n</ol>",
