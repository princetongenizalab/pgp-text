      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, left side",
          "value": "\n<ol><li><span lang=\"he\">\u0633\u062a\u0629 \u0648\u062b\u0645\u0627\u0646\u064a\u0646</span></li>\n<li><span lang=\"he\">\u0648\u062b\u0644\u062b \u0648\u0631\u0628\u0639 \u0648\u062f\u0627\u0626\u0642</span></li>\n<li><span lang=\"he\">\u05d0\u05dc\u05d3\u05d9 \u05e6\u05e8\u05e3 \u05de\u05df \u05d0\u05dc\u05e2\u05d9\u05df</span></li>\n<li><span lang=\"he\">\u05d2' \u05d5\u05e2\u05e9\u05e8\u05d9\u05df \u05d3\u05d9'\u05e0'</span></li>\n<li><span lang=\"he\">\u05d5\u05e8\u05d1\u05e2 \u05d5\u05e1\u05d3\u05e1</span></li>\n<li><span lang=\"he\">\u05e7\u05d9\u05de\u05d4 \u05d0\u05dc\u05d5\u05e8\u05e7 \u05d6' \u05de\u05d0\u05d9\u05d4</span></li>\n<li><span lang=\"he\">\u05d5\u05d0\u05e8\u05d1\u05e2\u05d9\u05df \u05d3\u05e8\u05d4\u05dd</span></li>\n<li><span lang=\"he\">\u05e7\u05d1\u05e5'</span></li>\n<li><span lang=\"he\">\u05d1\u05d9\u05d3 \u05d0\u05d1\u05d5 \u05d9\u05e2\u05e7\u05d5\u05d1 \u05d1\u05df \u05d0\u05dc\u05e9\u05d0\u05de\u05d4</span></li>\n<li><span lang=\"he\">\u05d9'\u05d0' \u05d3\u05d9'\u05e0' \u05d5\u05d9'\u05d0' \u05e7\u05d9\u05e8\u05d0\u05d8</span></li>\n<li><span lang=\"he\">[[\u05de\u05d0 \u05e7\u05d1\u05e6\u05d4 \u05e4\u05e6'\u05dc \u05e9\u05d0\u05db\u05e8\u05d9\u05d4]]</span></li>\n<li><span lang=\"he\">[[\u05d7' \u05d3\u05d2\u05d0\u05e0\u05d9\u05e8]]</span></li>\n<li><span lang=\"he\">\u05de\u05d0 \u05d0\u05e9\u05ea\u05e8\u05d9 \u05d1\u05d4 \u05e9\u05d0\u05db\u05e8\u05d9\u05d4</span></li>\n<li><span lang=\"he\">\u05d6' \u05d3\u05e0\u05d0\u05e0\u05d9\u05e8 \u05d0\u05dc\u05d0 \u05ea\u05de\u05df \u05d5\u05d7\u05d1\u05d4</span></li>\n<li><span lang=\"he\">\u05ea\u05de\u05df \u05d3\u05e0\u05d0\u05e0\u05d9\u05e8 \u05d2\u05d5\u05d0\u05d6 \u05d3' \u05d3\u05e0\u05d0</span></li>\n<li><span lang=\"he\">\u05de\u05e2\u05d4\u05d0 \u05e0\u05e6\u05e3 \u05d3\u05d9'\u05e0' \u05d5\u05e8\u05e7</span></li>\n<li><span lang=\"he\">\u05d2' \u05e7\u05de\u05d7 \u05d3\u05d9\u05e0\u05d0\u05e8 \u05e0\u05d0\u05e7\u05e5 \u05d5\u05e8\u05d1\u05e2\u05d9</span></li>\n<li><span lang=\"he\">\u05e0\u05e6\u05e3 \u05d5\u05ea\u05de\u05df \u05d3\u05d9'\u05e0'</span></li></ol>\n",
