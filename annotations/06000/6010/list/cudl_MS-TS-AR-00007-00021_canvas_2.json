        {
          "type": "TextualBody",
          "label": "Verso, right side",
          "value": "\n<ol><li><span lang=\"he\">\u05d0\u05dc\u05d3\u05d9 \u05e7\u05d1\u05e5' \u05e4\u05e6'\u05dc \u05e0\u05e4\u05e7\u05d4</span></li>\n<li><span lang=\"he\">\u05d8'\u05d5' \u05d3\u05e8'\u05d4' \u05d5\u05d4' \u05e7\u05d3\u05d9\u05dd</span></li>\n<li><span lang=\"he\">\u05d5\u05e2\u05df \u05e0\u05e7\u05e5 \u05d0\u05dc\u05d3\u05e0\u05d0\u05e0\u05d9\u05e8</span></li>\n<li><span lang=\"he\">\u00a0\u00a0\u00a0\u00a0\u00a0\u05e1\u05d3\u05e1 \u05d0\u05dc\u05d0 \u05d7\u05d1\u05d4</span></li>\n<li><span lang=\"he\">\u05d1\u05e7\u05d0 \u05d0\u05dc\u05d7\u05e1\u05d0\u05d1 \u05d3\u05d9\u05e0\u05d0\u05e8 \u05d5\u05e0\u05e6\u05e3 \u05d5\u05e1\u05d3\u05e1</span></li>\n<li><span lang=\"he\">\u05d9\u05e0\u05d7\u05d8 \u05e2\u05df \u05d0\u05dc\u05e0\u05e7\u05e5 \u05e1\u05d3\u05e1 \u05d0\u05dc\u05d0 \u05d7\u05d1\u05d4</span></li>\n<li><span lang=\"he\">\u05d1\u05e7\u05d9 \u05d3\u05d9\u05e0\u05d0\u05e8 \u05d5\u05e0\u05e6\u05e3 \u05d5\u05d7\u05d1\u05d4</span></li>\n<li><span lang=\"he\">\u05ea\u05d2\u05d9 \u05d1\u05e7\u05d9\u05de\u05d4 \u05d5\u05e8\u05e7 \u05d0'\u05e0' \u05d5\u05e0\u05e6\u05e3</span></li>\n<li><span lang=\"he\">\u05d9\u05e0\u05d7\u05d8 \u05de\u05e0\u05d4\u05d0 \u05e2\u05e9\u05e8\u05d9\u05df \u05e0\u05e4\u05e7\u05d4</span></li>\n<li><span lang=\"he\">\u05d1\u05e7\u05d9 \u05d0'\u05dc' \u05d5\u05e0\u05e6\u05e3</span></li>\n<li><span lang=\"he\">\u05ea\u05de\u05df \u05e4\u05d5\u05dc \u05d7' \u05d3\u05e8'\u05d4'</span></li>\n<li><span lang=\"he\">\u05e7\u05de\u05d7 \u05d5\u05e0\u05e4\u05e7\u05d4 \u05d9' \u05d3'\u05e8'&gt; \u05d5\u05e0\u05e6\u05e3</span></li>\n<li><span lang=\"he\">\u05d1\u05e7\u05d9 \u05d2'\u05d9' \u05d3\u05e8\u05d4'</span></li></ol>\n",
