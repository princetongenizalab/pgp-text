      "dc:source": "https://geniza.princeton.edu/sources/20/",
      "target": {
        "source": {
          "id": "http://cudl.lib.cam.ac.uk/iiif/MS-TS-NS-00320-00013/canvas/1",
          "type": "Canvas",
          "partOf": {
