          "value": "\n<ol><li><span lang=\"he\">\u2026</span></li>\n<li><span lang=\"he\">\u2026</span></li>\n<li><span lang=\"he\">\u2026</span></li>\n<li><span lang=\"he\">\u2026</span></li>\n<li><span lang=\"he\">\u05dc\u05da</span></li>\n<li><span lang=\"he\">\u05dc\u05de\u05d5\u05dc\u05d0\u05d9</span></li>\n<li><span lang=\"he\">\u05d0\u05dc\u05e9\u05d9\u05da</span></li>\n<li><span lang=\"he\">\u05d0\u05d1\u05d9\u00a0</span></li>\n<li><span lang=\"he\">\u05d6\u05db\u05e8\u05d9\u05d0</span></li>\n<li><span lang=\"he\">\u00a0\u05d5\u05d0\u05df \u05db\u05d0\u05df</span></li>\n<li><span lang=\"he\">\u00a0\u05dc\u05de\u05d5\u05dc\u05d0\u05d9</span></li>\n<li><span lang=\"he\">\u00a0\u05d7\u05d0\u05d2\u05d4</span></li>\n<li><span lang=\"he\">\u00a0\u05d9\u05e9\u05e8\u05e4\u05e0\u05d9</span></li>\n<li><span lang=\"he\">\u00a0\u05d1\u05d4\u05d0 \u05d5\u05db\u05d5\u05e5</span></li>\n<li><span lang=\"he\">\u00a0\u05e0\u05e4\u05e1\u05da</span></li>\n<li><span lang=\"he\">\u00a0\u05d0\u05dc\u05e1\u05dc\u05dd</span></li></ol>\n",
