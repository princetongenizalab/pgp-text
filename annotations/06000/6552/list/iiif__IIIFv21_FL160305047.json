      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, address",
          "value": "<p>(To) my lord, the elder Abu \u2019l-Faraj Niss\u012bm, son of Solomon, (may he) r(est in) E(den)\u2014may God grant him permanent well-being and happiness\u2014Ruqq\u012b.</p>\n<p>(From) his \"son\" and prot\u00e9g\u00e9 Solomon, son of Abraham, ... Ruqq\u012b.</p>",
          "format": "text/html"
        }
