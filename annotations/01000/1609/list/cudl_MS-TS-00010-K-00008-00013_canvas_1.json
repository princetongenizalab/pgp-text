      "dc:source": "https://geniza.princeton.edu/sources/27/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00010-K-00008-00013/canvas/1",
          "type": "Canvas",
          "partOf": {
