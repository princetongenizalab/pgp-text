      "id": "https://geniza.princeton.edu/annotations/7332994e-e1a7-4623-9816-e6dec7f49e59/",
      "type": "Annotation",
      "created": "2026-08-03T18:55:44.466632+00:00",
      "modified": "2026-08-03T18:59:31.960628+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/1260/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00012-00338/canvas/1",
          "type": "Canvas",
          "partOf": {
