        {
          "type": "TextualBody",
          "label": "Recto, right margin",
          "value": "\n<ol><li><span lang=\"he\">\u05e7\u05dc\u05d1\u05d9\u00a0</span></li>\n<li><span lang=\"he\">\u05d5\u05ea\u05e9\u05e8\u05d7 \u05dc\u05d9</span></li>\n<li><span lang=\"he\">\u05d2\u05de\u05d9\u05e2 \u05d0\u05db\u05d1\u05d0\u05e8\u05da</span></li>\n<li><span lang=\"he\">\u05e1\u05d0\u05e2\u05d4 \u05d1\u05e1\u05d0\u05e2\u05d4</span></li>\n<li><span lang=\"he\">\u05e4\u05d9 \u05e6\u05d7\u05d4 \u05d2\u05e1\u05de\u05da</span></li>\n<li><span lang=\"he\">\u05d5\u05ea\u05d7\u05e8\u05e5 \u05e4\u05d9</span></li>\n<li><span lang=\"he\">\u05d8\u05dc\u05d5\u05e2\u05da \u05d5\u05dc\u05d0</span></li>\n<li><span lang=\"he\">\u05ea\u05d7\u05d5\u05d0\u05e0\u05d0 \u05e4[\u05d9]</span></li>\n<li><span lang=\"he\">\u05d9\u05d1 [ \u00a0 \u00a0 \u00a0 \u00a0 ]</span></li>\n<li><span lang=\"he\">\u00a0\u05e2\u05dc\u05d5\u05df [ \u00a0 \u00a0 \u00a0 ]</span></li>\n<li><span lang=\"he\">\u00a0\u05d4\u05e0\u05d0 \u05db\u05ea'\u05d9\u05e8</span></li>\n<li><span lang=\"he\">\u00a0\u05d5\u05d0\u05dc\u05de\u05e8\u05d9\u05e1\u05d9</span></li></ol>\n",
