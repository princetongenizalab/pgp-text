          "value": "<ol>\n<li><span lang=\"he\">\u05de\u05d0 \u05db\u05d0\u05df \u05de\u05e2\u05d9 \u05d0\u05e9\u05ea\u05e8\u05d9\u05ea</span></li>\n<li><span lang=\"he\">\u05d1\u05d4 \u05e7\u05de\u05d7 \u05d5\u05de\u05d0 \u05d7\u05e1\u05d1 \u05d0\u05dc\u05dc\u05d4 \u05dc\u05d9</span></li>\n<li><span lang=\"he\">\u05d0\u05df \u05d0\u05db\u05e8\u05d2 \u05e4\u05d9</span></li>\n<li><span lang=\"he\">\u05d0\u05dc\u05d0\u05d5\u05dc</span></li>\n<li><span lang=\"he\">\u05db\u05e8\u05d2\u05ea \u05e4\u05d9 \u05d0\u05dc</span></li>\n<li><span lang=\"he\">\u05d0\u05db\u05e8 \u05d0\u05dc\u05dc\u05d4</span></li>\n<li><span lang=\"he\">\u05d9\u05d2\u05e2\u05dc \u05d0\u05dc\u05e2\u05d0\u05e7\u05d1\u05d4</span></li>\n</ol>",
