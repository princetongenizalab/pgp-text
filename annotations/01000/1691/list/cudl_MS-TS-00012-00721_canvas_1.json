      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, right margin",
          "value": "\n<ol><li>I had with my I used to buy</li>\n<li>wheat. God did not want me</li>\n<li>to get out of this</li>\n<li>ahead.</li>\n<li>I got out at the</li>\n<li>bottom. May God</li>\n<li>bring (this)</li>\n<li>to a good&nbsp;conclusion.</li></ol>\n",
          "format": "text/html"
        }
