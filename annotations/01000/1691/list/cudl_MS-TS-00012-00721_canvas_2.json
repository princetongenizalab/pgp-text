      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, bottom region, upside down",
          "value": "<ol>\n<li><span lang=\"he\">\u05e1\u05d9\u05d9\u05d3\u05d9 \u05d5\u05de\u05d5\u05dc\u05d0\u05d9 \u05d0\u05d1\u05d5 \u05d9\u05d7\u05d9\u05d9&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u05de\u05d7\u05d1\u05d4 \u05e2\u05d5\u05d0\u05e5' \u05d1\u05df</span></li>\n<li><span lang=\"he\">\u05e0\u05d4\u05d5\u05e8\u05d0\u05d9 \u05d1\u05df \u05e0\u05e1\u05d9\u05dd \u05e0'\u05e2' &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \u05e8' \u05d7\u05e0\u05e0\u05d0\u05dc \u05e0'\u05e2'</span></li>\n<li><span lang=\"he\">\u05d0\u05d8\u05d0\u05dc \u05d0\u05dc\u05dc\u05d4 \u05d1\u05e7\u05d0\u05d4</span></li>\n</ol>",
