      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol dir=\"ltr\"><li>To be delivered to Ibr\u0101h\u012bm al-Nakhkh\u0101s (the slave dealer):</li>\n<li>I am writing so that he may buy for the Nezer</li>\n<li>the slave girl (wa\u1e63\u012bfa) and take her (and) d[eposit her]</li>\n<li>with whoever is convenient until you come downriver (to Fus\u1e6d\u0101\u1e6d?),</li>\n<li>(then) bring her with you. Whatever you spend</li>\n<li>on her for provisions, for hire of</li>\n<li>a boat, or anything else will be reimbursed</li>\n<li>to you. If anything is left over from her price,</li>\n<li>pay it from your own (funds), and take [her (?)]</li>\n<li>with you, and deposit [&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;]</li>\n<li>Y\u016bsuf, his associate [&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;]</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
