    {
      "etag": "\"cba3ec55272c2a3b38b25b301a81d3c5\"",
      "id": "https://geniza.princeton.edu/annotations/4de8bdaa-6975-4718-8690-693347ce7616/",
      "type": "Annotation",
      "created": "2026-09-08T21:20:01.137113+00:00",
      "modified": "2026-09-17T15:43:02.985452+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/135/",
      "target": {
        "source": {
          "id": "http://cudl.lib.cam.ac.uk/iiif/MS-TS-AS-00177-00175/canvas/1",
          "type": "Canvas",
          "partOf": {
