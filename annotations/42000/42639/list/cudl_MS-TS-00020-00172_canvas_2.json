      "body": [
        {
          "type": "TextualBody",
          "value": "\n<ol><li>[. . . . . . . . . . . . . . . . . . . . . . the emissary of the ruler of the land]</li>\n<li>of al-R\u016bm, may his triumph be glorious.&nbsp; &nbsp; &nbsp;Let our lord settle his business</li>\n<li>and conclude the affair with him in accordance with his noble promise</li>\n<li>and charge them with good faith in his dealings with them&mdash;before</li>\n<li>the arrival of the emissaries of our lord the sul\u1e6d\u0101n al-Malik al-\u02bf\u0100dil,</li>\n<li>may his triumph be glorious&mdash;and reassuring his heart. Let him (i.e., you) not give preference&nbsp;</li>\n<li>to anyone over them, and let our lord, may his triumph be glorious, not heed the speech</li>\n<li>of the one who advised him as he did and who reported to him the matter</li>\n<li>of the Georgians and the ruler of Arzan al-R\u016bm, for to him</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
