          "type": "TextualBody",
          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\n<p dir=\"rtl\">]\u062d\u0636\u0648\u0631 \u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0645\u0630\u0643\u0648\u064a\u0646 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0639\u0632\u0644(\u061f)</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">]\u0644\u063a\u0644\u0629 \u0627\u0644\u0645\u0639\u064a\u0646\u0629 \u0641\u064a\u0647 \u0648\u0647\u064a \u0645\u0627\u064a\u0629 \u0648\u062b\u0645\u0627\u0646\u064a\u0646 \u0631\u062b\u0644\u0627\u062b\u064a\u0646 \u0627\u0631\u062f\u0628\u0627</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">]\u0640\u0627 \u0648\u0627\u0644\u0630\u064a \u0627\u0635\u062f\u0642\u0648\u0647 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0639\u0627\u0644\u064a..\u0628\u0631\u0633\u0648\u0644\u0647(\u061f)</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">]\u0627\u0633\u062a\u0645\u0631\u0627\u0631(\u061f) \u0641\u064a \u0627\u0644\u0627\u0631\u0627\u0636\u064a \u0627\u0644\u0633\u0644\u0637\u0627\u0646\u064a\u0629 \u0627\u0631\u0628\u0639\u064a\u0646 \u0627\u0631\u062f\u0628\u0627</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">]......\u0627\u0644\u062d\u0644\u0629 \u0645\u0645\u0627 \u0647\u0648 \u0641\u064a \u062c\u0647\u0627\u062a\u0647\u0645 \u0648\u062a\u0635\u0648\u0631\u0648\u0627</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">]\u0641\u064a\u0647 \u0644\u0627\u062f\u062a\u0647\u0645 \u062b\u0645\u0646\u064a\u0629 \u0648\u062a\u0633\u0639\u064a\u0646 \u0627\u0631\u062f\u0628\u0627 \u0648\u0643\u062a\u0628</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">]\u062d\u0633\u0646 \u0628\u0646 \u2026\u2026\u2026</p>\n</li></ol>\n",
