      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, right margin, upside-down",
          "value": "\n<ol><li>And my dear father [\u00a0 \u00a0 ]</li>\n<li>\n<p>says, \u2018We will send the things, God, the exalted, willing.</p>\n</li>\n<li>\n<p>We haven\u2019t forgotten them.\u2019</p>\n</li>\n<li>\n<p>Greeting[s] to Sayyid Muh\u0323ammad and Sayyid \u02bfUmar [who are] over there. </p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
