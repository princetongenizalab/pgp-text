        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li>] \u0642\u064a \u0648\u0647\u0648 \u0632\u0648\u062c \u062d\u0645\u0644 \u0627\u0628\u0646\u0629 \u0646\u062d\u0631\u064a\u0631 \u0645\u0648\u0644\u0627 \u0633\u0639\u062f\u0627 \u0627\u0628\u0646\u0629 \u0627\u0644\u062d\u0633\u064a\u0646 \u0628\u0646 \u0645\u062d\u0645\u062f \u0627\u0644\u0639\u0644\u0648\u0646 \u0627\u0644\u0640[</li>\n<li>]......\u0627\u0642\u0631\u062a \u0627\u0646\u0647 \u0642\u0628\u0636 \u0644\u0632\u0648\u062c\u062a\u0647 \u062d\u0645\u0644 \u0627\u0644\u0645\u0633\u0645\u0627\u0629 \u0645\u0639\u0647 \u0641\u064a \u0638\u0647\u0631 \u0647\u0630\u0647 \u0627\u0644\u0631\u0642\u0639\u0629 [</li>\n<li>\u0627\u0644\u0645\u0640]\u0640\u0630\u0643\u0648\u0631 \u0645\u0628\u0644\u063a\u0647\u0627 \u0641\u064a \u0628\u0627\u0637\u0646 \u0647\u0630\u0647 \u0627\u0644\u0631\u0642\u0639\u0629 \u0627\u0644\u062a\u064a \u0642\u0628\u0636\u062a \u0645\u0646 \u0627\u0644\u0633\u0643\u0627\u0646 \u0627\u0644\u0645\u0633\u0645\u064a\u0646 \u0641\u064a[</li>\n<li>&nbsp;\u0627\u062d\u0640]\u0640\u062f \u0639\u0634\u0631 \u062f\u0631\u0647\u0645\u0627 \u0648\u0646\u0635\u0641 \u0648\u062e\u0631\u0648\u0628\u0629 \u0645\u0645\u0646 \u062c\u0631\u0649 \u0630\u0644\u0643 \u0639\u0644\u0649 \u064a\u062f\u064a\u0647 &hellip;..</li>\n<li>]\u0641\u064a \u0628\u0637\u0646 \u0647\u0630\u0647 \u0627\u0644\u0631\u0642\u0639\u0629 //\u0648\u0645\u0645\u0646 \u062c\u0631\u0649 \u0630\u0644\u0643 \u0639\u0644\u0649 \u064a\u062f\u064a\u0647// \u0645\u0646 \u062c\u0645\u064a\u0639 \u0630\u0644\u0643 \u0643\u0644\u0647 \u0628\u0631\u0627\u0629 \u0635\u062d\u064a\u062d\u0629 \u0648\u0636\u0645\u0646 \u0627\u0644\u062f\u0631\u0643 \u0641\u064a\u0647 \u0645\u0646[</li>\n<li>\u062b\u0640]\u0640\u0645\u0627\u0646 \u062e\u0644\u0648\u0646 \u0645\u0646 \u0634\u0647\u0631 \u0631\u0628\u064a\u0639 \u0627\u0644\u0627\u0648\u0644 \u0645\u0646 \u0633\u0646\u0629 \u0639\u0634\u0631 \u0648\u0627\u0631\u0628\u0639 \u0645\u0627\u064a\u0640[\u0640\u0629</li>\n<li>]\u0640\u0627\u0642 \u062d\u0631\u0648\u0641 \u0648\u0628\u064a\u0646 \u0648\u0645\u0646 \u062c\u0631\u0649 \u0630\u0644\u0643 \u0639\u0644\u0649 \u064a\u062f\u064a\u0647 \u0648\u0639\u0644\u0649 \u0630\u0644\u0643 \u0634\u0647\u062f \u0627\u0644\u0634\u0640[\u0640\u0647\u0648\u062f</li>\n<li>]\u0627\u0644\u0642\u0633\u0637\u0644\u064a \u0639\u0644\u0649 \u0627\u0642\u0631\u0627\u0631 \u0627\u0644\u0642\u0627\u0628\u0636 \u0648\u0636\u0645\u0627\u0646 \u0627\u0644\u062f\u0631\u0643</li></ol>\n",
