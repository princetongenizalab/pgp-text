          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li>\n<p>\u0634\u0639\u0628\u0627\u0646 \u0628\u0646 \u0639\u0628\u062f \u0627\u0644\u0644\u0647&nbsp; &nbsp; &nbsp; &nbsp; \u0627\u0628\u0648 \u0628\u0643\u0631 \u0627\u0644\u0643\u0631\u0645\u064a&nbsp;</p>\n</li>\n<li>\n<p>\u0645\u062d\u0645\u062f \u0628\u0646 \u0645\u062d\u0645\u062f \u0627\u0644\u062a\u0631\u0643\u0645\u0627\u0646\u064a</p>\n</li>\n<li>\n<p>\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0640[\u0640\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645]</p>\n</li>\n<li>\n<p>\u0635\u0644\u0648\u0627\u062a \u0627\u0644\u0644\u0647 \u0648\u0628\u0631\u0643\u0627\u062a\u0647 \u0648\u0646\u0648[\u0627\u0645\u064a \u0632\u0643\u0648\u0627\u062a\u0647 \u0648\u0627\u0641\u0636\u0644 \u0633\u0644\u0627\u0645\u062a\u0647 \u0648\u062a\u062d\u064a\u0627\u062a\u0647 \u0639\u0644\u0649 \u0645\u0648\u0644\u0627\u0646\u0627 \u0648\u0633\u064a\u062f\u0646\u0627]</p>\n</li>\n<li>\n<p>\u0627\u0644\u0627\u0645\u0627\u0645 \u0627\u0644\u0645\u0646\u0635\u0648\u0631 \u0627\u0644\u0627\u0645\u0640\u0640\u0640[\u0640\u0631 \u0628\u0627\u062d\u0643\u0627\u0645 \u0627\u0644\u0644\u0647 \u0627\u0645\u064a\u0631 \u0627\u0644\u0645\u0648\u0645\u0646\u064a\u0646 \u0648\u0639\u0644\u0649 \u0627\u0628\u0627\u0649\u0647 \u0627\u0644\u0637\u0627\u0647\u0631\u064a\u0646]</p>\n</li>\n<li>\n<p>\u0648\u0627\u0628\u0646\u0627 \u0627\u0644\u0627\u0626\u0645\u0629 \u0627\u0644\u0627\u0643\u0631\u0645\u064a\u0646 [\u0635\u0644\u0627\u0629 \u0628\u0627\u0642\u064a\u0629 \u0627\u0644\u0649 \u064a\u0648\u0645 \u0627\u0644\u062f\u064a\u0646&nbsp; \u0648\u0639\u0644\u0649 \u0633\u064a\u062f\u0646\u0627]</p>\n</li>\n<li>\n<p>\u0627\u0644\u0648\u0632\u064a\u0631 \u0627\u0644\u0627\u0634\u0631\u0641 \u0635\u0627\u062d\u0640[\u0640\u0628 \u0627\u0644\u0640&hellip; \u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u064a\u0642\u0628\u0644 \u0627\u0644\u0627\u0631\u0636 \u0627\u0645\u0627\u0645]</p>\n</li>\n<li>\n<p>\u0627\u0644\u0645\u0642\u0627\u0645 \u0627\u0644\u0634\u0631\u064a\u0641 \u0627\u0644\u0637\u0627\u0647\u0640[\u0640\u0631 \u0632\u0627\u062f\u0647 \u0627\u0644\u0644\u0647 ...]</p>\n</li>\n<li>\n<p>\u062d\u0633\u0631\u0647(?) \u0631\u0639\u0628\u0629[</p>\n</li>\n<li>\n<p>\u0628\u0632\u064a\u0627\u062f\u0629 \u0639\u0646 \u0627\u0644\u0645\u0636\u0631\u0629 \u0627\u0644\u062a\u064a \u064a\u0640[</p>\n</li></ol>\n",
