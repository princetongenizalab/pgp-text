          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>\n<p>\u0648\u0644\u0627 \u0633\u0628\u0628 \u064a\u0642\u0628\u0636 \u0641\u064a\u0647 \u0648\u0644\u0627 \u0648\u0636\u064a\u0639\u0629 \u0648\u0644\u0627 [ &nbsp; ]</p>\n</li>\n<li>\n<p>]\u0627\u0644\u0627\u0642\u0631\u0627\u0631 \u0639\u0644\u064a\u0647\u0627 \u0628\u0647 \u0648\u0642\u0628\u0644 \u0630\u0644\u0643 [ &nbsp; ]\u0641\u064a\u0647\u0627 \u0627\u0628\u0648 \u0633\u0647\u0644 \u0645\u0646\u0634\u0627 \u0647\u0630\u0627[</p>\n</li>\n<li>\n<p>]\u0637\u0648\u0639\u0627 \u0648\u0639\u0644\u0649 \u0635\u062d\u0629 \u0645\u0639\u0631\u0641\u062a\u0647\u0627 \u062c\u0645\u064a\u0639\u0627 \u0648\u0630\u0644\u0643 \u0641\u064a \u062c\u0645\u062f\u0649 \u0627\u0644\u0627\u0648\u0644\u0649 \u0645\u0646 \u0633\u0646\u0629 \u0627\u0631\u0628\u0639 \u0648\u062b\u0644\u062b\u064a\u0646 \u0648\u0627\u0631\u0628\u0639 \u0645\u0627\u0626\u0629 \u0641\u064a \u0647\u0630\u0647 [</p>\n</li>\n<li>\n<p>\u0634\u0647\u062f \u0639\u0628\u062f \u0627\u0644\u0645\u0644\u0643 \u0628\u0646 \u0627\u0633\u0645\u0639\u064a\u0644 \u0628\u0646 \u0639\u0644\u064a \u0627\u0644\u0647\u0644\u0627\u0644\u064a \u0635\u062d</p>\n</li>\n<li>\n<p>\u0639\u0644\u0649 \u0627\u0642\u0631\u0627\u0631 \u0627\u0644\u0645\u0631\u0627\u0629 \u0627\u0644\u0628\u0627\u0626\u0639\u0629 \u0648\u0627\u0644\u0645\u0634\u062a\u0631\u064a \u0628\u0645\u0627 \u0641\u064a\u0647 \u0648\u0639\u0627\u064a\u0646</p>\n</li>\n<li>\n<p>\u0642\u0628\u0636 \u0627\u0644\u0628\u0627\u0626\u0639\u0629 \u0627\u0644\u062b\u0645\u0646 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0641\u064a\u0647 \u0648\u0647\u0648 \u0627\u062d\u062f \u0648\u062b\u0645\u0627\u0646\u0648\u0646 \u062f\u064a\u0646\u0627\u0631\u0627</p>\n</li>\n<li>\n<p>&hellip;&hellip;</p>\n</li></ol>\n",
