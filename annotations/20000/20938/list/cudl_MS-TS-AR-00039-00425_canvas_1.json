        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, right margin",
          "value": "\n<ol><li>\n<p>May you have a blessed new year. </p>\n</li>\n<li>\n<p>God knows that we have been enjoying ourselves </p>\n</li>\n<li>\n<p>so much that it can\u2019t be put into words. </p>\n</li>\n<li>\n<p>May God the exalted bless [the new year]. </p>\n</li></ol>\n\n",
          "format": "text/html"
        }
      ],
