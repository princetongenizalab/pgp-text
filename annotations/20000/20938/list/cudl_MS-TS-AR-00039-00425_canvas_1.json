      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, right margin",
          "value": "\n<ol dir=\"ltr\"><li>\n<p dir=\"ltr\">Ve yeni senenu\u0308z mu\u0308ba\u0304rek olsun.</p>\n</li>\n<li>\n<p>H\u0323ak\u0323k\u0323a ma\u02bflu\u0304mdur ki bir mertebe s\u0323afa\u0304</p>\n</li>\n<li>\n<p>eyledu\u0308k [ki] ta\u02bfbi\u0304re k\u0323a\u0304bil degil,</p>\n</li>\n<li>\n<p>H\u0323ak\u0323k\u0323-\u0131 Te\u02bfa\u0304la\u0304 mu\u0308ba\u0304rek eyleye.</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
