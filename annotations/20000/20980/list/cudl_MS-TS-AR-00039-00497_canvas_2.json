          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li>\u0648\u0635\u0640[</li>\n<li>\u0645\u0646\u0647\u0627 \u0634\u0627\u0647\u062f\u064a\u0646 \u0639\u062f\u0644\u064a\u0646 \u0645\u0646[</li>\n<li>[. &nbsp; &nbsp; ]\u0627\u0644\u0631\u062c\u0644 \u0627\u0644\u0645\u062a\u0648\u0641\u0627 \u0648\u0627\u0644\u0627\u062e\u0640[\u0640\u0631</li>\n<li>[&nbsp; &nbsp; ]\u0627\u0644\u0627\u0646\u0639\u0627\u0645 \u0639\u0644\u064a\u0647\u0627 \u0648\u0627\u0644\u0627\u062d\u0640[\u0640\u0633\u0627\u0646 \u0627\u0644\u064a\u0647\u0627 \u0628\u0627\u062e\u0631\u0627\u062c \u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0639\u0627\u0644\u064a[</li>\n<li>\u0632\u0627\u062f\u0647 \u0627\u0644\u0644\u0647 \u0634\u0631\u0641\u0627 \u0648\u0646\u0641\u0627\u062f\u0627 \u0628\u0627\u0644\u0635\u062f\u0642\u0629 \u0639\u0644\u064a\u0647\u0627[</li>\n<li>\u062d\u064a\u0627\u0629 \u0645\u062c\u062f\u062f\u0629 \u064a\u062d\u064a&hellip;..\u0648\u0644\u0645\u0648\u0644\u0627\u0646\u0627 \u0635\u0644\u0648\u0627\u062a [\u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0627\u0644\u0631\u0627\u064a \u0627\u0644\u0627\u0639\u0644\u0649 \u0641\u064a \u0630\u0644\u0643 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647</li>\n<li>\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0648\u062d\u062f\u0647 \u0648\u0635\u0644\u0648\u0627\u062a\u0647 \u0639\u0644\u0649 \u0633\u064a\u062f\u0646\u0627 [\u0645\u062d\u0645\u062f \u0648\u0627\u0644\u0647 \u0648\u0633\u0644\u0645 \u062a\u0633\u0644\u064a\u0645\u0627</li></ol>\n",
