    {
      "etag": "\"17d4ee9c086381944b60ac792e10956d\"",
      "id": "https://geniza.princeton.edu/annotations/87ff253d-9446-4b5a-a5dd-7674bd1c4d44/",
      "type": "Annotation",
      "created": "2025-11-13T16:22:40.421693+00:00",
