      "id": "https://geniza.princeton.edu/annotations/a3ef6ec8-dce0-4dd8-949c-61f03a483179/",
      "type": "Annotation",
      "created": "2025-11-13T16:15:57.379383+00:00",
      "modified": "2025-11-13T16:15:57.379390+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/141/",
      "target": {
        "source": {
          "id": "https://figgy.princeton.edu/concern/scanned_resources/15988cc4-a83b-4245-ba8c-9a3713fc9a90/manifest/canvas/b759c726-26fd-4eda-87c6-94b2f4a7f391",
