        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li><span lang=\"he\">\u05d1\u05e2\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d2 \u05d5\u05d7\u05e6\u05d9, \u05d4\u05de\u05e9\u05e7\u05dc \u05d3' \u05e7\u05e0\u05d8\u05d0\u05e8\u05d9\u05dd \u05d5\u05d9\"\u05d2; \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e7\u05dc\"\u05d6 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8, \u05d1\u05e0\u05d9\u05db\u05d5\u05d9 \u05de\u05d4 \u05e9\u05e8\u05e6\u05d4 \u05d1\u05e2\u05d3 \u05d4\u05e0\u05e8\u05d8\u05d1\u05d5\u05ea.</span></li>\n<li><span lang=\"he\">\u05d1\u05e2\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d2, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e7\u05dc\"\u05d7 \u05e8\u05d8\u05dc\u05d9\u05dd, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e2\"\u05d6 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d1, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05dc\"\u05d2, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05de\"\u05d2 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8;</span></li>\n<li><span lang=\"he\">\u05d5\u05e2\u05d5\u05d3 \u05e0\"\u05d8 \u05e8\u05d8\u05dc\u05d9\u05dd \u05e9\u05e0\u05e8\u05d8\u05d1\u05d5, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05d9\"\u05d6 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05e1\u05da \u05db\u05dc \u05d4\u05ea\u05de\u05d5\u05e8\u05d4, \u05e7\u05dc\"\u05d6 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8.</span></li>\n<li><span lang=\"he\">\u05d1\u05e2\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d2, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e7\u05e4\"\u05d4, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e2\"\u05d3 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d2, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e6\"\u05d4, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e1\"\u05d4 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d3\u05e8\u05d4\u05dd;</span></li>\n<li><span lang=\"he\">\u05e1\u05da \u05db\u05dc \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e7\u05dc\"\u05d8 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d3\u05e8\u05d4\u05dd.</span></li>\n<li><span lang=\"he\">\u05d1\u05e2\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d3, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e6\"\u05d6, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e1\"\u05d6 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d2, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e7\"\u05db, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e1\"\u05d8 \u05d5\u05d4' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd;</span></li>\n<li><span lang=\"he\">\u05d5\u05e2\u05d5\u05d3 \u05db' \u05e8\u05d8\u05dc\u05d9\u05dd \u05e9\u05e0\u05e8\u05d8\u05d1\u05d5, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05d4' \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d3\u05e8\u05d4\u05dd; \u05e1\u05da \u05db\u05dc \u05d4\u05ea\u05de\u05d5\u05e8\u05d4, \u05e7\u05de\"\u05d0 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d5' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd.</span></li>\n<li><span lang=\"he\">\u05d1\u05e2\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d1, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e1\"\u05d2, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e0\"\u05d1 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d0, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e7\u05e4\"\u05d4, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e1\"\u05d6 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8;</span></li>\n<li><span lang=\"he\">\u05d5\u05e2\u05d5\u05d3 \u05de\"\u05d6 \u05e8\u05d8\u05dc\u05d9\u05dd \u05e9\u05e0\u05e8\u05d8\u05d1\u05d5, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e0' \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05e1\u05da \u05db\u05dc \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e7\u05dc\"\u05d8 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd.</span></li>\n<li><span lang=\"he\">\u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d1 \u05d5\u05d7\u05e6\u05d9, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e7\"\u05d9, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e1\"\u05d6 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8\u05d9\u05dd; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d1, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e7\u05d9\"\u05d1; \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e1\"\u05d6 \u05d5\u05d4' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd \u05e4\u05d7\u05d5\u05ea \u05e9\u05de\u05d9\u05e0\u05d9\u05ea.</span></li>\n<li><span lang=\"he\">\u05e1\u05da \u05db\u05dc \u05d4\u05ea\u05de\u05d5\u05e8\u05d4, \u05e7\u05dc\"\u05d3 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d4' \u05d5\u05e8\u05d4\u05de\u05d9\u05dd \u05e4\u05d7\u05d5\u05ea \u05e9\u05de\u05d9\u05e0\u05d9\u05ea.</span></li>\n<li><span lang=\"he\">\u05d1\u05e2\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d1 \u05d5\u05d7\u05e6\u05d9, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e7\u05de\"\u05d0, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e2\"\u05d8 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05dc\"\u05d1, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e6\"\u05d4, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e1\"\u05d1 \u05d5\u05e9\u05e0\u05d9 \u05d3\u05e8\u05d4\u05de\u05d9\u05dd;</span></li>\n<li><span lang=\"he\">\u05e1\u05da \u05db\u05dc \u05d4\u05ea\u05de\u05d5\u05e8\u05d4, \u05e7\u05de\"\u05d0 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05e9\u05e0\u05d9 \u05d3\u05e8\u05d4\u05de\u05d9\u05dd.</span></li>\n<li><span lang=\"he\">\u05d1\u05e2\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05db\"\u05d7 \u05d5\u05d7\u05e6\u05d9, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\"\u05e4, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e0\"\u05d0 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05db\"\u05d6, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e7\u05d9\"\u05d1, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e0\"\u05d6 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8;</span></li>\n<li><span lang=\"he\">\u05d5\u05e2\u05d5\u05d3 \u05dc'... (\u05e8\u05d8\u05dc\u05d9\u05dd) \u05e9\u05e0\u05e8\u05d8\u05d1\u05d5, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05d7' \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d3' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd; \u05e1\u05da \u05db\u05dc \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e7\u05d9\"\u05d5 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d3' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd.</span></li>\n<li><span lang=\"he\">\u2026\u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d3' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd, \u05d1\u05e0\u05d9\u05db\u05d5\u05d9 \u05de\u05d4 \u05e9\u05e8\u05e6\u05d4 \u05d1\u05e2\u05d3 \u05d4\u05e0\u05e8\u05d8\u05d1\u05d5\u05ea,\u2026\u05e4\"\u05d0 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d4' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd; \u05e1\u05da \u05db\u05dc \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e7\u05e0\"\u05d0 \u05d5\u05d7' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd.</span></li>\n<li><span lang=\"he\">\u2026(\u05d1\u05e2\u05d3) \u05e0\"\u05d8 \u05de\u05e9\u05d5\u05d0\u05d9\u05dd, \u05d1\u05d6\u05d4\u05d1 \u05d0\u05dc\u05e4\u05d9\u05d9\u05dd \u05d5\u05ea\"\u05d6 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d1\u05d9\u05d5\u05e8\u05e7' \u05e1\"\u05d4 \u05d3\u05e8\u05d4\u05de\u05d9\u05dd;</span></li>\n<li><span lang=\"he\">\u2026\u05e1\u05d1\u05dc\u05d9\u05dd \u05d0\u05dc \u05d4\u05de\u05d7\u05e1\u05df, \u05d5\u05d4\u05e1\u05d9\u05d3\u05d5\u05e8, \u05d5\u05e1\u05d1\u05dc\u05d9\u05dd\u00a0</span></li>\n<li><span lang=\"he\">\u2026\u05de\u05d4\u05de\u05d7\u05e1\u05df \u05d0\u05dc \u05d4\u05e9\u05d5\u05e7 \u05d5\u05d0\u05d5\u05e8\u05d6\u05d9\u05dd \u05d5\u05e9\u05d5\u05e7\u05dc\u05d9\u05dd,</span></li>\n<li><span lang=\"he\">\u2026\u05d5\u05d7\u05e6\u05d9; \u05d5\u05e2\u05de\u05dc\u05d4 \u05e2\"\u05d1 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8</span></li>\n<li><span lang=\"he\">\u2026\u05e4\"\u05d0 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05e1\"\u05d3 \u05d3\u05e8\u05d4\u05de\u05d9\u05dd; \u05d4\u05d9\u05ea\u05e8\u05d4 \u05d0\u05d7\u05e8\u05d9</span></li>\n<li><span lang=\"he\">\u2026\u05e4\u05d7\u05d5\u05ea \u05d3\u05de\u05d9 \u05d4\u05d5\u05d1\u05dc\u05d4 \u05dc\u05d1\u05df \u05d0\u05d1\u05d9 \u05d0\u05dc\u05d0\u05e9\u05d9\u05d9\u05dd \u05d1\u05e2\u05d3 \u05db\"\u05d0 \u05de\u05e9\u05d5\u05d0\u05d9\u05dd,</span></li>\n<li><span lang=\"he\">\u2026\u05d5\u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05d0\u05d8\u05e8\u05d0\u05d1\u05dc\u05e1,</span></li>\n<li><span lang=\"he\">\u2026\u05e7\u05e7\u05e6\"\u05d6 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05e7\u05d9\u05e8\u05d0\u05d8 \u05d6\u05d4\u05d1.</span></li></ol>\n",
          "format": "text/html"
        }
      ],
