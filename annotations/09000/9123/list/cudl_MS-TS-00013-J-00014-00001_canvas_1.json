    {
      "etag": "\"fee6b13cf8ea05fb0a54ad4cc5765e30\"",
      "id": "https://geniza.princeton.edu/annotations/a1e5d230-834e-426c-a883-6c5d8d09e2d4/",
      "type": "Annotation",
      "created": "2026-08-13T13:53:58.117474+00:00",
