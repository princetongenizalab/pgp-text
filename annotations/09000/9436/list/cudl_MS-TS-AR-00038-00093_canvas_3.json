        {
          "type": "TextualBody",
          "label": "Fol. 2r - left side (1 recto in Khan's edition)",
          "value": "\n<ol><li>\u0627\u0644\u0645\u0644\u0643 \u0627\u0644\u0627\u0641\u0636\u0644 \u0646\u0648\u0631 \u0627\u0644\u062f\u0646\u064a\u0627 \u0648\u0627\u0644\u062f\u064a\u0646</li>\n<li>\u0648\u0627\u0644\u0645\u0638\u0641\u0631 \u0639\u0644\u064a \u0628\u0646 \u0627\u0644\u0645\u0644\u0643 \u0627\u0644\u0646\u0627\u0635\u0631 \u0645\u062d\u064a\u064a \u062f\u0648\u0644\u0629 \u0627\u0645\u064a\u0631 \u0627\u0644\u0645\u0648\u0645\u0646\u064a\u0646</li>\n<li>\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645</li>\n<li>\u0645\u0646 \u062d\u0645\u064a\u062f \u0633\u0646\u0646\u0646\u0627 \u0648\u0645\u0647\u064a\u062f \u0633\u0646\u0646\u0646\u0627 \u0648\u0642\u0648\u064a\u0645 \u0633\u064a\u0631\u0646\u0627</li>\n<li>\u0648\u0643\u0631\u064a\u0645 \u0639\u0645\u064a\u062f\u0646\u0627 \u0627\u0644\u0630\u0649 \u0627\u0632\u062f\u062f\u0646\u0627 \u0628\u0647 \u062a\u0645\u064a\u0632\u0627 \u0648\u062a\u0645\u064a\u064a\u0632\u0627</li>\n<li>\u0648\u0628\u0644\u063a\u0646\u0627 \u0628\u0647 \u0627\u0644\u0649 \u063a\u0627\u064a\u0629 \u0627\u0644\u0645\u062c\u062f \u0633\u0628\u0642\u0627 \u0648\u062a\u0628\u0631\u064a\u0632\u0627</li>\n<li>\u0648\u0646\u0627\u0632\u062d \u0628\u0647 \u0630\u0643\u0631\u0646\u0627 \u0641\u0649 \u0627\u0644\u0627\u0641\u0627\u0642 \u0648\u0635\u0627\u0631 \u0639\u0638\u064a\u0645</li>\n<li>\u0627\u0644\u0627\u0646\u062f\u064a\u0629 \u0648\u062a\u0645\u064a\u0645 \u0627\u0644\u0631\u0641\u0627\u0642 \u0648\u0636\u0639\u0646\u0627 \u0627\u0644\u0636\u0627\u064a\u0639</li>\n<li>\u0641\u0649 \u0627\u0632\u0643\u0649 \u0645\u063a\u0631\u0633\u0647\u0627 \u0648\u0627\u0641\u0631\u0627\u0632\u0646\u0627 \u0627\u0644\u0627\u064a\u0627\u062f\u0649 \u0641\u0649</li>\n<li>\u0627\u0643\u0631\u0645 \u0645\u0639\u0631\u0633\u0647\u0627 \u0648\u0627\u064a\u0644\u0627 \u0627\u0648\u0644\u064a\u0627\u064a\u0646\u0627 \u0648\u062e\u062f\u0645 \u062f\u0648\u0644\u062a\u0646\u0627</li>\n<li>\u0648\u0627\u0644\u0645\u0647\u0627\u062c\u0631\u064a\u0646 \u0627\u0644\u0649 \u062e\u062f\u0645\u062a\u0646\u0627 \u0648\u0627\u0644\u0645\u0646\u062a\u0638\u0645\u064a\u0646 \u0641\u0649 \u0633\u0644\u0643</li>\n<li>\u062e\u0648\u0627\u0635\u0646\u0627 \u0627\u0644\u0630\u0649 \u062a\u0642\u062f\u0645\u062a \u0639\u0646\u062f\u0646\u0627 \u062e\u062f\u0645\u0647\u0645 \u0648\u062a\u0627\u0643\u062f\u062a</li>\n<li>\u0644\u062f\u064a\u0646\u0627 \u0630\u0645\u0645\u0647\u0645 \u0628\u0645\u0627 \u064a\u0633\u0628\u063a \u0639\u0644\u064a\u0647\u0645 \u0639\u0637\u0627 \u0627\u0644\u0627\u0646\u0639\u0627\u0645</li>\n<li>\u0648\u064a\u0633\u064a\u063a \u0644\u062f\u064a\u0647\u0645 \u0639\u0637\u0627 \u0627\u0644\u0627\u062d\u0633\u0627\u0646 \u0648\u0627\u0644\u0627\u0643\u0631\u0627\u0645 \u0648\u064a\u0632\u064a\u062f\u0647\u0645</li>\n<li>\u0641\u0649 \u0627\u0644\u0648\u0644\u0627 \u0642\u0648\u0629 \u0628\u0635\u064a\u0631\u0629 \u0648\u0634\u062f\u0629 \u0642\u0631\u064a\u0631\u0629 \u0648\u064a\u0631\u0641\u0639</li>\n<li>\u0628\u064a\u0646 \u0627\u0646\u0638\u0627\u0631\u0647\u0645 \u0631\u062a\u0628\u0647\u0645 \u0648\u064a\u0648\u0635\u0644 \u0628\u0630\u0648\u0649 \u0627\u0644\u0627\u062e\u0644\u0627\u0635</li></ol>\n",
