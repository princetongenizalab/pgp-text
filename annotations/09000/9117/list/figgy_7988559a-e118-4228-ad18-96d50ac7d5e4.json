      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, address",
          "value": "<p>To the distinguished sage, the exalted prince, master and teacher Halfon Halevi, may God protect him, the son of the honorable master and teacher Nethaniel Halevi, may he rest in paradise.</p>",
          "format": "text/html"
        }
      ],
