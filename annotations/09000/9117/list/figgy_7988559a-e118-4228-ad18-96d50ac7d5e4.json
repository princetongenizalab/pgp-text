      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, address",
          "value": "<ol>\n<li>The wondrous sage, the exalted prince, the master and teacher \u1e24alfon ha-Levi, may the me(rciful one) pr(otect him), son of his honor our master and teacher Netan\u02beel ha-Levi, may the memory of the righteous be a blessing.&nbsp;</li>\n</ol>",
          "format": "text/html"
        }
