      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "<ol>\n<li>I pledge to his excellency most unwavering faith [ . . . ]</li>\n<li>May he write to me with the favor of his apposite opinion [ . . . ]</li>\n<li>[ . . . ] us in it from a commodity, and the commodit[y . . . ]</li>\n<li>[ . . . ] in silk, the part of silk that I'll buy [from] him [ . . . ]</li>\n<li>[ . . . ] you intercede for me with Ibn Barukh to the extent [ . . . ]</li>\n<li>[ . . . m]y lord m[ost perfect] greetings [ . . . ] your nephew Ab\u016b l-Majd, my lord and master</li>\n<li>[ . . . my] lord and master [ . . . ]</li>\n</ol>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
