      "dc:source": "https://geniza.princeton.edu/sources/141/",
      "target": {
        "source": {
          "id": "https://figgy.princeton.edu/concern/scanned_resources/2eb31e16-db58-428c-b75a-0a4355a915c7/manifest/canvas/84490d2d-886f-40a3-be89-82ecf8890f54",
          "type": "Canvas",
