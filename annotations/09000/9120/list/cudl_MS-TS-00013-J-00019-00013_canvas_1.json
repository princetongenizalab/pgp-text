    {
      "etag": "\"d5a210db64e59342c2b6d8ed64f7e1a6\"",
      "id": "https://geniza.princeton.edu/annotations/2d582fcd-20ed-473d-b00b-87d79721bbbe/",
      "type": "Annotation",
      "created": "2025-11-30T00:02:01.864859+00:00",
      "modified": "2025-11-30T00:02:01.864869+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/141/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00013-J-00019-00013/canvas/1",
          "type": "Canvas",
          "partOf": {
