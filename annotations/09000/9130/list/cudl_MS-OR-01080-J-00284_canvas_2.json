      "dc:source": "https://geniza.princeton.edu/sources/141/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-OR-01080-J-00284/canvas/2",
          "type": "Canvas",
          "partOf": {
