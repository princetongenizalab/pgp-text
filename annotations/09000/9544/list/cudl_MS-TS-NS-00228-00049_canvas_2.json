      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, middle margin",
          "value": "\n<ol><li><span lang=\"he\">\u05d5\u05e8\u05d2\u05d4\u05ea \u05dc\u05d0\u05d1\u05d9 [</span></li>\n<li><span lang=\"he\">\u05d0\u05dc\u05e2\u05d3\u05dc \u05e2\u05dc\u05d9 [</span></li>\n<li><span lang=\"he\">\u05d0\u05dc\u05d3\u05d9 \u05e7\u05dc\u05ea \u05dc\u05d9</span></li>\n<li><span lang=\"he\">\u05d5\u05e7\u05d0\u05dc \u05d0\u05df \u05d0\u05e0\u05d0</span></li>\n<li><span lang=\"he\">\u05d0\u05db\u05ea\u05d1 \u05dc\u05d4 \u05db\u05ea\u05d0[\u05d1</span></li>\n<li><span lang=\"he\">]\u05d3\u05d0 \u05d0\u05e0\u05d7\u05d3\u05e8</span></li>\n<li>\u00a0</li>\n<li>\u00a0</li>\n<li><span lang=\"he\">] \u05de\u05df</span></li>\n<li><span lang=\"he\">] \u05db\u05ea\u05d0\u05e0\u05d4</span></li>\n<li><span lang=\"he\">\u05d5\u05d2\u05d4\u05ea\u05d4 \u05d0\u05dc\u05db\u05d1\u05d9\u05e8\u05d4</span></li>\n<li><span lang=\"he\">\u05d5\u05d7\u05d5\u05d0\u05d9\u05d2\u05d4 \u05d5\u05de\u05d0</span></li></ol>\n",
