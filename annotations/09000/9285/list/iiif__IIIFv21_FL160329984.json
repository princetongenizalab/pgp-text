    {
      "etag": "\"4a8e04b4a85e083e4bf50fdd484e50eb\"",
      "id": "https://geniza.princeton.edu/annotations/020be041-e487-465e-9d1d-c142de30d937/",
      "type": "Annotation",
      "created": "2026-11-12T18:29:48.475043+00:00",
