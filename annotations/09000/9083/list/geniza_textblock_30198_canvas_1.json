    {
      "etag": "\"af27a3bc56d16c9c6d303cea17081c4a\"",
      "id": "https://geniza.princeton.edu/annotations/a4a71a61-2636-4453-8acf-c732bff18de5/",
      "type": "Annotation",
      "created": "2025-11-12T17:41:13.282112+00:00",
      "modified": "2025-11-12T17:41:13.282119+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/141/",
      "target": {
        "source": {
          "id": "https://geniza.princeton.edu/documents/9083/iiif/textblock/30198/canvas/1/",
          "type": "Canvas",
          "partOf": {
