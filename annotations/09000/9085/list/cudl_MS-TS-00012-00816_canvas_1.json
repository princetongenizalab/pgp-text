      "dc:source": "https://geniza.princeton.edu/sources/141/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00012-00816/canvas/1",
          "type": "Canvas",
          "partOf": {
