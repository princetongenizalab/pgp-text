      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "<ol>\n<li>\u062e\u0644\u062f \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0645\u0644\u0643 \u0627\u0644\u0645\u062c\u0644\u0633 \u0627\u0644\u0639\u0627[\u0644\u0640]\u0640\u064a [\u0627]\u0644\u0633\u064a\u062f\u064a [\u0627\u0644\u0627\u062c\u0644\u064a \u0627\u0644\u062c\u064a\u0648\u0634\u064a \u0627\u0644\u0633\u064a\u0641\u064a]</li>\n<li>\u0627\u0644\u0646\u0627\u0635\u0631\u064a \u0627\u0644\u0643\u0627\u0641\u0644\u064a \u0627\u0644\u0647\u0627\u062f\u064a \u0648\u0639\u0636\u062f \u0628\u0647 \u0627\u0644\u062f\u064a\u0646 \u0648\u0627\u0645\u062a\u0639 \u0628\u0637\u0648\u0644 \u0628\u0642\u0627\u0649\u0647</li>\n<li>\u0627\u0645\u064a\u0631 \u0627\u0644\u0645\u0648\u0645\u0646\u064a\u0646 \u0648\u0627\u062f\u0627\u0645 \u0642\u062f\u0631\u062a\u0647 \u0648\u0627\u0639\u0644\u0627 \u0634\u0627\u0646\u0647 \u0648\u0643\u0644\u0645\u062a\u0647&nbsp; &nbsp; &nbsp;\u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u064a\u0642\u0628\u0644 \u0627\u0644\u0627\u0631\u0636 \u0648\u064a\u0646\u0647\u064a</li>\n<li>\u0645\u0631\u0642\u0647 \u062d\u0627\u0644\u0647 \u0645\u0642\u0635\u0648\u0631 \u062f\u0627\u0646 \u0628\u0633\u0628\u0628 \u0645\u0627 \u0639\u0644\u064a\u0647 \u0645\u0646 \u0627\u0644\u0643\u0644\u0641 \u0648\u0627\u0644\u0639\u0627\u064a\u0644\u0629 \u0648\u0627\u0646 \u0627\u0644\u0645\u0645\u0644\u0648\u0643</li>\n<li>\u0639\u0627\u0649\u062f \u0645\u0646 \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0634\u0631\u064a\u0641\u0629 \u0628\u062b\u063a\u0631 \u0639\u0633\u0642\u0644\u0627\u0646 \u062d\u0645\u0627\u0647 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0628\u0639\u062f \u0645\u0627</li>\n<li>\u0628\u0630\u0644\u0647 \u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u0645\u0646 \u0627\u0644\u0646\u0647\u0636\u0629 \u0648\u0627\u0644\u0627\u062c\u062a\u0647\u0627\u062f \u0648\u0637\u0627\u0639\u0629 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0648\u0637\u0627\u0639\u0629</li>\n<li>\u0645\u0627\u0644\u0643 \u0631\u0642\u0647 \u0648 \u0645\u0643\u0627\u0641\u062d\u062a\u0647 \u0627\u0644\u0639\u062f\u0648 \u0627\u0644\u0644\u0639\u064a\u0646 \u0648\u0634\u0643\u0631 \u0627\u0644\u0645\u0642\u062f\u0645\u064a\u0646 \u0628\u062e\u062f\u0645\u062a\u0647</li>\n<li>\u0648\u0646\u0647\u0636\u062a\u0647 \u0648\u0639\u0644\u0645\u0647\u0645 \u0628\u0645\u0627 \u0628\u0630\u0644\u0647 \u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u0645\u0646 \u0627\u0644\u0627\u0633\u062a\u0642\u0644\u0627\u0644</li>\n</ol>",
