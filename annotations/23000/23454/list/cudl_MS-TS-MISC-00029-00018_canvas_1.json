        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\n\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645\n</li>\n<li dir=\"rtl\">\n\u0642\u062f \u0643\u0627\u0646 \u062e\u062f\u0645\u0629 \u0645\u0645\u0644\u0648\u0643\u0647\u0627 \u062b\u0628\u062a \u0627\u0644\u0644\u0647 \u0627\u0644\u0646\u0639\u0645 \u0639\u0646\u062f\u0646\u0627 \u0648\u0639\u0646\u062f\u0647\u0627 \u0648\u0627\u0647\u0644\u0643 \u0639\u062f\u0648\u0647\u0627\n</li>\n<li dir=\"rtl\">\n\u0648\u0636\u062f\u0647\u0627 \u0635\u062f\u0631\u062a \u0627\u0644\u0649 \u0645\u062c\u0644\u0633\u0647\u0627 \u0627\u0644\u0633\u0627\u0645\u064a \u0628\u0645\u0627 \u064a\u063a\u0646\u064a \u0639\u0646 \u0627\u0639\u0627\u062f\u0629\n</li>\n<li dir=\"rtl\">\n\u0630\u0627\u0643 \u0639\u0644\u0649 \u062c\u0645\u0644\u062a\u0647 \u0645\u0646 \u062a\u0627\u062e\u0631\u0647 \u0639\u0646 \u0645\u062c\u0644\u0633\u0647\u0627 \u0627\u0644\u0633\u0627\u0645\u064a \u0644\u0634\u062f \u0645\u0645\u0627 \u0647\u0648 \u0641\u064a\u0647\n</li>\n<li dir=\"rtl\">\n\u0648\u0644\u0645\u0627 \u0648\u0635\u0644 \u0627\u0645\u0631\u0647\u0627 \u0628\u0633\u0628\u0628 \u0636\u0627\u0645\u0646 \u0627\u0644\u062d\u0645\u0627\u0645 \u0648\u0627\u0644\u0633\u0627\u0642\u064a\u0629 \u0627\u0645\u062a\u062b\u0644\u062a\n</li>\n<li dir=\"rtl\">\n\u0630\u0644\u0643 \u0648\u0642\u062f \u062a\u0648\u062c\u0647\u0648\u0627\u00a0 \u0628\u0645\u0627 \u0627\u0642\u062a\u062f\u0631\u0648\u0627 \u0639\u0644\u064a\u0647 \u0627\u0644\u0649 \u0628\u064a\u0646 \u064a\u062f\u064a\u0647\u0627 \u0644\u0627\u0646\u00a0\n</li>\n<li dir=\"rtl\">\n\u00a0\u0627\u0644\u062d\u0645\u0627\u0645\u064a \u0627\u062a\u0641\u0642 \u062c\u0645\u0631\u0643\u064a\u062a\u0647 \u0648\u0627\u0644\u0639\u0645\u0644 \u0628\u064a\u062f\u0647 \u0648\u0627\u0645\u0627 \u0636\u0627\u0645\u0646 \u062d\u0645\u0627\u0645\u00a0\n</li>\n<li dir=\"rtl\">\n\u062f\u0645\u064a\u0631\u0629 \u0641\u0627\u0646\u0647 \u064a\u0633\u062a\u062d\u0628 \u0648\u0628\u0642\u064a \u0642\u0631\u0648\u0631 \u0627\u0644\u062d\u0645\u0627\u0645 \u0633\u0627\u0628\u064a\u0647 \u0645\u062d\u0636\u0631 \u0645\u0646 \u0631\u063a\u0628\n</li>\n<li dir=\"rtl\">\n\u0641\u064a \u0636\u0645\u0627\u0646\u0647\u0627 \u0648\u0642\u062f \u0627\u062e\u0630 \u0639\u0644\u064a\u0647 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0628\u0634\u0631\u0637 \u0627\u0633\u062a\u0630\u0627\u0646(=\u0627\u0633\u062a\u0626\u0630\u0627\u0646\u061f) \u0627\u0644\u062f\u064a\u0648\u0627\u0646\n</li>\n<li dir=\"rtl\">\n\u00a0\u0627\u0644\u0645\u0639\u0645\u0648\u0631 \u0648\u0642\u062f \u0633\u064a\u0631 \u0645\u0644\u0648\u0643\u0647\u0627 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0642\u0631\u064a\u0646 (\u061f) \u062e\u062f\u0645\u062a\u0647 \u0644\u0633\u064a\u062f\u064a \u0631\u0627\u064a\u0647\u0627 \u0627\u0644\u0633\u0627\u0645\u064a\n</li>\n<li dir=\"rtl\">\n\u00a0\u0641\u064a\u0647 \u0648\u0627\u0646\u0635\u0627\u0641(\u061f) \u062d\u0645\u0627\u0645 \u062f\u0645\u064a\u0631\u0629 \u0627\u0644\u0645\u0633\u062a\u062d\u0628 \u062f\u0627\u0646 \u0628\u062f\u064a\u0646\u0647 \u064a\u0633\u0627\u0648\u064a \u0639\u0644\u064a\u0647\n</li>\n<li dir=\"rtl\">\n\u00a0\u0641\u0627\u0646 \u062d\u0633\u0646 \u0641\u064a \u0631\u0627\u064a\u0647\u0627 \u0627\u0644\u062a\u0642\u062f\u0645 \u0628\u0640\u0628\u064a\u0639\u0640\u0647\u0627(\u061f) \u0627\u0648 \u0627\u0644\u062d\u0648\u0637 \u0639\u0644\u064a\u0647\u0627\n</li>\n<li dir=\"rtl\">\n\u00a0\u0648\u0627\u0644\u0627\u0645\u0631 \u0644\u0647\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u064a\u0647 \u0646\u064a\u0641\u0647\u0627(\u061f) \u0648\u0645\u0645\u0644\u0648\u0643\u0647\u0627 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647\u00a0 \u0639\u0642\u064a\u0628 \u062e\u062f\u0645\u062a\u0647\u00a0\n</li>\n<li dir=\"rtl\">\n\u00a0\u0644\u0627\u0646 \u2026\u2026 \u0645\u0646 \u062a\u0642\u0628\u064a\u0644 \u064a\u062f\u064a\u0647\u0627 \u0627\u0646\u0647\u0649 \u0630\u0644\u0643 \u0648\u0644\u0647\u0627 \u0631\u0627\u064a\u0647\u0627 \u0627\u0644\u0633\u0627\u0645\u064a\n</li>\n<li dir=\"rtl\">\n\u00a0\u0641\u064a \u0630\u0644\u0643 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647\u00a0\u00a0\n</li>\n<li dir=\"rtl\">\n\u00a0\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0648\u062d\u062f\u0647 \u0648\u0635\u0644\u0648\u062a\u0647 \u0639\u0644\u0649 \u0645\u062d\u0645\u062f \u0646\u0628\u064a\u0647 \u0648\u0633\u0644\u0645 \u062a\u0633\u0644\u064a\u0645\u0627\n</li>\n<li dir=\"rtl\">\n\u00a0\u062d\u0633\u0628\u0646\u0627 \u0627\u0644\u0644\u0647 \u0648\u0646\u0639\u0645 \u0627\u0644\u0648\u0643\u064a\u0644\n</li></ol>\n",
          "format": "text/html"
        }
      ],
