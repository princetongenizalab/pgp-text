        "source": {
          "id": "https://figgy.princeton.edu/concern/scanned_resources/4430efd7-363a-4c01-824b-7392df2483e4/manifest/canvas/5a27377e-142a-4c87-88f0-2b6765094eb5",
          "type": "Canvas",
          "partOf": {
