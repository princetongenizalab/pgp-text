      "body": [
        {
          "type": "TextualBody",
          "value": "\n<ol><li dir=\"rtl\">\n<p dir=\"rtl\">\u2026..\u0644\u0648 \u0633\u062a\u0631 \u0639\u0644\u064a\u0647\u0627 \u0648\u0627\u062c\u062a\u0647\u0627\u062f\u2026</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0641\u0631\u063a\u0628 \u0641\u064a \u0636\u0645\u0627\u0646\u0647\u0627 \u0645\u0646 \u063a\u064a\u0631\u0647\u0645 \u0648\u0627\u0632\u0627\u062d \u0639\u0644\u062a\u0647\u0645 \u0648</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u2026\u2026\u2026\u2026\u0645\u0646 \u0627\u0644\u062f\u064a\u0648\u0627\u0646 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 (\u061f)</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u062d\u0627\u0631\u062a\u064a\u0646 \u0641\u064a \u0627\u0642\u0637\u0627\u0639 \u0627\u0644\u0645\u0642\u0637\u0639\u064a\u0646 \u0648..</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0641\u0647\u064a \u062e\u0635\u0648\u0635\u0627 \u0645\u0646 \u0627\u0644\u062f\u064a\u0648\u0627\u0646 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u2026.\u0639\u0646\u062f\u0647</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0639\u0646\u061f</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0645\u0646 \u064a\u062f\u0641\u0639 \u0645\u0646 \u062c\u0647\u0629 \u0627\u0644\u0642\u0627\u064a\u062f \u0648\u0627\u0644\u0646\u0648\u0627\u0628 \u0639\u0646 \u0627\u0644\u0645\u0648\u0637(\u061f)</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0639\u0644\u0649 \u2026\u2026.\u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u062d\u0648\u0637\u0629 \u0642\u0628\u0644 \u0645\u0627 \u064a\u062e\u062a\u0635..</p>\n</li></ol>\n",
