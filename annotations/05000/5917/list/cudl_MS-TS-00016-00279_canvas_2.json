      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, address, right column",
          "value": "\n<ol dir=\"ltr\"><li>To my lord, my teacher and master Nahray son of my master Niss\u012bm, may he soul be at rest,</li>\n<li>may God prolong his life and perpetuate his benefaction.</li>\n<li>(Arabic script) My lord the elder Ab\u016b Ya\u1e25y\u0101 Nahray b. Niss\u012bm, may God prolong</li>\n<li>his life, [God willing].</li></ol>\n",
          "format": "text/html"
        }
      ],
