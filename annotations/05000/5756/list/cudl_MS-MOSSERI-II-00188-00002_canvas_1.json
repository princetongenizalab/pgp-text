          "value": "\n<ol><li><span lang=\"he\">\u05db'\u05d9\u05d8\u05d9\u05d4 \u05d5\u05de\u05d5\u05dc[\u05d0\u05d9]</span></li>\n<li><span lang=\"he\">\u05d0\u05d1\u05d9 \u05d0\u05dc\u05e4\u05e6'\u05dc</span></li>\n<li><span lang=\"he\">\u05d6\u05db\u05e8\u05d9 \u05d0\u05e4\u05e6'\u05dc \u05d0\u05dc</span></li>\n<li><span lang=\"he\">\u05e1\u05dc\u05dd \u05d5\u05d0\u05e1\u05dc\u05d4</span></li>\n<li><span lang=\"he\">\u05dc\u05e2\u05dc \u05d9\u05d7\u05e6\u05dc \u05dc\u05d9</span></li>\n<li><span lang=\"he\">\u05de\u05df \u05d0\u05dc\u05d5\u05ea'\u05d9\u05e7\u05d4</span></li>\n<li><span lang=\"he\">\u05e9\u05d9 \u05e4\u05de\u05d0</span></li>\n<li><span lang=\"he\">\u05d0\u05d7\u05e1\u05d1 \u05de\u05d0</span></li>\n<li><span lang=\"he\">\u05d9\u05d7\u05e6\u05dc \u05de\u05e0\u05d4\u05d0 \u05d0\u05dc\u05d0</span></li>\n<li><span lang=\"he\">\u05de\u05df \u05db\u05d9\u05e1\u05d4 \u05d5\u05db\u05d3\u05dc\u05da</span></li>\n<li><span lang=\"he\">\u05e1\u05d0\u05dc\u05ea\u05d4 \u05e4\u05d9 \u05e9\u05e8\u05d0</span></li>\n<li><span lang=\"he\">\u05d7\u05d1\u05dc \u05d5\u05db'\u05d9\u05e9\u05dc \u05d5' \u05d8\u05d5\u05d0\u05dc\u05d0\u05ea</span></li>\n<li><span lang=\"he\">\u05d0\u05d7\u05d1 \u05d9\u05d7\u05e6\u05dc\u05d4\u05dd</span></li>\n<li><span lang=\"he\">\u05d5\u05d9\u05e0\u05e4\u05d3\u05d4\u05dd \u05d0\u05dc\u05d9</span></li>\n<li><span lang=\"he\">\u05d5\u05db\u05d3'\u05dc\u05da \u05dc\u05dc\u05e9\u05d9\u05da</span></li>\n<li><span lang=\"he\">\u05d0\u05d1\u05d5 \u05e1\u05d7\u05e7 \u05d1\u05e8\u05d4\u05d5\u05df</span></li>\n<li><span lang=\"he\">\u05e2\u05e0\u05d3 \u05d0\u05dc\u05d0\u05d1\u05d9\u05d0\u05df</span></li>\n<li><span lang=\"he\">\u05d0\u05dc\u05de\u05d7\u05e8\u05e7\u05d9\u05df</span></li>\n<li><span lang=\"he\">\u05d7\u05d6\u05dd</span></li></ol>\n",
