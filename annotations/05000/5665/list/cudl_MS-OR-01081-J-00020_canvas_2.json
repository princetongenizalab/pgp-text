        {
          "type": "TextualBody",
          "label": "Verso, address",
          "value": "<p>\u05d2\u05d3\u05d5\u05dc \u05d4\u05d9\u05e9\u05d9\u05d1\u05d4 \u05e8\u05d1\u05e0\u05d9 \u05e0\u05d4\u05d5\u05e8\u05d0\u05d9 \u05d1\u05d9\"\u05e8 \u05e0\u05e1\u05d9\u05dd \u05d6\"\u05dc, \u05d9\u05ea\u05df \u05dc\u05d5 \u05d0\u05dc\u05d4\u05d9\u05dd \u05d0\u05e8\u05d9\u05db\u05d5\u05ea \u05d9\u05de\u05d9\u05dd \u05d5\u05d9\u05ea\u05de\u05d9\u05d3 \u05d0\u05ea \u05d2\u05d3\u05d5\u05dc\u05ea\u05d5 \u05d5\u05d0\u05ea \u05e2\u05d6\u05e8\u05ea\u05d5 \u05d5\u05d0\u05ea \u05d7\u05e1\u05d3\u05d9\u05d5 \u05dc\u05d5, \u05d9\u05e9\u05d5\u05e2\u05d4 \u05d1\u05df \u05d0\u05b8\u05e1\u05de\u05e2\u05d9\u05dc \u05e0\"<span lang=\"he\">\u05e0</span>; \u05d9\u05e9\u05e2 \u05e8\u05d1.</p>",
