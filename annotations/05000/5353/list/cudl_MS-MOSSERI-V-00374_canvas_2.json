    {
      "etag": "\"5e6e7ce9a12f629952c2c8228a82054d\"",
      "id": "https://geniza.princeton.edu/annotations/4fc1d949-233c-41b3-9e23-ecf7edcb25a8/",
      "type": "Annotation",
      "created": "2026-03-12T22:24:12.228290+00:00",
      "modified": "2026-03-12T22:24:12.228301+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/8/",
      "target": {
        "source": {
          "id": "http://cudl.lib.cam.ac.uk/iiif/MS-MOSSERI-V-00374/canvas/2",
          "type": "Canvas",
          "partOf": {
            "id": "https://geniza.princeton.edu/documents/5353/iiif/manifest/"
