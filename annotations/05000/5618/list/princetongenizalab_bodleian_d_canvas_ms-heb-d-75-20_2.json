      "body": [
        {
          "type": "TextualBody",
          "label": "verso, right margin",
          "value": "<p>(1\u20138) \u05d5\u05dc\u05db\u05dc \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05dc\u05d7\u05e1\u05d5\u05ea\u05da \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05e9\u05dc\u05d5\u05dd. \u05d5\u05d0\u05d3\u05d5\u05e0\u05d9 \u05d0\u05d1\u05d5 \u05e2\u05dc\u05d9 \u05d7\u05e1\u05d5\u05df \u05d1\u05df \u05d0\u05e1\u05d7\u05e7 \u05e9\u05d5\u05dc\u05d7 \u05dc\u05da \u05d0\u05ea \u05de\u05d9\u05d8\u05d1 \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05e9\u05dc\u05d5\u05dd \u05d5\u05de\u05d1\u05e7\u05e9 \u05de\u05de\u05da \u05db\u05d9 \u05ea\u05d5\u05d0\u05d9\u05dc \u05dc\u05e1\u05d3\u05e8 \u05dc\u05d5 \u05d0\u05ea \u05de\u05db\u05d9\u05e8\u05ea \u05d4\u05e9\u05de\u05df, \u05db\u05db\u05dc \u05e9\u05d9\u05e2\u05e0\u05d9\u05e7 \u05d0\u05dc\u05d5\u05d4\u05d9\u05dd.\u00a0</p>\n<p>(9\u201320) \u05db\u05d9\u05d5\u05e6\u05d0 \u05d1\u05d6\u05d4 (\u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05db\u05dc) \u05de\u05d4 \u05e9\u05d9\u05d9\u05de\u05e1\u05e8 \u05d5\u05d9\u05d2\u05d9\u05e2 \u05d9\u05e9\u05d9\u05d2 \u05ea\u05de\u05d5\u05e8\u05d4, \u05d4\u05db\u05d5\u05dc \u05d1\u05e7\u05dc\u05d5\u05ea, \u05d1\u05e8\u05e6\u05d5\u05df \u05d4\u05d0\u05dc .... (\u05d1\u05e2\u05d3) \u05d3\u05e8\u05d4\u05de\u05d9\u05dd \u05d8\u05d5\u05d1\u05d9\u05dd, \u05e9\u05d9\u05d4\u05d9\u05d5 \u05e7\u05d8\u05e0\u05d9\u05dd \u05d5\u05e7\u05dc\u05d9\u05dd; \u05d4\u05d5\u05d0\u05d9\u05dc\u05d4 \u05d1\u05d8\u05d5\u05d1\u05da \u05dc\u05e7\u05d7\u05ea \u05dc\u05d9 \u05de\u05d4\u05dd \u05d0\u05dc\u05e3 \u05e6\u05e8\u05d5\u05e8\u05d5\u05ea(?). </p>\n<p>\u00a0</p>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 2
    },
