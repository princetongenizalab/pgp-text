      "dc:source": "https://geniza.princeton.edu/sources/20/",
      "target": {
        "source": {
          "id": "http://cudl.lib.cam.ac.uk/iiif/MS-MOSSERI-II-00191/canvas/2",
          "type": "Canvas",
