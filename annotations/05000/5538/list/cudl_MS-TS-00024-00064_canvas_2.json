      "body": [
        {
          "type": "TextualBody",
          "label": "Verso, address, right column",
          "value": "\n<ol><li>\n<p>(To) His excellency, the most illustrious Sheikh, my master Ab\u016b Is\u1e25\u0101q</p>\n</li>\n<li>\n<p>Abraham, son of his honor, great and holy master Pera\u1e25y\u0101, the scribe,</p>\n</li>\n<li>\n<p>b. Yij\u016b&mdash;may God preserve his prosperous state!</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
