      "dc:source": "https://geniza.princeton.edu/sources/29/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-00010-J-00020-00012/canvas/2",
          "type": "Canvas",
          "partOf": {
