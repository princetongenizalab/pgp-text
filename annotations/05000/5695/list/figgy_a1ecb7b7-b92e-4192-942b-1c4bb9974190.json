    {
      "etag": "\"46a5dc495006f63e7d3dd8c9214e7c2f\"",
      "id": "https://geniza.princeton.edu/annotations/99d19a61-3d91-45ac-9719-11e2ddca2ebd/",
      "type": "Annotation",
      "created": "2026-08-14T14:43:22.589106+00:00",
