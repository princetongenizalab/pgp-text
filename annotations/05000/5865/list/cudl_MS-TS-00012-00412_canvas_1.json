      "modified": "2026-07-20T18:26:36.055503+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/20/",
      "target": {
        "source": {
          "id": "http://cudl.lib.cam.ac.uk/iiif/MS-TS-00012-00412/canvas/1",
          "type": "Canvas",
          "partOf": {
