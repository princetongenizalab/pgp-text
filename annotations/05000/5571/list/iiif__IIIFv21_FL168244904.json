    {
      "etag": "\"6b8db43685bb07d06add15a29300ddd8\"",
      "id": "https://geniza.princeton.edu/annotations/b6f1332f-dccb-4f43-ab5e-0ef06b3e0bce/",
      "type": "Annotation",
      "created": "2026-11-25T20:59:50.406104+00:00",
      "modified": "2026-11-25T20:59:50.406112+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/13/",
      "target": {
        "source": {
          "id": "https://iiif.nli.org.il/IIIFv21/FL168244904",
          "type": "Canvas",
          "partOf": {
            "id": "https://geniza.princeton.edu/documents/5571/iiif/manifest/"
