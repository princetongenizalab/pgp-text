    {
      "etag": "\"5ad9c0d65aca1941b399194aa8b5fce6\"",
      "id": "https://geniza.princeton.edu/annotations/842a99d2-03cb-4f47-9906-b21eb79205d7/",
      "type": "Annotation",
      "created": "2026-11-27T21:49:20.193001+00:00",
      "modified": "2026-11-27T21:49:20.193012+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/13/",
      "target": {
        "source": {
          "id": "https://iiif.nli.org.il/IIIFv21/FL168421816",
          "type": "Canvas",
          "partOf": {
            "id": "https://geniza.princeton.edu/documents/5578/iiif/manifest/"
