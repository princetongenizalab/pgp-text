      "body": [
        {
          "type": "TextualBody",
          "label": "recto, right [Arabic characters]",
          "value": "\n<ol><li>In the name of God the Merciful and Compassionate.</li>\n<li>[I have] sent a letter to my honourable master,</li>\n<li>the sublime elder.....</li>\n<li>may God prolong his life and cause to endure his support</li>\n<li>and exaltation</li></ol>\n",
