      "body": [
        {
          "type": "TextualBody",
          "label": "recto, column I",
          "value": "<p></p>\n\n<ol><li dir=\"ltr\">\n<p dir=\"ltr\">In the name (of God)</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">Friday the 8th of the month of</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">Av, may its mourning be turned into joy.</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">Dispensed to the poor, may God in his mercy</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">make them rich, [[six]] 4 and a half q\u012bntars (450 pounds)</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">of bread</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">the orphans of the astrologer 8 the man from Acre 6</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">Ab\u016b Kath\u012br 6 Noah 3 Sitt\u0101n 2</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">Ab\u016b Hil\u0101l 4 \u02bfAyy\u0101sh 3</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">Ibrah\u012bm of Tyre 4 the neighbor (f.) 2</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">the \u1e62\u016br\u0101n\u012b 6 the acquaintance of Ab\u016b Sur\u016br 4</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">Sam\u012b\u1e25, 4 Umm \u02bfUbayd 3</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">the children of the deaf man 8 Mub\u0101raka 4&nbsp;</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">the mother-in-law of Elia and the orphan boy 2 Elia 3</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">Elia \"the short\" 2 the orphans of the Karaite 2</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">the female washer of the dead of the R\u016bm 3 Rebecca 4</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">Umm Matatya 2 the acquaintance of the dyer 4</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">Ab\u016b Khal\u012bf the blind man 5 his in-law&nbsp;</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
