      "type": "Annotation",
      "created": "2025-08-22T17:29:36.414746+00:00",
      "modified": "2025-08-22T17:29:36.414755+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/20/",
      "target": {
        "source": {
          "id": "https://geniza.princeton.edu/documents/4300/iiif/textblock/29360/canvas/2/",
          "type": "Canvas",
          "partOf": {
            "id": "https://geniza.princeton.edu/documents/4300/iiif/manifest/"
