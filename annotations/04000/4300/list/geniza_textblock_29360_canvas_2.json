      "body": [
        {
          "type": "TextualBody",
          "label": "verso, left side",
          "value": "<p>\u05e1\u05e4\u05e8 \u05e2\u05dc \u05d4\u05dc\u05d5\u05dc\u05d1, \u05e9\u05de\u05e2\u05ea\u05d9 \u05e2\u05dc\u05d9\u05d5 \u05db\u05d1\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05db\u05df, \u05d5\u05d0\u05dd \u05de\u05e6\u05d5\u05d9 \u05d4\u05d5\u05d0 \u05d0\u05e6\u05dc\u05da, \u05d0\u05d3\u05d5\u05e0\u05d9 \u05d4\u05e8\u05d1, \u05d4\u05d5\u05d3\u05e2 \u05dc\u05d9 \u05d6\u05d0\u05ea \u05d2\u05dd \u05db\u05df, \u05d5\u05d2\u05dd \u05d0\u05dd \u05d4\u05d5\u05d0 \u05e9\u05d9\u05d9\u05da \u05dc\u05db\u05dc\u05dc \u05d4\u05e7\u05d5\u05e0\u05d8\u05e8\u05e1\u05d9\u05dd \u05d5\u05d4\u05e0\u05d9\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc\u05da. </p>\n<p>\u00a0</p>",
          "format": "text/html"
        }
