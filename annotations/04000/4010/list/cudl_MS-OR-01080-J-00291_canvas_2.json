      "body": [
        {
          "type": "TextualBody",
          "label": "verso, left column",
          "value": "<ol>\n<li><span lang=\"he\">\u05d5\u05dc\u05d6\u05db\u05d5\u05ea\u05dd \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\"\u05d3 \u05d5\u05d7\u05e6\u05d9, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e4\"\u05d7, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e4\"\u05d2 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d3' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e1\"\u05d2, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e2\"\u05d1.... \u05d3\u05e8\u05d4\u05de\u05d9\u05dd;&nbsp;</span></li>\n<li><span lang=\"he\">\u05e1\u05d4\"\u05db \u05d4\u05ea\u05de\u05d5\u05e8\u05d4, \u05e7\u05e0\"\u05d4 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8.... \u05d3\u05e8\u05d4\u05de\u05d9\u05dd.</span></li>\n<li><span lang=\"he\">\u05d5\u05dc\u05d6\u05db\u05d5\u05ea\u05dd \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\"\u05d3 \u05d5\u05d7\u05e6\u05d9, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e0\"\u05d6, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e1\"\u05d8 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d2' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd \u05d5\u05d7\u05e6\u05d9; \u05d5\u05e2\u05d5\u05d3 \u05ea\u05de\u05d5\u05e8\u05d4 \u05de\u05de\u05db\u05d9\u05e8\u05d4, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e0\"\u05d3, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e1\"\u05d6 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8;&nbsp;</span></li>\n<li><span lang=\"he\">\u05e1\u05d4\"\u05db \u05d4\u05ea\u05de\u05d5\u05e8\u05d4, \u05e7\u05dc\"\u05d5 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8, \u05d5\u05d2' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd \u05d5\u05d7\u05e6\u05d9.</span></li>\n<li><span lang=\"he\">\u05dc\u05d6\u05db\u05d5\u05ea\u05dd \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\"\u05d3, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e1\"\u05d3, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e2\"\u05d1 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8. \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\"\u05e6, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e4\"\u05d2 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8,&nbsp;</span></li>\n<li><span lang=\"he\">\u05e1\u05d4\"\u05db \u05d4\u05ea\u05de\u05d5\u05e8\u05d4, \u05e7\u05e0\"\u05d4 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8.&nbsp;</span></li>\n<li><span lang=\"he\">\u05dc\u05d6\u05db\u05d5\u05ea\u05dd \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\"\u05d3, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e2\"\u05d2, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e2\"\u05d4 \u05d5\u05d2' \u05d3\u05e8\u05d7\u05de\u05d9\u05dd \u05d5\u05d7\u05e6\u05d9; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e4\"\u05d1, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e4' \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05e4\u05d7\u05d5\u05ea \u05e7\u05d9\u05e8\u05d0\u05d8;&nbsp;</span></li>\n<li><span lang=\"he\">\u05e1\u05d4\"\u05db \u05d4\u05ea\u05de\u05d5\u05e8\u05d4, \u05de' \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d2' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd.</span></li>\n<li><span lang=\"he\">\u05dc\u05d6\u05db\u05d5\u05ea\u05dd \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\"\u05d3, \u05d4\u05de\u05e9\u05e7\u05dc \u05d2' \u05e7\u05e0\u05d8\u05d0\u05e8\u05d9\u05dd \u05d5\u05e0' \u05e8\u05d8\u05dc\u05d9\u05dd, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e7\u05e0\"\u05d2 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05e9\u05e0\u05d9 \u05d3\u05e8\u05d4\u05de\u05d9\u05dd.&nbsp;</span></li>\n<li><span lang=\"he\">\u05e9\u05dc \u05d0\u05e1\u05de\u05e2\u05d9\u05dc, \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\"\u05d0 \u05d5\u05d7\u05e6\u05d9, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e4\"\u05d4, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e2\"\u05d3 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05e9\u05e0\u05d9 \u05d3\u05e8\u05d4\u05de\u05d9\u05dd; \u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4, \u05d1\u05e2\u05d3 \u05de' \u05d5\u05d7\u05e6\u05d9, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e1\"\u05d2,&nbsp;</span></li>\n<li><span lang=\"he\">\u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e1\"\u05d4 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d4' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd; \u05e1\u05d4\"\u05db \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e7\u05dc\"\u05d8 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d6' \u05d3\u05e8\u05d4\u05de\u05d9\u05dd.</span></li>\n<li><span lang=\"he\">\u05dc\u05d6\u05db\u05d5\u05ea\u05dd \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\"\u05d3, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e2\"\u05d4, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e2\"\u05d6 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8. \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\"\u05d2, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e1\"\u05d6, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e2\"\u05d0 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8;&nbsp;</span></li>\n<li><span lang=\"he\">\u05e1\u05d4\"\u05db \u05d4\u05ea\u05de\u05d5\u05e8\u05d4, \u05e7\u05de\"\u05d7 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8.&nbsp;</span></li>\n<li><span lang=\"he\">\u05dc\u05d6\u05db\u05d5\u05ea\u05dd \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\"\u05d4, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e1\"\u05d0, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e2\"\u05d1 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4, \u05d1\u05de\"\u05d3 \u05d5\u05d7\u05e6\u05d9, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7' \u05d5\u05e9\u05e0\u05d9 \u05e8\u05d8\u05dc\u05d9\u05dd, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05de\"\u05d4 \u05d5\u05d3\u05e8\u05d4\u05dd;&nbsp;</span></li>\n<li><span lang=\"he\">\u05de\u05d4\u05dd \u05e4' \u05e8\u05d8\u05dc\u05d9\u05dd \u05e9\u05e0\u05e8\u05d8\u05d1\u05d5, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05dc\"\u05d2 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05e1\u05d4\"\u05db \u05d4\u05ea\u05de\u05d5\u05e8\u05d4, \u05e7\"\u05e0 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d3\u05e8\u05d4\u05dd.&nbsp;</span></li>\n<li><span lang=\"he\">\u05dc\u05d6\u05db\u05d5\u05ea\u05dd \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\"\u05d4 \u05d5\u05d7\u05e6\u05d9, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e1\"\u05d0, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e2\"\u05d5 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d3\u05e8\u05d4\u05dd \u05d5\u05d7\u05e6\u05d9; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4&hellip; \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e1\"\u05d1, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e1\"\u05d7 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8;&nbsp;</span></li>\n<li><span lang=\"he\">\u05de\u05d4\u05dd \u05db\"\u05d8 \u05e8\u05d8\u05dc\u05d9\u05dd \u05e9\u05e0\u05e8\u05d8\u05d1\u05d5, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05dc' \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8 \u05d5\u05d3\u05e8\u05d4\u05dd \u05d5\u05d7\u05e6\u05d9 .... \u05e4\u05d7\u05d5\u05ea \u05e9\u05de\u05d9\u05e0\u05d9\u05ea.</span></li>\n<li><span lang=\"he\">\u05dc\u05d6\u05db\u05d5\u05ea\u05dd \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\"\u05d2 \u05d5\u05d7\u05e6\u05d9, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e6\"\u05d4, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e4\"\u05d3 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4 ....;&nbsp;</span></li>\n<li><span lang=\"he\">\u05e1\u05d4\"\u05db \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e7\u05e0\"\u05d2 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8.</span></li>\n<li><span lang=\"he\">\u05dc\u05d6\u05db\u05d5\u05ea\u05dd \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\"\u05d4, \u05d4\u05de\u05e9\u05e7\u05dc \u05e7\u05e1\"\u05d6, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05e2\"\u05d4 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05d5\u05e2\u05d5\u05d3 \u05de\u05db\u05d9\u05e8\u05d4, \u05d1\u05de....;&nbsp;</span></li>\n<li><span lang=\"he\">\u05de\u05d4\u05dd \u05db\"\u05d2 \u05e8\u05d8\u05dc\u05d9\u05dd \u05e9\u05e0\u05e8\u05d8\u05d1\u05d5, \u05d4\u05ea\u05de\u05d5\u05e8\u05d4 \u05d7' \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8.</span></li>\n<li><span lang=\"he\">\u05d9\u05d4\u05d9\u05d4 \u05d4\u05e1\u05da \u05d4\u05db\u05d5\u05dc\u05dc \u05e9\u05dc \u05ea\u05de\u05d5\u05e8\u05ea \u05db\"\u05d2 (\u05d4\u05de\u05e9\u05d5\u05d0\u05d9\u05dd ?)&hellip;&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5&hellip; \u05d3\u05e8\u05d4\u05de\u05d9\u05dd \u05e4\u05d7\u05d5\u05ea \u05e9\u05de\u05d9\u05e0\u05d9\u05ea; \u05de\u05d6\u05d4 \u05d9\u05e9 \u05dc\u05e0\u05db\u05d5\u05ea&hellip;&nbsp;</span></li>\n<li><span lang=\"he\">\u05d5\u05e0\"\u05d3 \u05d3\u05e8\u05d4\u05de\u05d9\u05dd \u05d5\u05d7\u05e6\u05d9; \u05d3\u05de\u05d9 \u05ea\u05d9\u05d5\u05d5\u05da, \u05e0\"\u05d0 \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8&hellip;;&nbsp;</span></li>\n<li><span lang=\"he\">&hellip;\u05d5\u05db' \u05e8\u05d1\u05e2\u05d9 \u05d3\u05d9\u05e0\u05e8; \u05d9\u05d4\u05d9\u05d4 \u05e1\u05d4\"\u05db&hellip;;&nbsp;</span></li>\n<li><span lang=\"he\">&hellip;\u05d5\u05d1'\u05d5\u05e8\u05e7' \u05dc''\u05d5</span></li>\n</ol>",
          "format": "text/html"
        }
