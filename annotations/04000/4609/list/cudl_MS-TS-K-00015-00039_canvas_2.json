      "body": [
        {
          "type": "TextualBody",
          "label": "T-S K15.39, v, left [\"Col. III\" per Cohen]",
          "value": "\n<ol><li dir=\"ltr\">\n<p dir=\"ltr\">Ab\u016b Kath\u012br Umm Ibrahim</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">\u1e62adaqa \u1e62adaqa</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">Ma\u02bf\u0101l\u012b and his porter 5 the supervisor from Tiberias 6</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">the wife of the man from Sicily 4</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\"><del>amounting to 282</del>&nbsp; &nbsp; <del>something on it</del></p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">I put aside the ten old loaves for the R\u016bm so that the total is</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">two hundred</p>\n</li>\n<li dir=\"ltr\">\n<p dir=\"ltr\">seventy-two</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
