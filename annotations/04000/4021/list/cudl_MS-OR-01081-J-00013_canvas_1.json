      "dc:source": "https://geniza.princeton.edu/sources/1259/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-OR-01081-J-00013/canvas/1",
          "type": "Canvas",
