      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, right margin",
          "value": "\n<ol><li>&hellip; that her deferred marriage payment remain in [her] hand;</li>\n<li>that no work be demanded of her;</li>\n<li>and if she does work, her earnings belong to her;</li>\n<li>and he shall not have the right to say to her,</li>\n<li>\"Embroider in people's houses and bring me</li>\n<li>the proceeds,\" or anything similar.</li>\n<li>And to his excellency,</li>\n<li>may G[o]d perpetuate his majesty, belongs the exalted judgment</li>\n<li>in this matter.</li>\n<li>May your peace</li>\n<li>increase forever.</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 2
