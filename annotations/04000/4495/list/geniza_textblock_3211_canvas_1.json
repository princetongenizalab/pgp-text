      "body": [
        {
          "type": "TextualBody",
          "label": "recto, right margin",
          "value": "<p>and he worries for you\u2014may God almighty help you. I attached to this</p>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
