          "conformsTo": "http://www.w3.org/TR/media-frags/"
        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "Verso - address",
          "value": "<ol>\n<li>To my lord Ab\u016b Ya\u02bfq\u016bb Is\u1e25aq b. Ya\u02bfq\u016bb the \u1e25aver</li>\n<li>al-Maqdis\u012b</li>\n<li>may God prolong his existence and make [his glory] and support eternal</li>\n<li>from \u1e24ayyim b. Sal\u0101m</li>\n<li>Fustat, if God [wills]</li>\n<li>may it arrive in the D\u0101r al-\u1e62arf</li>\n</ol>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 2
    },
    {
      "etag": "\"757796ed5d7523b12962bfafdd382d1e\"",
      "id": "https://geniza.princeton.edu/annotations/68c69114-bdba-422e-8d43-b3f16a39695b/",
