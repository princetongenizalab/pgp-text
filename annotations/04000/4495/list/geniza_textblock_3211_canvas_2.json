      "dc:source": "https://geniza.princeton.edu/sources/29/",
      "target": {
        "source": {
          "id": "https://geniza.princeton.edu/documents/4495/iiif/textblock/3211/canvas/2/",
          "type": "Canvas",
          "partOf": {
