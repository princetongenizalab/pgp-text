          "value": "xywh=pixel:0,258.56640625,342.97265625,251.43359375",
          "conformsTo": "http://www.w3.org/TR/media-frags/"
        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "address",
          "value": "<p>To my lord, Abu\u0304 Ya\u2018qu\u0304b Is\u0323\u1e25a\u0304q ibn Ya\u2018qu\u0304b the \u1e25aver.</p>\n<p>From H\u0323ayim ben Solomon the Jerusalemite.</p>\n<p>[Send to] Fust\u0101t, God willing.</p>\n<p>May God lengthen the remaining [days of your life] and make permanent your strength and your favor.</p>\n<p>Send to the Da\u0304r al-s\u0323arf [House of Money Changing].</p>\n<p></p>",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 2
    },
    {
