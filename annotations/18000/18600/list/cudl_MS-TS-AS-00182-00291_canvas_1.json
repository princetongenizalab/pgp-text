      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<ol>\n<li>\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645&nbsp;</li>\n<li>\u0645\u0627 \u064a\u0642\u0648\u0644 \u0627\u0644\u0633\u0627\u062f\u0629 \u0627\u0644\u0641\u0642\u0647\u0627 \u0627\u0644\u0627\u0626\u0645\u0629 \u0627\u0626\u0645\u0629 \u0627\u0644\u062f\u064a\u0646 \u0648\u0642\u062f\u0648\u0629</li>\n<li>\u0627\u0644\u0645\u0633\u0644\u0645\u064a\u0646 \u0648\u0641\u0642\u0647\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0637\u0627\u0639\u062a\u0640\u0640\u0640\u0640[\u0640\u0640\u0647\u0640\u0640\u0640\u0640]\u0640\u0640\u0640\u0640\u0640\u0645 \u0648\u0627\u0639\u0627\u0646\u0647\u0645 \u0639\u0644\u0649 \u0645\u0631\u0636\u0627\u062a\u0647</li>\n<li>\u0641\u064a \u062c\u0645\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u064a\u0647\u0648\u062f \u0627\u0644\u0630\u064a\u0646 \u064a\u0631\u062c\u0639 \u0627\u0644\u064a\u0647\u0645 \u0627\u0644\u0643\u0644\u0645\u0629 \u0648\u0647\u0645</li>\n<li>\u0631\u0626\u064a\u0633 \u0627\u0644\u064a\u0647\u0648\u062f \u0648 \u0645\u0646 \u062a\u0628\u0639\u0647 \u0645\u0646 \u0639\u0644\u0645\u0627\u0626\u0647\u0645 \u0627\u062b\u0628\u062a\u0648\u0627 \u0627\u0644\u0631\u0643\u0648\u0639 \u0648 \u0627\u0644\u0633\u062c\u0648\u062f</li>\n<li>\u0641\u064a \u062f\u064a\u0646\u0647\u0645 \u0648\u0642\u0627\u0644\u0648\u0627 \u0627\u0646 \u0630\u0644\u0643 \u0643\u0627\u0646 \u0645\u0646 \u0634\u0631\u0639\u0647\u0645 \u0642\u062f\u064a\u0645 \u0641\u0627\u0642\u0627\u0645\u0648\u0627</li>\n<li>\u0645\u0627 \u0643\u0627\u0646 \u062f\u0627\u062b\u0631 \u0645\u0646 \u062f\u064a\u0646\u0647\u0645 \u0648 \u0627\u062b\u0628\u062a\u0648\u0627 \u0648 \u0639\u0644\u0645\u0648\u0627 \u0628\u0647 \u0645\u062f\u0629 \u0633\u0646\u064a\u0646</li>\n<li>\u0645\u062a\u0637\u0627\u0648\u0644\u0629 \u0646\u062d\u0648 \u0639\u0634\u0631\u064a\u0646 \u0633\u0646\u0629 \u0641\u0644\u0645\u0627 \u0645\u0627\u062a \u0627\u0644\u0631\u0626\u064a\u0633 \u0627\u0644\u0630\u0649 \u0644\u0647\u0645 \u0642\u0627\u0645</li>\n<li>\u0645\u0646 \u0644\u064a\u0633 \u0647\u0648 \u0645\u0646 \u0627\u0647\u0644 \u0627\u0644\u0639\u0644\u0645 \u062a\u0643\u0644\u0645 \u0639\u0644\u0649 \u062e\u0644\u0627\u0641 \u0645\u0646 [ [\u0627] ] \u062a\u0642\u062f\u0645</li>\n<li>\u0645\u0646 \u0639\u0644\u0645\u0627\u0626\u0647\u0645 \u0648 \u0627\u0646\u0643\u0631 \u0627\u0644\u0631\u0643\u0648\u0639 \u0648 \u0627\u0644\u0633\u062c\u0648\u062f \u0645\u0627\u0630\u0627 \u064a\u0644\u0632\u0645\u0647</li>\n<li>\u0639\u0644\u0649 \u0645\u062e\u0627\u0644\u0641\u062a\u0647 \u0627\u0646 \u0643\u0627\u0646 \u064a\u062e\u0627\u0644\u0641 \u0627\u0641\u062a\u0648\u0646\u0627 \u064a\u0631\u062d\u0645\u0643\u0645 \u0627\u0644\u0644\u0647</li>\n</ol>",
