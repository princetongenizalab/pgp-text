      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<p><i>Registration mark on right</i></p>\n<p><i></i></p>\n\n<ol><li>Let it be registered on behalf of the office of supervision,</li>\n<li>if God wills.</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
