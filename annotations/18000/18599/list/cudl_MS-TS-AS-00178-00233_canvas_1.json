      "dc:source": "https://geniza.princeton.edu/sources/135/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-AS-00178-00233/canvas/1",
          "type": "Canvas",
          "partOf": {
