      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "<ol>\n<li>\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0627\u0644\u0645\u0645\u0644\u0648\u0643&nbsp;</p>\n</li>\n<li>\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0639\u0628\u062f \u0627\u0644\u0628\u0627\u0642\u0649 \u0628\u0646 \u064a\u062d\u064a\u0649 \u0627\u0644\u064a\u0647\u0648\u062f\u0649&nbsp;</p>\n</li>\n<li>\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u0627\u0644\u0645\u0642\u064a\u0645 \u0628\u0644\u0645\u0644\u064a\u062c</p>\n</li>\n<li>\n<p>\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645&nbsp;</p>\n</li>\n<li>\n<p>\u062e\u0644\u062f \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0645\u0644\u0643 \u0627\u0644\u0645\u062c\u0644\u0633 \u0627\u0644\u0639\u0627\u0644\u0649 \u0627\u0644\u0633\u0627\u0645\u0649 \u0627\u0644\u0633\u064a\u062f\u064a \u0627\u0644\u0627\u062c\u0644\u064a \u0627\u0644\u0645\u0644\u0643 \u0627\u0644\u0646\u0627\u0635\u0631&nbsp;</p>\n</li>\n<li>\n<p>\u062c\u0627\u0645\u0639 \u0643\u0644\u0645\u0629 \u0627\u0644\u0627\u064a\u0645\u0627\u0646 \u0642\u0627\u0645\u0639 \u0639\u0628\u062f\u0629 \u0627\u0644\u0635\u0644\u0628\u0627\u0646 \u0635\u0644\u0627\u062d \u0627\u0644\u062f\u0646\u064a\u0627 \u0648\u0627\u0644\u062f\u064a\u0646</p>\n</li>\n<li>\n<p>\u0633\u0644\u0637\u0627\u0646 \u0627\u0644\u0627\u0633\u0644\u0627\u0645 \u0648\u0627\u0644\u0645\u0633\u0644\u0645\u064a\u0646 \u0645\u062d\u064a\u0649 \u062f\u0648\u0644\u0629 \u0627\u0645\u064a\u0631 \u0627\u0644\u0645\u0648\u0645\u0646\u064a\u0646 \u0648\u0627\u062f\u0627\u0645 \u0642\u062f\u0631\u062a\u0647</p>\n</li>\n<li>\n<p>\u0648\u0627\u0639\u0644\u0627 \u0643\u0644\u0645\u062a\u0647&nbsp; &nbsp; \u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u064a\u0642\u0628\u0644 \u0627\u0644\u0627\u0631\u0636 \u0648\u064a\u0646\u0647\u0649 \u0627\u0646\u0647 \u0631\u062c\u0644 \u0635\u0639\u0644\u0648\u0643</p>\n</li>\n<li>\n<p>\u0630\u0648 \u0639\u0627\u0626\u0644\u0629 \u0648\u0627\u0637\u0641\u0627\u0644 \u064a\u062a\u0645\u0639\u0634 \u0628\u064a\u0646 \u0638\u0647\u0648\u0631 \u0627\u0644\u0645\u0633\u0644\u0645\u064a\u0646 \u0628\u0645\u0644\u064a\u062c \u0628\u0627\u0639\u0645\u0627\u0644 \u0627\u0644\u063a\u0631\u0628\u064a\u0629</p>\n</li>\n<li>\n<p>\u0648\u064a\u0642\u0648\u0645 \u0628\u062c\u0632\u064a\u062a\u0647 \u0627\u0644\u0648\u0627\u062c\u0628\u0629 \u0639\u0644\u064a\u0647 \u0648\u0645\u0627 \u0628\u064a\u0646\u0647 \u0648\u0628\u064a\u0646 \u0627\u062d\u062f \u0645\u0639\u0627\u0645\u0644\u0629 \u0627\u0644\u0627 \u064a\u0633\u0644 \u0627\u0644\u062e\u064a\u0631</p>\n</li>\n<li>\n<p>\u0648\u0642\u062f \u0642\u0635\u062f \u0641\u0649 \u0647\u0630\u0627 \u0627\u0644\u0648\u0642\u062a \u0628\u0644\u0627\u0636\u0631\u0627\u0631 \u0648\u0627\u0644\u0627\u0630\u064a\u0629 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0641\u0649&nbsp;</p>\n</li>\n<li>\n<p>\u0627\u0644\u062c\u0648\u0627\u0644\u0649 \u0648\u0646\u0632\u0642\u0648\u0627 \u0645\u0646\u0647 \u0627\u0646 \u0628\u064a\u0637\u0644\u0648\u0647 \u0639\u0646 \u0645\u0639\u064a\u0634\u062a\u0647 \u0648\u064a\u062c\u0639\u0644\u0648\u0647 \u062c\u0627\u0628\u0649 \u0644\u0647\u0645&nbsp;</p>\n</li>\n<li>\n<p>\u0648\u0645\u0639\u0631\u0641 \u0648\u0644\u0645 \u062a\u062c\u0631 \u0628\u0630\u0644\u0643 \u0639\u0627\u062f\u0629 \u0639\u0644\u064a\u0647 \u0645\u0646 \u0642\u0637 \u0645\u0646 \u0633\u062a\u064a\u0646 \u0633\u0646\u0629 \u0648\u0627\u0644\u0649 \u0627\u0644\u0627\u0646&nbsp;</p>\n</li>\n<li>\n<p>\u0648\u0639\u062f\u0644 \u0627\u0644\u0645\u0648\u0644\u0627 \u064a\u0645\u0646\u0639 \u0645\u0646 \u0627\u0636\u0631\u0627\u0631\u0647 \u0648\u062a\u0628\u0637\u064a\u0644\u0647 \u0639\u0646 \u0645\u0639\u064a\u0634\u062a\u0647 \u0648\u064a\u0633\u0644&nbsp;</p>\n</li>\n<li>\n<p>\u0641\u0649 \u062e\u0631\u0648\u062c \u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0639\u0627\u0644\u0649 \u0632\u0627\u062f\u0647 \u0627\u0644\u0644\u0647 \u0646\u0641\u0627\u0630\u0627 \u0627\u0644\u0649 \u0643\u0627\u0641\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0641\u0649&nbsp;</p>\n</li>\n<li>\n<p>\u062c\u0628\u0627\u064a\u0629 \u0627\u0644\u062c\u0648\u0627\u0644\u0649 \u0628\u0627\u0639\u0645\u0627\u0644 \u0627\u0644\u063a\u0631\u0628\u064a\u0629 \u0628\u0627\u0632\u0627\u0644\u0629 \u0627\u0644\u0627\u0639\u062a\u0631\u0627\u0636 \u0639\u0646\u0647 \u0648\u0644\u0627 \u064a\u062d\u062f\u062b \u0639\u0644\u064a\u0647</p>\n</li>\n<li>\n<p>\u062d\u0627\u062f\u062b \u0648\u062d\u0645\u0644\u0647 \u0641\u064a\u0645\u0627 \u0627\u0646\u0628\u0627\u0647 \u0639\u0644\u0649 \u0642\u0636\u064a\u0629 \u0627\u0644\u0639\u062f\u0644 \u0648\u0627\u0644\u0627\u0646\u0635\u0627\u0641</p>\n</li>\n<li>\n<p>\u0644\u064a\u062c\u062f \u0627\u0644\u0633\u0628\u064a\u0644 \u0627\u0644\u0649 \u0645\u0642\u0627\u0645\u0647 \u0628\u0648\u0637\u0646\u0647 \u0648\u0639\u0627\u0626\u0644\u062a\u0647 \u0648\u0627\u0637\u0641\u0627\u0644\u0647 \u0648\u064a\u0642\u0631 \u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0639\u0627\u0644\u0649 \u0628\u064a\u062f\u0647</p>\n</li>\n<li>\n<p>\u0627\u0646\u0639\u0627\u0645\u0627 \u0639\u0644\u064a\u0647 \u0648\u0627\u062d\u0633\u0627\u0646\u0627 \u0627\u0644\u064a\u0647&nbsp;</p>\n</li>\n<li>\n<p>\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0648\u062d\u062f\u0647 \u0648\u0635\u0644\u0648\u0627\u062a\u0647 \u0639\u0644\u0649 \u0633\u064a\u062f\u0646\u0627 \u0645\u062d\u0645\u062f \u0646\u0628\u064a\u0646\u0627 \u0648\u0633\u0644\u0645 \u062a\u0633\u0644\u064a\u0645\u0627</p>\n</li>\n</ol>",
          "format": "text/html"
        }
      ],
