      "modified": "2026-07-27T16:54:51.107913+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/135/",
      "target": {
        "source": {
          "id": "https://cudl.lib.cam.ac.uk/iiif/MS-TS-K-00002-00096/canvas/2",
          "type": "Canvas",
          "partOf": {
