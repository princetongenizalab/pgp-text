    {
      "etag": "\"bb75f6a1c47a5a891ad33041bf611b3e\"",
      "id": "https://geniza.princeton.edu/annotations/8242b890-b574-423c-a50e-c93814e667ed/",
      "type": "Annotation",
      "created": "2026-03-18T02:01:57.115712+00:00",
