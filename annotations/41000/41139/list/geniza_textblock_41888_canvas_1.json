        "selector": {
          "type": "FragmentSelector",
          "value": "xywh=pixel:73,203,329,117",
          "conformsTo": "http://www.w3.org/TR/media-frags/"
        }
      },
      "body": [
        {
          "type": "TextualBody",
          "label": "Witness clauses",
          "value": "\n<ol><li>Y\u016bsuf ibn Tam\u012bm testified to the acknowledgement by the sellers named in the contract and to the receipt of the price. This has been written on his behalf by his instruction and in his presence.</li>\n<li>Naw\u0101l ibn Jaw\u0101b testified to the acknowledgement by the sellers and the buyer of what is herein. This has been written by his instruction and in his presence.</li>\n<li>&lsquo;Al\u012b ibn Mu\u1e25ammad al-\u1e24ij\u0101z\u012b testified to the acknowledgement by the sellers and the buyer of what is herein. This has been written by his instruction and in his presence.</li>\n<li>M\u016bs\u0101 [&hellip;] testified to all that is contained in this document and wrote by his hand.</li>\n<li>Ya&lsquo;q\u016bb ibn Mahdi testified to all of what is in this document and wrote by his hand.</li>\n<li>&lsquo;Abdull\u0101h ibn Mahd\u012b testified to the acknowledgement by the sellers and the buyer of what is herein and wrote by his hand on its date.</li>\n<li>\u1e62afw\u0101n ibn Sulaym\u0101n testified to all of what is in this document and wrote by his hand.</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
