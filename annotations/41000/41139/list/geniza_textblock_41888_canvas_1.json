      "type": "Annotation",
      "created": "2025-12-18T17:32:47.146574+00:00",
      "modified": "2025-12-18T17:32:47.146584+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/1212/",
      "target": {
        "source": {
          "id": "https://geniza.princeton.edu/documents/41139/iiif/textblock/41888/canvas/1/",
          "type": "Canvas",
          "partOf": {
