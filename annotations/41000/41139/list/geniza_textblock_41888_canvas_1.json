    {
      "etag": "\"4e06a228d8d1a99ef77230ec165ea7f4\"",
      "id": "https://geniza.princeton.edu/annotations/7abcd425-eca4-496e-a110-a9f752a4f6e5/",
      "type": "Annotation",
      "created": "2025-12-18T17:33:31.659236+00:00",
      "modified": "2025-12-18T17:33:31.659251+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/1212/",
      "target": {
        "source": {
          "id": "https://geniza.princeton.edu/documents/41139/iiif/textblock/41888/canvas/1/",
          "type": "Canvas",
