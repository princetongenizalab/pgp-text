          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\n\u0644\u0643\u0631\u064a\u0645(\u061f) \u064a\u062d\u0642(\u061f) \u0627\u0644\u062e\u062f\u0645\u0629 (\u061f).......\n</li>\n<li dir=\"rtl\">\n\u0648\u0645\u0646\u0639 \u0627\u0644\u0639\u0640[..]\u0645\u0627 \u0645\u0646 \u0627\u0644\u062a\u0639\u0631\u0641 (\u061f).....[..]....\n</li>\n<li dir=\"rtl\">\n\u0639\u0646 \u062d\u0642 \u0627\u0644\u0634\u064a\u062e (\u061f) \u0648\u0645\u062d\u0645\u062f \u0641\u064a..[..]....\u0641\u0647\u0645\u0627 (\u061f)..\n</li>\n<li dir=\"rtl\">\n\u0641\u0639\u0644\u0645\u062a (\u061f) \u0628\u062d\u0633\u0646 (\u061f) \u0641\u064a \u0627\u0644\u0627\u2026.[\n</li>\n<li dir=\"rtl\">\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0639\u0644\u0649 \u0627\u0644\u0627[\u0626\u0647\u061f\n</li>\n<li dir=\"rtl\">\n\u0644\u064a\u062d\u0645\u0644 (\u061f)\u00a0\n</li>\n<li dir=\"rtl\">\n\u0648\u0639\u0644\u0649\u061f\u2026\u0645\u0646 \u062b\u063a\u0631 \u062f\u0645\u064a\u0627\u0637 \u062d\u0645\u0627\u0647 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649\n</li>\n<li dir=\"rtl\">\n\u0648\u0627\u064a\u062f\u0647 \u0648\u0627\u0644\u0639\u0627[\u0641\u064a\u0629\u061f\u2026.] \u062d\u0645\u0644\u2026.\u00a0\n</li>\n<li dir=\"rtl\">\n\u0648\u2026 \u0639\u0644\u0649 \u0645\u0627 \u062a\u0636\u0645\u0646\u0647\u2026\u0639\u0644\u064a\u0647 \u0645\u0646 \u0627\u0644\u0639\u0644\u0645\n</li></ol>\n",
