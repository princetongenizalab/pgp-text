          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\n<p dir=\"rtl\">\u0648\u0635\u0648\u0644</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0644\u0645\u0642\u0637\u0639 \u0627\u0644\u0645\u062d\u062c\u0631\u0629(\u061f) \u0645\u0646 \u062c\u0645\u0644\u0629 \u0645\u0627 \u0639\u0644\u064a\u0647 \u0645\u0646 \u0645\u0627\u0644 \u0627\u0644\u062c\u0633\u0648\u0631</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u062b\u0644\u062b\u0629 \u0648\u062b\u0644\u0627\u062b\u064a\u0646(\u061f).....</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0645\u0646 \u062c\u0645\u0644\u0629</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0645\u0646 \u0627\u0644\u062a\u0635\u0631\u0641 \u0648\u0636\u0645\u0627\u0646(\u061f) \u0627\u0644\u0639\u0645\u0644</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u062e\u0630 \u0628\u0627\u0633\u0645 \u0636\u0645\u0646\u0627 \u0628\u0631\u0637\u0633 \u0645\u0646 \u062c\u0645\u0644\u0629\u2026\u0641\u064a</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0639\u0644\u064a\u0647\u0645 \u0627\u0644\u0646\u0627\u062d\u064a\u0629(\u061f) \u0633\u0646\u0629 \u0627\u0631\u0628\u0639 \u0648\u0633\u0628\u0639\u064a\u0646 \u0648\u0627\u0631\u0628\u0639 \u0645\u0627\u064a\u0629 \u0627\u0644\u062e\u0631\u0627\u062c\u064a\u0629</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0645\u0627 \u0644\u0645\u062d\u0645\u062f \u0628\u0646 \u0639\u0644\u064a(\u061f) \u0645\u0627 \u0639\u062f\u0627\u2026.\u0627\u0644\u0645\u0635\u0627\u0645\u062f\u0629</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0639\u0646</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0648\u0627\u062b\u0646\u062a\u064a\u0646 \u0648\u0633\u0628\u0639\u064a\u0646 \u0648\u0627\u0631\u0628\u0639 \u0645\u0627\u064a\u0629</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u00a0\u062a\u0641\u0635\u064a\u0644 \u0630\u0644\u0643</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u00a0\u0648\u0635\u0648\u0644</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0628\u0627\u0633\u0645 \u0627\u0644\u0627\u0639\u0631\u0627\u0628\u064a\u0