    {
      "etag": "\"77c63c5257f139e0dcf22e182717c7f5\"",
      "id": "https://geniza.princeton.edu/annotations/82c96d6f-3480-4034-94d8-f4244811a2f2/",
      "type": "Annotation",
      "created": "2026-04-03T19:01:45.251298+00:00",
