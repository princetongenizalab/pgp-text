      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>[&hellip;] against him and in his anger he assailed him and his late father</li>\n<li>with a curse. [Instruct us,] our master,</li>\n<li>to what penalty is he liable for having defamed him (=the complainant) with</li>\n<li>slander? And may he (= you) be granted a double reward by heaven.</li>\n<li>The answer:</li>\n<li>If he cursed him or his father (?) in [&hellip;]</li>\n<li>even if in [&hellip;], he is liable to punishment by lashes</li>\n<li>and if &hellip; he should be beaten</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
