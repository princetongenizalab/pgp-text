      "body": [
        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li>Heaven</li>\n<li>I, Maslia\u1e25 b. Nissim, wrote this</li>\n<li>in my own hand and proofread and compared it with an accurate copy</li>\n<li>on Wednesday, 2nd of the month</li>\n<li>of Tammuz&mdash;may the Omnipresent blessed be He change it into a time of joy</li>\n<li>and happiness&mdash;in the year one thousand, four five</li>\n<li>hundred and four, Era of the Documents, which we use customarily</li>\n<li>for dating, in the city of Cairo, located</li>\n<li>on the Nile. Peace.</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
