          "type": "TextualBody",
          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\n\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645 \u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0648\u062d\u062f\u0647\n</li>\n<li dir=\"rtl\">\n\u0645\u0644\u0643\u062a \u0627\u062e\u064a\u0648\u0647 \u0627\u0644\u0645\u0631\u0627\u0629 \u0627\u0644\u064a\u0647\u0648\u062f\u064a\u0629 \u0627\u0644\u0631\u0628\u0627\u0646\u064a\u0629 \u0627\u0628\u0646\u0629 \u0633\u0639\u064a\u062f [\n</li>\n<li dir=\"rtl\">\n\u0639\u062c\u0648\u0632 \u0633\u0645\u0631 \u0627\u0644\u0644\u0648\u0646 \u0642\u0635\u0631\u0629 \u0627\u0644\u0642\u0627\u0645\u0629 \u062e\u0641\u064a\u0629 \u0627\u0644\u0642\u0631\u0646 \u0633\u0647\u0644\u0627 \u0627\u0644\u0639\u064a\u0646 \u2026\u2026\n</li>\n<li dir=\"rtl\">\n\u0641\u064a \u0627\u0644\u0639\u0637\u0631 \u0648\u0641\u064a \u0627\u0644\u062f\u0647\u0646 \u0627\u0644\u0644\u0648\u0632 \u0628\u0627\u0644\u0642\u0627\u0647\u0631\u0629 \u0627\u0644\u0645\u062d\u0631\u0648\u0633\u0629 \u0627\u0644\u0634\u0647\u064a\u0631 \u0628\u0627\u0649\u0640[\n</li>\n<li dir=\"rtl\">\n\u062c\u0645\u064a\u0639 \u0627\u0644\u062f\u0627\u0631 \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u0627\u0648\u0635\u0627\u0641 \u0628\u0646\u0627 \u0627\u0644\u0627\u062a\u064a.[\n</li>\n<li dir=\"rtl\">\n\u0631\u0642\u0627 \u0633\u0644\u0637\u0627\u0646\u064a\u0627 \u0645\u0648\u0631\u062e\u0627 \u0628\u062a\u0627\u0633\u0639 \u0639\u0634\u0631 \u0645\u0646 \u0634\u0639\u0628\u0627\u0646 [\u0627\u0644\u0643\u0631\u064a\u0645\n</li>\n<li dir=\"rtl\">\n\u0627\u0644\u0646\u0635\u0641 \u0648\u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0646\u064a \u0645\u0646 \u0630\u0644\u0643 \u0648\u0641\u0642\u0627 \u0633\u0640[\u0640\u0646\u0629\n</li>\n<li dir=\"rtl\">\n\u0627\u0644\u0645\u0648\u0631\u062e \u0627\u0639\u0644\u0627\u0647 \u0648\u0630\u0644\u0643[\n</li>\n<li dir=\"rtl\">\n\u0627\u0644\u064a\u0647 \u0628\u0639\u0640[]\u00a0 \u0647\u0630\u0647 \u0627\u0644\u062f\u0627\u0631 \u0642\u062f\u064a\u0645\u0627[\n</li>\n<li dir=\"rtl\">\n\u062e\u0631\u0627\u0628 \u0645\u0631\u0627\u0641\u0642 \u0648\u0633\u0642\u0648\u0641 \u0648[\n</li>\n<li dir=\"rtl\">\n\u0633\u0644\u0645 \u062a\u0635\u0639\u062f \u0639\u0644\u0640[\n</li>\n<li dir=\"rtl\">\n\u0628\u0647\u0627 \u0633\u0644\u0645 \u062d\u0633\u0640[\n</li>\n<li dir=\"rtl\">\n\u00a0\u0644\u0630\u0644\u0643 \u0648\u0644\u0644\u0640[\n</li>\n<li dir=\"rtl\">\n\u0648\u0627\u0644\u0640[\n</li></ol>\n",
