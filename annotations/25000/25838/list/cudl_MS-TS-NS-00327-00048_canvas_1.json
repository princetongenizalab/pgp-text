          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\n........\n</li>\n<li dir=\"rtl\">\n]\u0631\u0641\u0642 \u0648\u0644\u0627 \u0646\u0637\u0642 \u0646\u0627\u0637\u0642 \u0627\u0644\u0627 \u0648\u0643\u062a\u0628\u064a \u0644\u0647 \u0645\u062a\u0648\u0627\u062a\u0631\u0629 \u0648\u0646\u062d\u0648\u0647 \u0645\u0642\u0627\u0637\u0631\u0629 \u063a\u064a\u0631[\n</li>\n<li dir=\"rtl\">\n\u0632\u0627\u0626\u0641(\u061f) \u0627\u0644\u0628\u0631 \u0641\u064a\u0647 \u0645\u0646 \u0627\u0644\u0627\u0645\u0644\u0627\u0643 \u0627\u0648\u062c\u0628 \u0648\u062d\u0630\u0641 \u0627\u0644\u0632\u064a\u0627\u062f\u0629 \u0639\u0646 \u0627\u0644\u0627\u0633\u0639\u0627\u0631 \u0627\u0635\u0648[\n</li>\n<li dir=\"rtl\">\n\u0639\u0647\u062f\u062a \u063a\u0644\u0629 \u0627\u0644 \u0648\u0628\u0627\u0644\u062c\u0645\u0644\u0629 \u0641\u0627\u0645\u0627 \u0627\u0633\u062a\u0627\u0630\u0627\u0646 \u062d\u0636\u0631\u062a\u0647 \u062d\u0631\u0633\u0647\u0627 \u0627\u0644\u0644\u0647 \u0641\u064a \u0645\u0648\u0627\u0635\u0644\u0640[\n</li>\n<li dir=\"rtl\">\n\u0634\u064a \u0627\u0644\u064a\u0647\u0627 \u0627\u064a\u0631\u0627\u062f\u0647\u0627 \u0641\u064a \u0643\u0644 \u062d\u064a\u0646 \u0639\u0644\u064a\u0647\u0627 \u0648\u0627\u062e\u0645\u0627\u0633(\u061f) \u0639\u0644\u0649 \u0628\u0627\u0644\u0627\u0645\u0631 \u0645\u0646 \u0635\u0644\u062a\u0647 \u0648\u0627\u062e\u0644\u0627\u0641\u0647\n</li>\n<li dir=\"rtl\">\n\u0645\u0646 \u0627\u0644\u0645\u0648\u0627\u0635\u0644\u0629 \u0641\u064a \u0643\u0644 \u0627\u0648\u0627\u0646 \u0628\u0643\u062a\u0628\u0647 \u0627\u0644\u0645\u0636\u0645\u0646\u0629 \u0627\u0648\u0627\u0645\u0631\u0647 \u0648\u062d\u0631\u0627\u0633\u062a\u0647 \u0648\u062a\u0639\u0631\u064a\u0636\u064a \u0644\u0645\u0627 \u064a\u0639\u0631\u0636\n</li>\n<li dir=\"rtl\">\n\u0645\u0646 \u0645\u0647\u0645\u0644\u0629 \u0644\u0627 \u0634\u0631\u0643\u0629(\u061f) \u0639\u0644\u064a\u0647 \u0644\u0643 \u064a\u062a\u0635\u0644 \u0645\u0646 \u0627\u0644\u062c\u0627\u0631\u064a \u0628\u0645\u0627 \u0627\u0646\u0639\u0645 \u0628\u0647 \u0639\u0644\u064a\u0647 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647\n</li>\n<li dir=\"rtl\">\n\u0627\u0633\u0644\u0647 \u0627\u0646 \u0634\u0627 \u0627\u0644\u0644\u0647 \u0639\u0632\u0648\u062c\u0644(\u061f)......\u0641\u064a ......\u064a\u062f \u0645\u0648\u0644\u0627\u064a \u0627\u0644\u0634\u064a\u062e \u0627\u0644\u0633\u064a\u062f \u0627\u0644\u0645\u0640[\n</li>\n<li dir=\"rtl\">\u0627\u0628\u064a \u0627\u0644\u0641\u0631\u062c \u0645\u0631\u0642\u0627\u062f \u0628\u0646 \u0627\u0633\u062f \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647 \u0648\u0627\u062f\u0627\u0645 \u0639\u0644\u0627\u064a\u0647 \u0648\u064a\u0633\u0627\u0639\u062f\u0647 \u0648\u062a\u0639\u0631\u064a\u0641\u0647 \u0633\u0640[</li>\n<li dir=\"rtl\">]\u0648\u0627\u0635\u0644\u064a \u0639\u0644\u0649 \u0627\u0644\u0641\u0627\u064a\u062a \u0645\u0646 \u0627\u0644\u062d\u0636\u0648\u0631 \u0628\u062d\u0636\u0631\u062a\u0647 \u0648\u0627\u0644\u0644\u0647 \u064a\u0633\u0647\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639 \u0628\u0647\u0627 ..[</li>\n<li dir=\"rtl\">\u0639\u0644\u0649 \u0627\u0633\u0631 \u062d\u0627\u0644 \u0628\u0645\u0646\u0647 \u0648[]\u0647 \u0627\u0644\u0649 []\u0640\u0635\u0644 \u0645\u0648\u0644\u0627\u064a \u0627\u064a\u062f\u0647 \u0627\u0644\u0644\u0647[</li>\n<li dir=\"rtl\">\u0641\u064a \u0628\u064a\u062a \u0627....\u0627\u0639\u062a\u0645\u062f...\u0645\u062a\u0648\u0644\u0627\u062a..</li>\n<li dir=\"rtl\">\u0627\u0644\u0637\u0648\u064a\u0644\u0629 \u0641\u064a ...\u0648\u0627\u0644\u0627\u062e\u0631 \u0648\u062e\u0627\u0646\u0647 \u0627[</li>\n<li dir=\"rtl\">\u0628\u0635\u0648.....</li>\n<li dir=\"rtl\">\u0639\u0645\u0631\u0627\u0646 ....[].......</li>\n<li dir=\"rtl\">....[</li></ol>\n",
