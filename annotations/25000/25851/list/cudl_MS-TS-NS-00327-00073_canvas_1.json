          "value": "\n<ol><li dir=\"rtl\">\n\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645\n</li>\n<li dir=\"rtl\">\n\u062a\u0627\u062e\u0631\u062a \u0639\u0646\u064a \u0627\u062e\u0628\u0627\u0631 \u062d\u0636\u0631\u0629 \u0648\u0633\u062c\u0644\u0627\u062a \u0627\u0644\u0639\u0627\u0644\u064a\u0629 \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647\u0627 \u0648\u062d\u0631\u0633 \u0639\u0632\u062a\u0647\u0627[\n</li>\n<li dir=\"rtl\">\n\u0648\u0627\u0634\u063a\u0644 [ \u00a0 ]...\u0644\u062d\u0636\u0648\u0631 \u0633\u0644\u0627\u0645\u062a\u0647 \u0645\u0646\u0639\u0645 \u0639\u0628\u062f\u2026 \u064a\u062d\u0644 \u0647\u0630\u0647 \u0627\u0644\u062e\u062f\u0645\u0629\u2026[\n</li>\n<li dir=\"rtl\">\n\u0645\u0627 \u0647\u064a \u0639\u0644\u064a\u0647 \u0627\u0637\u0645\u0646\u0627\u0646 \u0642\u0644\u0628\u064a \u0648\u0643\u0627\u0646 \u0627\u0644\u2026 \u0627\u0644\u0643\u062a\u0627\u0628(\u0627\u0644\u0643\u062a\u0645\u0627\u0646\u061f) \u0639\u0644\u0649 \u064a\u062f \u0646\u0627\u0635\u0631 \u0627\u0644\u063a\u0644\u0627\u0645 \u0627\u0644\u0630\u064a \u0643\u0627\u0646\n</li>\n<li dir=\"rtl\">\n\u064a\u062e\u062f\u0645 \u0645\u0639 \u0627\u0644\u0645\u0648\u0644\u0649 \u0627\u0644\u0627\u062c\u0644 \u0627\u0644\u0634\u064a\u062e \u0627\u0644\u0631\u0634\u064a\u062f \u0628\u0627\u0644\u0635\u0639\u064a\u062f \u062e\u0645\u0633\u0629 \u0645\u0646 \u0627\u0644\u062c\u062f\u062f \u0641\u064a \u0627[\n</li>\n<li dir=\"rtl\">\n\u0627\u0646\u064a \u0633\u0644\u0645\u062a \u0627\u0644\u064a\u0647 \u0648\u0637\u0627\u0648 \u0641\u064a\u0647 \u0648 \u2026\u2026\u2026.\u0641\u0633\u0644\u0645 \u0628\u0627\u0644\u0627[\n</li>\n<li dir=\"rtl\">\n\u0644\u0644\u0636\u0645\u0640[ ]\u0641\u064a ..\u0633\u0627\u0644\u0647\u0627 \u0643\u062a\u0627\u0628 \u062b\u0627\u0646\u064a[\n</li></ol>\n",
