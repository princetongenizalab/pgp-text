        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "<p></p>\n\n<ol><li dir=\"rtl\">[\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645]</li>\n<li dir=\"rtl\">[\u0643\u062a\u0627\u0628\u064a \u0627\u0644\u064a\u0643 ]\u0640\u064a \u0648\u0627\u062e\u064a \u0648\u0633\u064a\u062f\u064a \u0627\u0644\u0639\u0632\u064a\u0632 \u0639\u0644\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647</li>\n<li dir=\"rtl\">]\u0628\u0642\u0627\u0647 \u0648\u0643\u0628\u062a \u062d\u0627\u0633\u062f\u0647 \u0648\u0627\u0639\u062f\u0627\u0647 \u064a\u0630\u0643\u0631 \u0641\u064a\u0647 \u0648\u0641\u0627\u0629</li>\n<li dir=\"rtl\">\u0646\u062c\u0645 \u0627\u0644\u062f\u0648\u0644\u0629 \u0631\u062d\u0645\u0647 \u0627\u0644\u0644\u0647 \u0648\u0628\u0644 \u062b\u0631\u0627\u0647 \u0648\u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u064a\u062e\u0641\u0636</li>\n<li dir=\"rtl\">\u0631\u0648\u062d\u0647 \u0628\u0637\u0648\u0644 \u0639\u0632\u0647 \u0648\u064a\u062d\u0633\u0646 \u0639\u0644\u064a\u0647 \u0627\u0648\u0644\u0627\u062f\u0647 \u0648\u0645\u0646 \u0639\u0646\u062f\u0647</li>\n<li dir=\"rtl\">\u0648\u064a\u062c\u0645\u0639 \u0628\u064a\u0646\u0646\u0627 \u0639\u0644\u0649 \u0627\u0633\u0631 \u062d\u0627\u0644 \u0641\u0645\u0627 \u062a\u0633\u0648\u0627 \u0627\u0644\u062f\u0646\u064a\u0627 \u0644\u0644\u0641\u0631\u0642\u0629</li>\n<li dir=\"rtl\">\u0648\u0644\u0627 \u0627\u0644\u062d\u064a\u0627\u0629 \u0644\u0644\u0645\u0648\u062a \u0641\u0627\u0644\u0644\u0647 \u0627\u0644\u0645\u0633\u062a\u0639\u0627\u0646 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0632\u0645\u0627\u0646</li>\n<li dir=\"rtl\">\u0648\u0642\u062f \u0643\u0646\u062a \u0627\u062a\u0633\u0644\u064a \u0639\u0646 \u0627\u0644\u062f\u0646\u064a\u0627 \u0628\u0645\u0648\u0644\u0627\u064a \u0642\u0637\u0628 \u0627\u0644\u062f\u0648\u0644\u0629 \u0641\u0631\u0642</li>\n<li dir=\"rtl\">\u0627\u0644\u0632\u0645\u0627\u0646 \u0628\u064a\u0646\u0646\u0627 \u0641\u0644\u0627 \u062d\u064a\u0644\u0629 \u0648\u0627\u0645\u0627 \u0642\u0648\u0644\u0647 \u0627\u0646 \u0644\u0645 \u0627\u0647\u062a\u0645 \u0641\u064a \u0633\u0627\u0642\u064a\u0629</li>\n<li dir=\"rtl\">\u00a0\u0641\u0627\u0646\u0627 \u0627\u0639\u0645\u0644 \u0633\u0627\u0642\u064a\u0629 \u0645\u0643\u0645\u0644\u0629 \u0627\u0644\u0639\u062f\u0629 \u0648\u0627\u062c\u0645\u0644\u0647\u0627 \u0631\u0633\u0640[</li>\n<li dir=\"rtl\">\u00a0\u0645\u0639 \u0635\u0627\u0641\u064a \u0648\u0627\u062e\u064a \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645\u064a\u0646 \u0644\u0639\u0644\u064a \u0627\u062a\u062e\u0644\u0635 \u0645\u0646[</li>\n<li dir=\"rtl\">\u00a0\u0627\u0644\u062a\u062c\u0631\u064a\u062f \u0648\u0627\u0644\u0645\u0648\u0636\u0639 \u0627\u0644\u0630\u064a \u0643\u0627\u0646 \u0641\u064a\u0647 \u0646\u062c\u0645 \u0627\u0644\u062f\u0648\u0644\u0629 \u0644\u0627 \u064a\u0641\u0631\u0637</li>\n<li dir=\"rtl\">\u00a0\u0641\u0644\u0639\u0644 \u064a\u0639\u0645\u0644 \u0639\u0644\u064a\u0647 \u0627\u0644\u0649 \u0627\u0644\u0642\u0628\u0644\u0629 \u0648\u0627\u0644\u063a\u0631\u0628 \u0634\u064a \u0627\u062e\u0631</li></ol>\n",
