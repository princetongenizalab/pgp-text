          "value": "<p>&nbsp;</p>\n\n<ol><li>\n<p>\u0627\u0644\u062c\u0632\u064a\u0629 \u0627\u0644\u062c\u0627\u0631\u064a\u0629 \u0627\u0642\u0637\u0627\u0639\u0647 \u0644\u0645 \u064a\u0643\u0646 \u0639\u0644\u064a\u0647\u0627</p>\n</li>\n<li>\n<p>\u0645\u0648\u0638\u0641 \u062c\u0633\u0648\u0631 \u0648\u0644\u0627 \u062d\u0642 \u062f\u064a\u0648\u0627\u0646\u064a[ \u0645\u0637\u0644\u0648\u0628\u061f]</p>\n</li>\n<li>\n<p>\u0627\u0647\u0644\u0647\u0627 \u0628\u0647 \u0645\u0646 \u0645\u062f\u0629 \u0633\u0646\u064a\u0646 \u0648\u0627\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646</p>\n</li>\n<li>\n<p>\u0627\u0644\u0627\u0646 \u0642\u062f \u0637\u0644\u0628\u0648\u0647\u0645 \u0628\u0645\u0648\u0638\u0641 \u0627\u0644\u062c\u0633\u0648\u0631 \u0648\u063a\u0631\u064a\u0645\u0627</p>\n</li>\n<li>\n<p>\u0648\u064a\u0627\u0645\u0631 \u0627\u0644\u0627\u0645\u064a\u0631 \u0628\u0627\u0646 \u064a\u0648\u062e\u0630 \u0628\u0627\u0644\u0643\u0634\u0641 \u0639\u0646</p>\n</li></ol>\n",
