          "type": "TextualBody",
          "label": "Verso",
          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\n<p dir=\"rtl\">\u0645\u0637\u0627\u0644\u0639\u0629</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0633\u0644\u0637\u0627\u0646</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0648\u0639\u0644\u064a\u0647</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0641\u064a\u0647\u0645</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0631\u062d\u0645\u062a\u0647\u0627\u00a0 \u00a0 \u00a0 \u0635\u0645\u0635\u0627\u0645</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0648\u0627\u062d\u0645\u062f \u0628\u0646 \u0641\u0631\u0627\u062c\u0627</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u2026</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u0644\u0645\u0645\u0644\u0648\u0643\u0627\u0646 \u064a\u0642\u0628\u0644\u0627\u0646 \u0627\u0644\u0627\u0631\u0636 \u0648\u064a\u0646\u0647\u064a\u0627\u0646 \u0631\u063a\u0628\u0629(\u061f) \u0643\u0644\u0641\u0647\u0645\u0627 \u0641\u064a(\u061f) \u063a\u0644\u0629(\u061f) \u0645\u0646 \u0627\u0642\u0637\u0627\u0639\u0647 \u0627\u0644\u0645\u0639\u064a\u0646</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0628\u0627\u0633\u0645\u0647 \u0648\u0627\u0633\u0645 \u0648\u0644\u064a\u0647 \u0646\u0627\u0635\u0631 \u0627\u0644\u062f\u0648\u0644\u0629 \u0642\u0631\u0628(\u061f) \u0627\u0644\u0646\u0627\u062d\u064a\u0629 \u0627\u0644\u0645\u0639\u0631[\u0648\u0641\u0629 \u00a0 \u00a0 \u00a0 ]\u0648\u0643\u062a\u0628</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u00a0\u0627\u0644\u0649 \u0645\u0627\u2026\u2026\u0644\u0644\u0627\u0645\u064a\u0631\u064a\u0646 \u0645\u062c\u062f \u0627\u0644\u0644\u0647 \u0648\u0627\u062d\u0645\u062f \u0628\u0646 \u0641\u0631\u0627\u062c\u0627 \u0648\u063a\u0644\u0627\u0645\u064a\u0647 \u064a\u0627\u0642\u0648\u062a \u0648\u0641\u064a\u0631\u0648\u0632 \u0648\u0635\u0627\u0641</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u0644\u0645\u0648\u0627[ \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 ]\u0644\u0648\u062e \u0648\u0633\u0645\u0644\u0648\u0637 \u0648\u0627\u0637\u0641\u064a\u062d \u0648\u0627[\u00a0 \u00a0 \u00a0 ] \u0645\u0646 \u0627\u0644\u0645\u0645\u0627\u062c\u062f</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u0645\u0640]\u0640\u0646 \u0633\u0644\u0645\u0627\u0646 \u0648\u0639\u0644\u0627\u0645\u062a\u0647 \u062d\u0640[ \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 ] </p>\n</li></ol>\n",
