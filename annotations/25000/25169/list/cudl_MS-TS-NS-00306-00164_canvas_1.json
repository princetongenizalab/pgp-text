          "label": "Right margin",
          "value": "<p dir=\"ltr\"></p>\n\n<ol><li dir=\"rtl\">\n\u0644\u0644\u062e\u0645\u0633\u0629 \u062f\u0646\u0627\u0646\u064a\u0631 \u064a\u0648\u0635\u0644\u0647\u0627 \u0644\u0647 \u0648\u064a\u062c\u0644\u0649\n</li>\n<li dir=\"rtl\">\n\u0644\u0644\u0634\u064a\u062e \u064a\u0648\u0633\u0641 \u064a\u062d\u064a \u0627\u0644\u0649 \u0639\u0628\u062f\u064a \u0639\u0627\u062c\u0644 \u0633\u0644\u0627\u0645\n</li>\n<li dir=\"rtl\">\n\u0628\u0639\u062f \u062a\u0642\u0628\u064a\u0644 \u064a\u062f\u0647\u0627\n</li>\n<li dir=\"rtl\">\n\u0648\u0631\u062c\u0644\u0647\u0627\n</li>\n<li dir=\"rtl\">\n\u0644\u0644\u0634\u064a\u062e \u0627\u0644\u0627\u062c\u0644\n</li>\n<li dir=\"rtl\">\n\u0648\u0641\u0642\u062f\u062a \u062e\u062f\u0645\u062a\u064a\n</li>\n<li dir=\"rtl\">\n\u2026\u2026.\n</li></ol>\n",
