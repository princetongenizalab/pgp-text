        {
          "type": "TextualBody",
          "label": "Recto",
          "value": "\n<ol><li dir=\"rtl\">\u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u0627\u0628\u0648 \u0645\u0646\u0635\u0648\u0631 \u0627\u0644\u0641\u062e\u0631 \u0627\u0644\u0645\u062a\u0637\u0628\u0628</li>\n<li dir=\"rtl\">\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645</li>\n<li dir=\"rtl\">\u0627\u0644\u0645\u0645\u0644\u0648\u0643 \u064a\u062e\u062f\u0645 \u0627\u0644\u0645\u062c\u0644\u0633 \u0627\u0644\u0633\u0627\u0645\u064a \u0627\u0644\u0627\u0641\u0636\u0644\u064a \u0627\u0644\u0645\u0648\u0641\u0642\u064a \u0627\u0644\u0633\u0639\u064a\u062f\u064a \u0645\u0627\u0644\u0643 \u0627\u0644\u0631\u0642</li>\n<li dir=\"rtl\">\u0627\u0644\u0634\u064a\u062e \u0627\u0644\u0627\u062c\u0644 \u0627\u0644\u0631\u064a\u0633 \u0627\u0628\u0648 \u0627\u0644\u0641\u0631\u062c \u0627\u062f\u0627\u0645 \u0627\u0644\u0644\u0647 \u0639\u0632\u0647 \u0648\u0637\u0627\u0639\u062a\u0647 \u0648\u0633\u0639\u062f\u0647</li>\n<li dir=\"rtl\">\u0648\u062c\u0645\u0639 \u0634\u0645\u0644\u064a \u0628\u0647 \u0642\u0631\u064a\u0628 \u0628\u0639\u064a\u062f \u0648\u0633\u0648\u0627\u0647 \u0627\u0644\u0645\u0648\u0644\u0627 \u0627\u0646\u0639\u0645 \u0648\u062a\u0641\u0636\u0644 \u0648\u0627\u062d\u0633\u0646 \u0641\u064a \u062d\u0642\u064a</li>\n<li dir=\"rtl\">\u062a\u0645\u0627\u0645 \u0645\u0627 \u0646\u0642\u0644 \u0645\u0631\u0628\u0647(\u061f) \u0644\u0644\u0648\u0639\u062f \u0627\u0644\u0643\u0631\u064a\u0645 \u0648\u0642\u062f \u0627\u0646\u0635\u0631 \u0627\u0644\u0645\u0648\u0644\u0627 \u0645\u0627 \u0639\u0631\u0641\u0647</li>\n<li dir=\"rtl\">\u0641\u064a \u062d\u0642\u0647 \u0627\u0644\u0645\u063a\u0627\u0630\u064a\u0629(\u061f) \u0648\u0627\u062c\u0631 \u062e\u062a\u0645 \u0645\u0646 \u0627\u0633\u0643\u0646\u062f\u0631\u064a\u0629 \u0628\u0644\u0627 \u062f\u0631\u0647\u0645</li>\n<li dir=\"rtl\">\u0648\u0644\u0627 \u062f\u064a\u0646\u0627\u0631 \u0633\u064a\u0631\u0647 \u063a\u0644\u0627\u0645\u064a \u0628\u0643\u062a\u0627\u0628 \u0627\u0644\u0627\u064a\u0629 \u0648\u0643\u062a\u0628 \u062c\u0645\u064a\u0639 \u0627\u0644\u0627\u0634\u0631\u0643\u0627</li>\n<li dir=\"rtl\">\u0648\u064a\u062d\u0633\u0646 \u0645\u0646 \u062c\u0645\u0644\u062a\u0647 \u0648\u0627\u0633\u0639\u062f \u0628\u0645\u0645\u0644\u0648\u0643\u0647\u0627 \u0639\u0645\u0644\u062a \u0645\u0639\u0647\u0645 \u0648\u0642\u062f \u0633\u064a\u0631\u062a</li>\n<li dir=\"rtl\">&nbsp;\u0645\u0639 \u063a\u0644\u0627\u0645\u064a \u0643\u062a\u0628 \u0627\u0644\u0649 \u0645\u062a\u0648\u0644\u064a \u0645\u0635\u0631 \u0628\u0627\u0646 \u064a\u062a\u0642\u0648\u0649 \u0644\u0644\u062d\u0648\u0638\u0647</li>\n<li dir=\"rtl\">\u0641\u0627\u0646 \u0647\u0645 \u062a\u0627\u062b\u0631 \u0630\u0644\u0643 (\u061f) \u0647\u0645 \u064a\u0639\u0631\u0641\u0648 \u0644\u064a\u0633&nbsp;</li>\n<li dir=\"rtl\">&nbsp;\u0628\u064a\u0646\u064a \u0644\u0644\u0648\u0627\u062d\u062f \u0645\u0633\u0643\u0646\u0647\u0627(\u061f) \u0628\u0627\u064a\u062f \u0627\u0644\u0627\u062e\u0631\u0627 \u0641\u0642\u062f \u0648\u0627\u0644\u0644\u0647 \u0627\u0644\u0639\u0638\u064a\u0645</li>\n<li dir=\"rtl\">&nbsp;\u0648\u0644\u0648 \u062f\u0641\u0639\u062a \u0644\u064a \u0627\u0644\u0641 \u062f\u064a\u0646\u0627\u0631 \u0645\u0627 \u062a\u062e\u0644\u064a\u062a \u062c\u064a\u0628\u0627 \u0648\u0642\u062f\u0634\u0631\u064a\u062a \u0644\u0644\u0645\u0648\u0644\u0627</li></ol>\n",
