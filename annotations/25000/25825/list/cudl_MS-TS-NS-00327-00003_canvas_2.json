      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li dir=\"rtl\">\n<p dir=\"rtl\">\u0631\u062f\u0631(\u061f) \u0645\u0627\u064a\u0629 \u0627\u0644\u0641 \u0648\u0633\u062a\u0629 \u0627\u0644\u0641 \u062f\u0631\u0647\u0645&nbsp; &nbsp; &nbsp; \u0627\u0644\u0641\u0627 \u0631\u0628\u0627\u0628 [&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ]\u062f\u0631\u0647\u0645 \ua668</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u0644\u062c\u064a\u0644\u0627\u0646 \u0628\u0627\u0639 \u0648\u0634\u0639\u0628 \u062c\u0631\u0647 \u0648\u062c\u0628\u0627\u0644\u0647\u0627 \u0645\u0627\u064a\u0629 \u0627\u0644\u0640[\u0640\u0641 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ]\u0640\u0641\u0627 \u0648\u062b\u0644\u062b\u0645\u0627\u064a\u0629</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u062f\u0631\u0647\u0645 \ua668 \u062d\u0644\u0645 \u0627\u062b\u0646\u0627 \u0639\u0634\u0631 \u0627\u0644\u0641 \u0648\u062b\u0644\u062b\u0645\u0627\u064a\u0629 \u062f\u0631\u0647\u0645 [&nbsp; &nbsp; &nbsp; &nbsp; ]\u0640\u064a\u0631 \u0648\u063a\u0634 \u0627\u0631\u0628\u0639\u0629 \u0627\u0644\u0641 \u062f\u0631\u0647\u0645 \ua668</p>\n</li>\n<li>\u062a\u0631\u0645\u0630 \u0627\u0644\u0641\u0627 \u062f\u0631\u0647\u0645 [\u0627\u0644\u0631]\u0648\u0628 \u0648\u0633\u0645\u0646\u062c\u0627\u0646 \u0627\u062b\u0646\u0627 \u0639\u0634\u0631 \u0627\u0644\u0641\u0627 \u0648\u0633\u062a\u0645\u0627\u064a\u0629 \u062f\u0631\u0647\u0645 \ua668 \u0627\u0644\u0631\u0628\u0648\u0634\u0627\u0632\u0627\u0646</li>\n<li>\u0639\u0634\u0640[\u0640\u0631\u0629 \u0627\u0644\u0627\u0641 \u062f\u0631\u0647\u0645] \u0627\u0644\u0628\u0627\u0645\u064a\u0627\u0646 \u062e\u0645\u0633\u0629 \u0627\u0644\u0641 \u062f\u0631\u0647\u0645 \u0628\u0631\u0645\u062c\u0627\u0646 \u0648\u0639\u0631\u0645\u0631(\u061f) \u0648 \u0627\u0644\u0633\u0628\u0646\u062c\u0627\u0631</li>\n<li>\u0645\u0627\u064a\u062a\u0627 [\u0627\u0644\u0641 \u0648\u0633\u062a\u0629] \u0627\u0644\u0627\u0641&nbsp; \u0648\u062e\u0645\u0633 \u0645\u0627\u064a\u0629 \u062f\u0631\u0647\u0645 \u0627\u0644\u062a\u0631\u0645\u0630 \u0633\u0628\u0639\u0629 \u0648\u0627\u0631\u0628\u0639\u0648\u0646 \u0627\u0644\u0641\u0627 \u0648\u0645\u0627\u064a\u0629 \u062f\u0631\u0647\u0645</li>\n<li>\u0627\u0644\u0628\u064a\u0646\u0642\u0627\u0646 \u062b\u0644\u062b\u0629 \u0627\u0644\u0641 \u062f\u0631\u0647\u0645 \u0648\u062e\u0645\u0633 \u0645\u0627\u064a\u0629 \u062f\u0631\u0647\u0645 \u0643\u0631\u0627\u0646 \u0627\u0631\u0628\u0639\u0629 \u0627\u0644\u0641 \u062f\u0631\u0647\u0645 \u0634\u0642\u0646\u0627\u0646</li>\n<li>\u0627\u0631\u0628\u0639\u0648\u0646 \u0627\u0644\u0641 \u062f\u0631\u0647\u0645 \u0648\u062e\u0627\u0646 \u0639\u0634\u0631\u0648\u0646 \u062f\u0631\u0647\u0645 \u0627\u0644\u0645\u0646\u062f\u062c\u0627\u0646 \u0627\u0644\u0641\u0627 \u062f\u0631\u0647\u0645</li>\n<li>\u0627\u062e\u0631\u0648\u0646 \u0627\u062b\u0646\u0627\u0646 \u0648\u062b\u0644\u062b\u0648\u0646 \u0627\u0644\u0641 \u062f\u0631\u0647\u0645 \u0627\u0644\u0640[\u0640\u0643\u0633\u062a] \u0639\u0634\u0631\u0629 \u0627\u0644\u0641 \u062f\u0631\u0647\u0645 \u062a\u0647\u0627\u0645 \u0639\u0634\u0631\u0648\u0646 \u0627\u0644\u0641</li>\n<li>\u062f\u0631\u0647\u0645 \u0627\u0644\u0635\u063a\u0627\u0645\u064a\u0627\u0646 \u062b\u0645\u0627\u0646\u064a\u0629 \u0648\u0627\u0631\u0628\u0639\u0648\u0646 \u0627\u0644\u0641 \u062e\u0645\u0633 \u0645\u0627\u064a\u0629 \u062f\u0631\u0647\u0645 \u0628\u0627\u0633\u0627\u0631\u0627[</li>\n<li>...\u062f\u0631\u0647\u0645 \u0648\u0627\u0634\u062e\u0631\u062a \u0627\u0644\u0641 \u062f\u0631\u0647\u0645 \u0627\u0644\u0639\u0646\u062f\u0645\u064a\u0646 \u0627\u0644\u0631\u064a\u0634\u0627\u0646[</li>\n<li>\u062f\u0627\u0628\u0629\ua668 \u0643\u0627\u0628\u0644 \u0627\u0644\u0641 \u0627\u0644\u0641 \u062f\u0631\u0647\u0645 \u0648\u062e\u0645\u0633 \u0645\u0627\u064a\u0629 \u062f\u0631\u0647\u0645[</li>\n<li>\u0648\u0644\u0647\u0627 \u0645\u0646 \u0627\u0644\u0645\u062f\u0646 \u0648\u0627\u0632\u0632\u0627\u0646 \u0648\u062e\u0648\u0627\u0633 \u0648\u062e\u0633\u0643 \u0648\u062e\u0628\u0632[\u0629</li>\n<li>\u0648\u0647\u0644\u064a\u0644\u062c \u0644\u0627\u0646\u0647\u0627 \u0645\u062a\u0627\u062e\u0645\u0629(\u061f) \u0627\u0644\u0647\u0646\u062f \u062a\u064f\u0633\u0641 \u062a\u0633\u0639\u0648\u0646 \u0627\u0644\u0641[</li>\n<li>\u062e\u0640[&nbsp; &nbsp; &nbsp;]\u062e\u0645\u0633\u0629 \u0627\u0644\u0641 \u062f\u0631\u0647\u0645[</li></ol>\n\n<p></p>",
