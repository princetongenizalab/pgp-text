      "body": [
        {
          "type": "TextualBody",
          "label": "Recto, \u02bfal\u0101ma",
          "value": "\n<ol><li>Praise be to God, and he is sufficient to me; may his enviers perish.</li>\n<li>Entrusted to him [?] is the poor one, \u02bfAbd al-Ra\u1e25man alA\u1e33\u1e63ar\u0101y\u012b the \u1e24anbal\u012b,</li>\n<li>entrusted with rendering justice in Damietta and its district.</li></ol>\n",
          "format": "text/html"
        }
      ],
      "motivation": [
        "sc:supplementing",
        "translating"
      ],
      "schema:position": 1
    },
