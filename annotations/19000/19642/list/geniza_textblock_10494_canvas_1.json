      "body": [
        {
          "type": "TextualBody",
          "label": "\u00a0Recto,\u00a0main text",
          "value": "\n<ol><li><span lang=\"ar\">\u0628\u0627\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645 \u0641\u062a\u0648\u0643\u0644 [\u061f]</span></li>\n<li>\u0628\u0627\u0644\u0645\u062d\u0643\u0645\u0629 \u0627\u0644\u0634\u0631\u0639\u064a\u0629 \u0628\u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u0627\u0644\u0645\u0633\u0644\u0645\u064a\u0629 \u0628\u062b\u063a\u0631 \u062f\u0645\u064a\u0627\u0637 \u0627\u0644\u0645\u062d\u0631\u0648\u0633 \u0628\u064a\u0646 \u064a\u062f\u064a \u0633\u064a\u062f\u0646\u0627 \u0627\u0644\u0639\u0628\u062f \u0627\u0644\u0641\u0642\u064a\u0631 \u0627\u0644\u0649 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0627\u0644\u0634\u064a\u062e \u0627\u0644\u0627\u0645\u0627\u0645</li>\n<li>\u0627\u0644\u0627\u0638\u0647\u0631 \u0627\u0644\u0639\u0627\u0644\u0645 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0632\u064a\u0646 \u0627\u0644\u062f\u064a\u0646 \u0634\u0631\u0641 \u0627\u0644\u0639\u0644\u0645\u0627\u0621 \u0627\u0648\u062d\u062f \u0627\u0644\u0641\u0636\u0644\u0627\u0621 \u0645\u0641\u062a\u064a \u0627\u0644\u0645\u0633\u0644\u0645 \u0627\u0628\u064a \u0647\u0631\u064a\u0631\u0629 \u0639\u0628\u062f \u0627\u0644\u0631\u062d\u0645\u0646</li>\n<li>\u0627\u0644\u0627\u0642\u0635\u0631\u0627\u064a \u0627\u0644\u062d\u0646\u0628\u0644\u064a \u062e\u0644\u064a\u0642\u0629 \u0627\u0644\u062d\u0643\u0645 \u0627\u0644\u0639\u0632\u064a\u0632 \u0628\u0627\u0644\u062b\u063a\u0631 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0627\u064a\u062f \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0627\u062d\u0643\u0627\u0645\u0647 \u0648\u0627\u062d\u0633\u0646 \u0627\u0644\u064a\u0647 \u0628\u0639\u062f\u0644 \u062a\u0635\u0627\u062f\u0642</li>\n<li>\u0627\u0644\u0627\u062e\u0648\u0627\u0646 \u0627\u0644\u0634\u0642\u064a\u0642\u0627\u0646 \u0647\u0645\u0627 \u0627\u0628\u0648 \u0627\u0644\u0628\u0642\u0627 \u0648\u0627\u0628\u0648 \u0627\u0644\u0639\u0632 \u0648\u0644\u062f\u0627 \u0627\u0644\u0645\u0631\u062d\u0648\u0645 \u0628\u062f\u0631 \u0627\u0644\u062f\u064a\u0646 \u0627\u0644\u0645\u062f\u0639\u0648 \u0628\u062f\u064a\u0631 \u0628\u0646 \u0627\u0644\u0645\u0631\u062d\u0648\u0645 \u0627\u0644\u0634\u0647\u0627\u0628\u064a</li>\n<li>\u0627\u062d\u0645\u062f \u0627\u0644\u0645\u062f\u0639\u0648 \u0628\u064a\u063a\u0648\u0633 \u0627\u0644\u062d\u0631\u0645\u064a \u062c\u062f\u0647\u0645\u0627 \u0628\u063a\u064a\u062f \u0627\u0644\u0646\u0635\u0627\u0631\u0649 \u0628\u0627\u0644\u062b\u063a\u0631 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0648\u0627\u0644\u0645\u0639\u0644\u0645 \u064a\u0648\u0633\u0641 \u0628\u0646 \u0627\u0644\u0645\u0639\u0644\u0645 \u0627\u0628\u0631\u0627\u0647\u064a\u0645 \u0643\u0627\u0633\u062a\u0631\u0648\u0627</li>\n<li>\u0627\u0644\u0639\u0627\u0645\u0644 \u0628\u0627\u0644\u062b\u063a\u0631 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0627\u0644\u0627\u0646 \u062a\u0635\u0627\u062f\u0642 \u0634\u0631\u0639\u064a \u0648\u0647\u0645 \u0628\u062d\u0627\u0644 \u0627\u0644\u0635\u062d\u0629 \u0648\u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0648\u0627\u0644\u0637\u0648\u0627\u0639\u064a\u0629 \u0648\u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0639\u0644\u0649 \u0627\u0646 \u0627\u0644\u0630\u064a</li>\n<li>\u064a\u0633\u062a\u062d\u0642\u0647 \u0627\u0644\u0645\u0639\u0644\u0645 \u064a\u0648\u0633\u0641 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0627\u0639\u0644\u0627\u0647 \u0641\u064a \u0630\u0645\u0629 \u0623\u0628\u064a \u0627\u0644\u0628\u0642\u0627 \u0648\u0627\u0628\u064a \u0627\u0644\u0639\u0632 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u064a\u0646 \u0627\u0639\u0644\u0627\u0647 \u0645\u0646 [\u061f]... \u0627\u0644\u0636\u0645\u0627\u0646 \u0627\u0644\u0634\u0631\u0639\u064a</li>\n<li>\u0644\u0648\u0627\u0644\u062f\u0647\u0645\u0627 \u0628\u062f\u064a\u0631 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0648\u0644\u062c\u062f\u0647\u0645\u0627 \u0627\u062d\u0645\u062f \u0628\u064a\u063a\u0648\u0633 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0641\u064a\u0647 \u0645\u0646 \u062f\u064a\u0646 \u0634\u0631\u0639\u064a \u0633\u0627\u0644\u0641 \u0639\u0644\u0649 \u062a\u0627\u0631\u064a\u062e\u0647 \u0648\u0645\u0639\u0627\u0645\u0644\u0629 \u0643\u0627\u0646\u062a \u0628\u064a\u0646\u0647\u0645</li>\n<li>\u0645\u0627 \u062c\u0645\u0644\u062a\u0647 \u0645\u0646 \u0627\u0644\u0641\u0636\u0629 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a\u0629 \u0627\u0644\u0642\u0637\u0639 \u0627\u0644\u0643\u0628\u0627\u0631 \u0645\u0639\u0627\u0645\u0644\u0629 \u0645\u0635\u0631 \u0627\u0644\u0627\u0646 \u0627\u0644\u0641 \u0646\u0635\u0641 \u0648\u062e\u0645\u0633 \u0645\u0627\u064a\u0629 \u0646\u0635\u0641 \u0627\u0633\u062a\u062d\u0642\u0627\u0642\u0627 \u0634\u0631\u0639\u064a\u0627</li>\n<li>\u0628\u0627\u0644\u0637\u0631\u064a\u0642 \u0627\u0644\u0634\u0631\u0639\u064a \u0639\u0644\u0649 \u062d\u0643\u0645 \u0627\u0644\u062d\u0644\u0648\u0644 \u0627\u0642\u0631 \u0627\u0628\u0648 \u0627\u0644\u0628\u0642\u0627 \u0648\u0627\u0628\u0648 \u0627\u0644\u0639\u0632 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0627\u0646 \u0627\u0639\u0644\u0627\u0647 \u0648\u0647\u0645\u0627 \u0641\u0631\u064a\u0642 \u0627\u0648\u0644</li>\n<li>\u0641\u064a\u0645\u0627 \u064a\u0627\u062a\u064a \u0630\u0643\u0631\u0647 \u0641\u064a\u0647 \u0648\u0627\u0644\u0645\u0639\u0644\u0645 \u064a\u0648\u0633\u0641 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0648\u0647\u0648 \u0628\u0645\u062c\u0631\u062f\u0647 \u0641\u0631\u064a\u0642 \u062b\u0627\u0646 \u0644\u0644\u0627\u0642\u0631\u0627\u0631 [\u0627\u0644]\u0634\u0631\u0639\u064a \u0627\u0646 \u0643\u0644 \u0641\u0631\u064a\u0642 \u0645\u0646\u0647\u0645\u0627</li>\n<li>\u0644\u0627 \u064a\u0633\u062a\u062d\u0642 \u0648\u0644\u0627 \u064a\u0633\u062a\u0648\u062c\u0628 \u0642\u0628\u0644 \u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0627\u062e\u0631 \u0628\u0639\u062f \u0630\u0644\u0643 \u0648\u0632\u0627\u062f \u0627\u0644\u0645\u0639\u0644\u0645 \u064a\u0648\u0633\u0641 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0641\u064a \u0627\u0642\u0631\u0627\u0631\u0647 \u0627\u0646\u0647 \u0644\u0627</li>\n<li>\u064a\u0633\u062a\u062d\u0642 \u0644\u0646\u0641\u0633\u0647 \u0648\u0644\u0627 \u0644\u0648\u0627\u0644\u062f\u0647 \u0627\u0628\u0631\u0627\u0647\u064a\u0645 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0642\u0628\u0644 \u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0623\u0648\u0644 \u0648\u0644\u0627 \u0641\u064a \u0630\u0645\u0629 \u0628\u062f\u064a\u0631 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0648\u0644\u0627 \u0641\u064a \u0630\u0645\u0629 \u0648\u0627\u0644\u062f\u0647</li>\n<li>\u0627\u062d\u0645\u062f \u0628\u064a\u063a\u0648\u0633 \u0648\u0644\u0627 \u0639\u0644\u0649 \u0627\u062d\u062f \u0645\u0646 \u0648\u0631\u062b\u062a\u0647\u0645\u0627 \u062d\u0642\u0627 \u0648\u0644\u0627 \u0627\u0633\u062a\u062d\u0642\u0627\u0642\u0627 \u0648\u0644\u0627 \u062f\u0639\u0648\u0649 \u0648\u0644\u0627 \u0637\u0644\u0628\u0627 \u0628\u0648\u062c\u0647 \u0648\u0644\u0627 \u0633\u0628\u0628</li>\n<li>\u0648\u0644\u0627 \u0641\u0636\u0629 \u0648\u0644\u0627 \u0630\u0647\u0628\u0627 \u0648\u0644\u0627 \u0641\u0644\u0648\u0633\u0627 \u0648\u0644\u0627 \u0642\u0628\u0636\u0627 \u0648\u0644\u0627 \u0627\u0642\u0628\u0627\u0636\u0627 \u0648\u0644\u0627 \u062d\u0633\u0627\u0628\u0627 \u0648\u0644\u0627 \u063a\u0644\u0637\u0627 \u0641\u064a\u0647 \u0648\u0644\u0627 \u062c\u0647\u0627\u0644\u0627 \u0648\u0644\u0627</li>\n<li>\u0646\u0633\u064a\u0627\u0646\u0627 \u0648\u0644\u0627 \u0630\u0647\u0648\u0644\u0627 \u0648\u0644\u0627 \u062f\u064a\u0646\u0627 \u0648\u0644\u0627 \u0639\u064a\u0646\u0627 \u0648\u0644\u0627 \u0648\u0635\u0627 \u0648\u0644\u0627 \u0627\u0642\u0631\u0627\u0636\u0627 \u0648\u0644\u0627 \u0627\u0644\u0632\u0627\u0645\u0627 \u0648\u0644\u0627 \u062f\u0639\u0648\u0649 \u0628\u0630\u0644\u0643</li>\n<li>\u0648\u0644\u0627 \u0634\u064a\u0627 \u0645\u0646 \u0627\u0644\u0627\u0634\u064a\u0627 \u0643\u0644\u0647\u0627 \u0642\u0644\u064a\u0644\u0647\u0627 \u0648\u0643\u062b\u064a\u0631\u0647\u0627 \u062c\u0644\u064a\u0644\u0647\u0627 \u0648\u062d\u0642\u064a\u0631\u0647\u0627 \u0630\u0645\u064a\u0645\u0647\u0627 \u0648\u0627\u0645\u0627\u0646\u0647\u0627 \u062c\u0627\u0631\u0647\u0627 \u0648\u0645\u0648\u0643\u0644\u0647\u0627 [\u061f] \u062b\u0627\u0628\u062a\u0647\u0627</li>\n<li>\u0648\u0645\u062a\u0642\u0648\u0644\u0647\u0627 \u0639\u0644\u0649 \u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0646\u0648\u0627\u0639\u0647\u0627 \u0648\u062a\u0628\u0627\u064a\u0646 \u0627\u062c\u0646\u0627\u0633\u0647\u0627 \u0648\u062a\u0639\u062f\u0644 \u0635\u0641\u0627\u062a\u0647\u0627 \u0648\u0644\u0627 \u0639\u0644\u0642\u0629 \u0648\u0644\u0627 \u062a\u0628\u0639\u0627 \u0648\u0644\u0627 \u064a\u0645\u064a\u0646\u0627</li>\n<li>\u0628\u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0648\u0644\u0627 \u0634\u064a\u0627 \u0642\u0644 \u0648\u0644\u0627 \u062c\u0644 \u0644\u0633\u0627\u0644\u0641 \u0627\u0644\u0632\u0645\u0627\u0646 \u0648\u0627\u0644\u0649 \u062a\u0627\u0631\u064a\u062e\u0647 \u0645\u0627 \u0639\u062f\u0649 \u0645\u0627 \u064a\u0633\u062a\u062d\u0642 \u064a\u0648\u0633\u0641 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0641\u064a \u0630\u0645\u0629 \u0623\u0628\u064a \u0627\u0644\u0628\u0642\u0627</li>\n<li>\u0648\u0627\u0628\u064a \u0627\u0644\u0639\u0632 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u064a\u0646 \u0627\u0639\u0644\u0627\u0647 \u0648\u0647\u0648 \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062a\u0635\u0627\u062f\u0642 \u0639\u0644\u064a\u0647 \u0627\u0639\u0644\u0627\u0647 \u0648\u0639\u0644\u0642 \u0627\u0644\u0631\u0647\u0646 \u0627\u0644\u0627\u062a\u064a \u0630\u0643\u0631\u0647 \u0641\u064a \u0638\u0627\u0647\u0631\u0647 \u0641\u064a \u0627\u0644\u064a\u0645\u064a\u0646</li>\n<li>\u0627\u0644\u0630\u064a \u0631\u0647\u0646\u0647\u0627 \u0641\u064a \u064a\u0648\u0645 \u062a\u0627\u0631\u064a\u062e\u0647 \u0644\u0648\u0631\u0627\u062b\u0647 \u0639\u0644\u0649 \u0630\u0644\u0643 \u0648\u0627\u0628\u0631\u0627 \u0643\u0644 \u0641\u0631\u064a\u0642 \u0645\u0646\u0647\u0645\u0627 \u0630\u0645\u0629 \u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0627\u062e\u0631 \u0648\u064a\u062f\u0647 \u0648\u0627\u0645\u0627\u0646\u062a\u0647</li>\n<li>\u0645\u0646 \u0633\u0627\u0626\u0631 \u0627\u0644\u0639\u0644\u0642 \u0648\u0627\u0644\u062a\u0628\u0639\u0627\u062a \u0648\u0627\u0644\u062f\u0639\u0627\u0648\u0649 \u0648\u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0648\u0627\u0644\u0627\u064a\u0645\u0627\u0646 \u0627\u0644\u0648\u0627\u062c\u0628\u0627\u062a \u0627\u0644\u0628\u0631\u0627\u0629 \u0627\u0644\u0634\u0631\u0639\u064a\u0629 \u0627\u0644\u0642\u0627\u0637\u0639\u0629 \u0627\u0644\u062d\u0627\u0632\u0645\u0629 \u0627\u0644\u062d\u0627\u0633\u0645\u0629</li>\n<li>\u0627\u0644... \u0627\u0644\u0645\u0631\u062c\u0639\u0629 \u0644\u0643\u0644 \u062d\u0642 \u0648\u062f\u0639\u0648\u0649 \u0648\u064a\u0645\u064a\u0646 \u064a\u062a\u0642\u062f\u0645 \u062a\u0627\u0631\u064a\u062e\u0647 \u0648\u0627\u0644\u0649 \u062a\u0627\u0631\u064a\u062e\u0647 \u0645\u0627 \u0639\u062f\u0649 \u0627\u0644\u0645\u0633\u0645\u064a \u0627\u0639\u0644\u0627\u0647 \u0642\u0628\u0644 \u0643\u0644 \u0641\u0631\u064a\u0642 \u062c\u0645\u0644\u062a\u0647\u0645\u0627 [\u061f]</li></ol>\n",
