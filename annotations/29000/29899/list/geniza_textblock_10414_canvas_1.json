    {
      "etag": "\"3959312c08c5f187c5ee60b9f9fbf59a\"",
      "id": "https://geniza.princeton.edu/annotations/1833965b-4de7-4c9e-9992-389fd8f8a001/",
      "type": "Annotation",
      "created": "2025-08-18T17:56:59.877097+00:00",
      "modified": "2025-08-18T17:56:59.877106+00:00",
      "dc:source": "https://geniza.princeton.edu/sources/20/",
      "target": {
        "source": {
          "id": "https://geniza.princeton.edu/documents/29899/iiif/textblock/10414/canvas/1/",
          "type": "Canvas",
          "partOf": {
