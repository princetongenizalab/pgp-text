      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "<i>Registration mark on right</i>\n\n<ol><li>Let it be registered on behalf of the office of supervision,</li>\n<li dir=\"ltr\">if God wills.</li></ol>\n",
          "format": "text/html"
        }
      ],
