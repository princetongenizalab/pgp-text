    {
      "etag": "\"3191f33df0a63433ba7b6641b9b19505\"",
      "id": "https://geniza.princeton.edu/annotations/fae47bb4-dae0-4925-9d2c-916314547d58/",
      "type": "Annotation",
      "created": "2026-09-07T14:37:27.039108+00:00",
