      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "<p><i>Registration mark on right</i></p>\n\n<ol><li>Let it be registered on behalf of the office of supervision,</li>\n<li>if God wills.</li>\n<li>They have registered the amount of two, a third and an eighth.</li>\n<li>Praise be to God for his bounties.</li></ol>\n",
          "format": "text/html"
        }
