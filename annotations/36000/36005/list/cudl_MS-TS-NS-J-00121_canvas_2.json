          "type": "TextualBody",
          "value": "<p></p>\n\n<ol><li dir=\"rtl\">\n<p dir=\"rtl\">\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u062c\u0645\u0644</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0631\u0631\u0641\u0639\u0647(\u061f) \u0639\u0628\u062f \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0646 \u0646\u0635\u0631 \u0627\u0644\u0644\u0647 \u0627\u0644\u0648\u0643\u064a\u0644 \u0639\u0644\u0649 \u0639\u0645\u0627\u0631\u0629</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u0644\u062c\u0633\u0648\u0631 \u0627\u0644\u0645\u0639\u0645\u0648\u0631\u0629 \u0649\u0627\u062d\u0649\u0648\u0649\u0647(\u061f) \u0648\u0634\u0628\u0631\u0649 \u0648\u0627\u0628\u0648 \u0631\u0643\u0648\u0629</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0645\u0646 \u0627\u0644\u062e\u0631\u0627\u062c \u0644\u0645\u0631\u0643\u0632\u064a\u0629 (\u061f)\u0639\u0645\u0644\u0647\u0627 \u0644\u0644\u0633\u0645\u0627\u062a(\u061f) \u0633\u0637\u0648\u062d \u0645\u0646\u0648\u0631</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0648[ \u00a0 \u00a0 ]\u062a\u0647 \u0628\u0645\u0627 \u0642\u0628\u0636\u0647 \u0645\u0646 \u0645\u0627\u0644 \u0627\u0644\u0646\u0648\u0627\u062d\u064a \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629 \u0644\u0633\u0646\u0629</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u062b\u0646\u062a\u064a \u0648\u062e\u0645\u0633\u0645\u0627\u064a\u0629 \u0627\u0644\u0647\u0644\u0627\u0644\u064a\u0629 \u0627\u0644\u062e\u0631\u0627\u062c\u064a\u0629 \u0641\u064a \u0639\u0645\u0627\u0631\u0629 \u0627\u0644\u062c\u0633\u0648\u0631</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629 \u0628\u0639\u0645\u0627\u0631\u0629 \u0633\u0646\u0629 \u062b\u0644\u062b \u0648\u062e\u0645\u0633 \u0645\u0627\u064a\u0629 \u0627\u0644\u0647\u0644\u0627\u0644\u064a\u0629 \u0627\u0644\u062e\u0631\u0627\u062c\u064a\u0629</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0639\u0644\u0649 \u0645\u0627 \u0634\u0647\u062f\u062a\u0647 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0631.\u0648\u0639 \u0645\u0646 \u062e\u0645\u0633\u0629 \u0628\u0645\u0648\u0627\u2026</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u00a0\u0627\u0644\u0639\u0645\u0627\u0644\u064a\u0646 \u0628\u0639\u062f \u0648\u0636\u0639 \u0627\u0644\u0631\u2026. \u0627\u0644\u062d\u062f\u0648\u062f\u00a0</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u0644\u062a\u0627\u0633\u0639 \u0645\u0646 \u0634\u0647\u0648\u0631 \u0631\u0645\u0636\u0627\u0646 \u0633\u0646\u0629 \u0627\u062b\u0646\u062a\u064a \u0648\u062e\u0645\u0633 \u0645\u0627\u064a\u0629 \u0627\u0644\u0647\u0644\u0627\u0644\u064a\u0629</p>\n</li>\n<li dir=\"rtl\">\n<p dir=\"rtl\">\u0627\u0644\u062e\u0631\u0627\u062c\u064a\u0629 \u0627\u062e\u0631\u0647\u0627 \u0627.[\u00a0 ] \u0630\u0648 \u0627\u0644\u0642\u0639\u062f\u0629 \u0645\u0646 \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629</p>\n</li>\n<li dir=\"rtl\"></li></ol>\n",
