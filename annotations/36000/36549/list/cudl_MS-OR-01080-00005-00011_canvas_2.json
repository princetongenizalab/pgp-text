      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li>\n<p>[\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0631\u062d\u064a\u0645]</p>\n</li>\n<li>\n<p>[\u0643\u062a\u0627]\u0628\u064a \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627 \u0627\u0644\u0642\u0627\u0636\u064a \u0648\u0627\u062f\u0627\u0645 \u0639\u0632\u0647 \u0648\u062a\u0627\u064a\u064a\u062f\u0647 \u0648\u0633\u0639\u0627\u062f\u062a\u0647 \u0648\u0643\u0641\u0627\u064a\u062a\u0647 \u0648\u062d\u0631\u0627\u0633\u062a\u0647 \u0648\u062a\u0642\u0631\u0628\u0647 \u064a\u0648\u0645 \u0627\u0644\u062b\u0644\u062b\u0627 \u0644\u062e\u0645\u0633 [\u0628\u0642\u064a\u0646/\u062e\u0644\u0648\u0646</p>\n</li>\n<li>\n<p>\u0645\u0646 \u0631\u062c\u0628 \u0639\u0646 \u0633\u0644\u0627\u0645\u0629 \u0648\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u0631\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0646 \u0648\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0645\u062d\u0645\u062f \u0627\u0644\u0646\u0628\u064a \u0648\u0627\u0644\u0647 \u0648\u0633\u0644\u0645 \u062a\u0633\u0644\u064a\u0645\u0627&nbsp; &nbsp; \u0648\u0648\u0635\u0644 \u0627\u0644\u064a \u0643\u062a\u0627\u0628</p>\n</li>\n<li>\n<p>\u0627\u0644\u0642\u0627\u0636\u064a \u0627\u062f\u0627\u0645 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647 \u0628\u0645\u0627 \u0633\u0643\u0646\u062a \u0627\u0644\u0649 \u0645\u062a\u0636\u0645\u0646\u0647 \u0648\u0634\u0643\u0631\u062a \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0645\u0627 \u0645\u0646\u062d \u0645\u0646 \u0633\u0644\u0627\u0645\u062a\u0647 \u0648\u0645\u0646 \u0635\u062d\u062a\u0647 \u0627\u0644\u064a\u0647 \u062e\u0644\u0642\u0640[</p>\n</li>\n<li>\n<p>\u0641\u064a \u0627\u0633\u0628\u0627\u063a \u0646\u0639\u0645\u0647 \u0639\u0644\u064a\u0647 \u0648\u0645\u0636\u0627\u0639\u0641\u062a\u0647\u0627 \u0644\u062f\u064a\u0647 \u0648\u0645\u0647\u0645\u062a\u0647(\u061f) &nbsp; &nbsp; \u0648\u0631\u0627\u064a\u062a\u0647 \u0627\u064a\u062f\u0647 \u0627\u0644\u0644\u0647 \u0628\u0639\u062f \u0628\u0633\u0637\u064a \u0643\u062a\u0627\u0628\u064a \u0627\u0644\u0630\u064a \u0627\u062c\u0627\u0628\u0646\u064a(\u061f)&hellip;</p>\n</li>\n<li>\n<p>\u0639\u0646\u0647 \u0648\u0643\u0646\u062a \u0627\u0646\u0641\u0630 \u0628\u062f\u0641\u0639 \u0627\u0635\u062d\u0627\u0628 \u0627\u0644\u0643\u062a\u0628 \u0648\u0627\u062c\u0628\u0647\u0640[&nbsp; ]\u0648\u0647 \u0648\u0627\u0633\u0644 \u0627\u0644\u0644\u0647 \u0627\u0646 \u064a\u062d\u0631\u0633\u0646\u064a \u0641\u064a \u0627\u0644\u0642\u0627\u0636\u064a \u0648\u0644\u0627 \u0639\u0627\u0631\u0641 \u0628\u0641\u0642\u062f\u0647</p>\n</li>\n<li>\n<p>\u0648\u0642\u062f \u0648\u0642\u0641\u062a \u0645\u0646 \u0643\u062a\u0628 \u0627\u0644\u0642\u0627\u0636\u064a \u0627\u064a\u062f\u0647 \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0645\u0627 \u0627\u062e\u062a\u0627\u0631\u0647 \u0641\u064a \u0627\u0645\u0631 \u0627\u0644\u0636\u064a\u0639\u0629 \u0648\u0627\u0644\u0628\u0644\u062f \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0648\u0642\u062a \u0639\u0644\u0649 \u062d\u0627\u0644 \u0642\u0628\u064a\u062d\u0629 \u0645\u0646 \u0627\u0644\u0641\u0633\u0627\u062f</p>\n</li>\n<li>\n<p>\u0648\u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628 \u0627\u0630 \u0642\u0644\u062a \u0627\u0646\u064a \u0644\u0645 \u0627\u0631\u0647 \u0639\u0644\u0649 \u0645\u062b\u0644\u0647\u0627 \u0645\u0646\u0630 \u0631\u062d\u0644\u062a\u0647 \u0643\u062a\u0628 \u0635\u0627\u062f\u0642\u0627 \u062f\u0627\u0631(\u061f) \u062c\u0648\u0627\u0628 . . \u0635\u0644\u062d(\u061f) \u0627\u0644\u0644\u0647 \u0628\u0628\u0642\u0627 \u0633\u064a\u062f\u0646\u0627 \u0627\u0644\u0627\u0645\u064a\u0631 \u0627\u0637\u0627\u0644 \u0627\u0644\u0644\u0647 \u0628\u0642\u0627\u0647</p>\n</li>\n<li>\n<p>\u0648\u062d\u0633\u0646 \u0646\u0638\u0631\u0647[&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ]\u0648\u0627\u0645\u0631&hellip;&hellip;&hellip;&hellip;&hellip;&hellip;&hellip;&hellip;&hellip;..\u0648\u0644\u0645\u0646 \u064a\u062d\u0643\u0645 \u0627\u0645\u0631 \u0627\u0644\u0636\u064a\u0639\u0629 \u0645\u0639\u0647 \u0628\u0628\u064a\u0639\u0647\u0627</p>\n</li>\n<li>\n<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]....\u0630\u0644\u0643 \u0648\u0628\u0639\u062f \u0645\u0627[[&nbsp; ]]\u0627\u0644\u0641\u0631\u062c \u0627\u0644\u0628\u0627\u062f\u0631\u0627\u0646\u064a \u0627\u064a\u062f\u0647 \u0627\u0644\u0644\u0647</p>\n</li>\n<li>\n<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]\u0627\u0644\u0643\u0641\u0627\u064a\u0629 \u0628\u0645\u0646\u0647 \u0648\u0643\u0631\u0645\u0647 \u0627\u0646 \u0631\u0627\u0649 \u0627\u0644 . . . \u0627\u062f\u0627\u0645 \u0627\u0644\u0644\u0647 \u0639\u0632\u0647</p>\n</li>\n<li>\n<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]\u062d\u0627\u062c\u0627\u062a\u0647 &hellip;[</p>\n</li></ol>\n",
          "format": "text/html"
        }
      ],
