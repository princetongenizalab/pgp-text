      "body": [
        {
          "type": "TextualBody",
          "label": "Verso",
          "value": "\n<ol><li>\u0631\u0633\u0645\u062a\u0647 \u0645\u0646 \u062e\u0637\u0627\u0628 \u0627\u0644\u0634\u064a\u062e \u0627\u0628\u064a \u0627\u0644\u0641\u0631\u062c \u0641\u0631\u0642\u0627\u0646 \u0628\u0646 \u0627\u0633\u062f \u0627\u0644\u0627\u0645\u0631 [&nbsp; &nbsp; &nbsp;]</li>\n<li>\u0644\u0627\u062c\u0644 \u0627\u0644\u0646\u0633\u062e \u0627\u0644\u0645\u0639\u0648\u0644 \u0641\u064a\u0647 \u0639\u0644\u0649 \u0627\u0649\u062a\u0645\u0627\u0645\u0647 \u0641\u0633\u0644\u0645 \u0627\u0644\u0649 \u062c\u0632\u0627\u064a\u0646 \u0645\u0646 \u0627\u0644\u0643\u0644\u0627\u0645 \u0641\u064a</li>\n<li>\u0627\u0644\u0639\u0631\u0648\u0648\u062b \u0628\u0631\u0633\u0645 \u062d\u0636\u0631\u062a\u0647 \u0648\u0630\u0643\u0631 \u0627\u0646\u0647 \u0642\u062f \u0643\u0627\u0646 \u0627\u0633\u062a\u0627\u0630\u0646\u0647 \u062f\u0641\u0639\u0629 \u0628\u0639\u062f \u0627\u062e\u0631\u0649 \u0641\u064a&nbsp;</li>\n<li>\u0628\u0627\u0628 \u0627\u0644\u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u0630\u064a \u0643\u0627\u0646 \u0627\u0644\u062a\u0645\u0633 \u0645\u0646\u0647 \u064a\u0638\u0647\u0631 \u0647\u0644 \u064a\u0648\u062b\u0631\u0647 \u0628\u062e\u0637 \u0639\u0628\u0631\u0627\u0646\u064a&nbsp;</li>\n<li>\u0627\u0645 \u0639\u0631\u0628\u064a \u0641\u0644\u0645 \u064a\u0631\u062f\u0647 \u062c\u0648\u0627\u0628 \u0628\u0645\u0627 \u064a\u0639\u062a\u0645\u062f\u0647 \u0641\u064a \u0630\u0644\u0643 \u0648\u0627\u0646\u0647 \u0645\u0646\u062a\u0638\u0631 \u0645\u0627 \u064a\u0631\u062f \u0628\u0647</li>\n<li>\u0627\u0644\u062c\u0648\u0627\u0628 \u0644\u064a\u0639\u0645\u0644 \u0646\u0633\u062e\u062a\u0647 \u0648\u0647\u0648 \u064a\u062e\u0635\u0647 \u0628\u0627\u062c\u0644 \u0627\u0644\u0633\u0644\u0645 \u0648\u0627\u0643\u0631\u0645\u0647 \u0648\u064a\u0635\u0641 \u0645\u0646</li>\n<li>\u0634\u0648\u0642\u0647 \u0648\u0632\u0627\u0649\u062f \u0648\u062d\u0634\u062a\u0647 \u0644\u062d\u0636\u0631\u062a\u0647 \u0645\u0627 \u0644\u0627 \u064a\u0633\u062a\u0648\u0639\u0628 \u0634\u0631\u062d\u0647 \u0643\u062a\u0627\u0628 \u0648\u0644\u0627 \u064a\u062d\u062a\u0648\u064a&nbsp;</li>\n<li>\u0639\u0644\u064a\u0647 \u062e\u0637\u0627\u0628&nbsp; &nbsp; &nbsp; &nbsp;\u0648\u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 [&nbsp; &nbsp; &nbsp; &nbsp;]...\u0628\u0628\u0642\u0627\u0649\u0647 \u0648\u0628\u0639\u0640. [&nbsp; &nbsp; &nbsp; &nbsp; ]</li></ol>\n",
